<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_generate_recurring_invoices" model="ir.cron">
        <field name="name">ERP الكهرباء: توليد الفواتير المتكررة للعقود</field>
        <field name="model_id" ref="utility_core.model_utility_contract_template"/>
        <field name="state">code</field>
        <field name="code">model.cron_generate_recurring_invoices()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
        <field name="utility_managed" eval="True"/>
        <field name="utility_code">contract_recurring_invoice_generator</field>
        <field name="utility_category">billing</field>
        <field name="utility_description">توليد الفواتير المتكررة للعقود والقوالب التعاقدية للمشتركين</field>
        <field name="prevent_overlap" eval="True"/>
        <field name="allow_manual_run" eval="True"/>
        <field name="batch_size">200</field>
    </record>

    <record id="ir_cron_update_overdue_orders" model="ir.cron">
        <field name="name">ERP الكهرباء: تحديث حالة الفواتير المتأخرة</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model.cron_update_overdue_orders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="utility_managed" eval="True"/>
        <field name="utility_code">overdue_bill_updater</field>
        <field name="utility_category">billing</field>
        <field name="utility_description">تحديث حالة فواتير الكهرباء المتأخرة عن موعد الاستحقاق إلى overdue</field>
        <field name="prevent_overlap" eval="True"/>
        <field name="allow_manual_run" eval="True"/>
        <field name="batch_size">1000</field>
    </record>

    <record id="ir_cron_batch_reading_invoicing" model="ir.cron">
        <field name="name">ERP الكهرباء: الفوترة الجماعية للقراءات المعتمدة</field>
        <field name="model_id" ref="utility_billing.model_utility_reading"/>
        <field name="state">code</field>
        <field name="code">model.cron_queue_approved_readings()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="utility_managed" eval="True"/>
        <field name="utility_code">approved_reading_queuer</field>
        <field name="utility_category">reading</field>
        <field name="utility_description">ترحيل القراءات المعتمدة إلى طابور الفوترة الجماعية</field>
        <field name="prevent_overlap" eval="True"/>
        <field name="allow_manual_run" eval="True"/>
        <field name="batch_size">1000</field>
    </record>

    <record id="ir_cron_send_due_bill_reminders" model="ir.cron">
        <field name="name">ERP الكهرباء: إرسال تذكير بالفواتير المستحقة</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_due_reminders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="utility_managed" eval="True"/>
        <field name="utility_code">due_bill_reminder_sender</field>
        <field name="utility_category">notification</field>
        <field name="utility_description">إرسال تنبيهات وتذكيرات السداد للمشتركين قبل حلول موعد الفصل</field>
        <field name="prevent_overlap" eval="True"/>
        <field name="allow_manual_run" eval="True"/>
        <field name="batch_size">500</field>
    </record>

    <record id="ir_cron_create_disconnection_orders" model="ir.cron">
        <field name="name">ERP الكهرباء: إنشاء أوامر الفصل للمتأخرات</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model.cron_create_disconnection_orders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="utility_managed" eval="True"/>
        <field name="utility_code">disconnection_order_creator</field>
        <field name="utility_category">operations</field>
        <field name="utility_description">إنشاء أوامر فصل الخدمة آلياً للفواتير المتأخرة التي تجاوزت فترة السماح</field>
        <field name="prevent_overlap" eval="True"/>
        <field name="allow_manual_run" eval="True"/>
        <field name="batch_size">200</field>
    </record>

    <record id="ir_cron_dispatch_sms_notifications" model="ir.cron">
        <field name="name">ERP الكهرباء: إرسال إشعارات SMS المعلقة</field>
        <field name="model_id" ref="utility_core.model_utility_notification_log"/>
        <field name="state">code</field>
        <field name="code">model.cron_dispatch_sms_notifications()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="utility_managed" eval="True"/>
        <field name="utility_code">sms_notification_dispatcher</field>
        <field name="utility_category">notification</field>
        <field name="utility_description">إرسال رسائل الـ SMS المجدولة في طابور الإشعارات</field>
        <field name="prevent_overlap" eval="True"/>
        <field name="allow_manual_run" eval="True"/>
        <field name="batch_size">200</field>
    </record>
</odoo>
