<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_generate_bills_daily" model="ir.cron">
            <field name="name">توليد الفواتير يومياً</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_bills_daily()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="utility_managed" eval="True"/>
            <field name="utility_code">daily_bill_generator</field>
            <field name="utility_category">billing</field>
            <field name="utility_description">توليد وإصدار فواتير الكهرباء الدورية يومياً بناء على القراءات المعتمدة ودورات الفوترة</field>
            <field name="prevent_overlap" eval="True"/>
            <field name="allow_manual_run" eval="True"/>
            <field name="batch_size">500</field>
        </record>

    </data>
</odoo>
