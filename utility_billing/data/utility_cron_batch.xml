<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============= Cron: Batch Generate Bills ============= -->
    <record id="ir_cron_generate_batch_bills" model="ir.cron">
        <field name="name">الكهرباء: توليد الفواتير بالدفعات</field>
        <field name="model_id" ref="model_utility_reading"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_bills()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="utility_managed" eval="True"/>
        <field name="utility_code">batch_reading_bill_generator</field>
        <field name="utility_category">billing</field>
        <field name="utility_description">توليد الفواتير للقراءات المجدولة في طابور الفوترة (queued readings) بنظام الدفعات الآمنة</field>
        <field name="prevent_overlap" eval="True"/>
        <field name="allow_manual_run" eval="True"/>
        <field name="batch_size">500</field>
    </record>

    <!-- ============= Cron: Process Uploaded Readings ============= -->
    <record id="ir_cron_process_staging_readings" model="ir.cron">
        <field name="name">الكهرباء: معالجة القراءات المرفوعة</field>
        <field name="model_id" ref="model_utility_reading_batch"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_readings()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="utility_managed" eval="True"/>
        <field name="utility_code">reading_staging_processor</field>
        <field name="utility_category">reading</field>
        <field name="utility_description">معالجة وتدقيق دفعات القراءات المرفوعة من الأجهزة الميدانية أو ملفات الإكسل</field>
        <field name="prevent_overlap" eval="True"/>
        <field name="allow_manual_run" eval="True"/>
        <field name="batch_size">5</field>
    </record>

    <!-- ============= Cron: Cleanup Old Batch Files ============= -->
    <record id="ir_cron_cleanup_batch_files" model="ir.cron">
        <field name="name">الكهرباء: تنظيف ملفات الدفعات القديمة</field>
        <field name="model_id" ref="model_utility_reading_batch"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_old_batches()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="utility_managed" eval="True"/>
        <field name="utility_code">batch_file_cleanup</field>
        <field name="utility_category">maintenance</field>
        <field name="utility_description">حذف ملفات ومرفقات دفعات القراءات المكتملة بعد انتهاء فترة الاحتفاظ المقررة</field>
        <field name="prevent_overlap" eval="True"/>
        <field name="allow_manual_run" eval="True"/>
        <field name="batch_size">100</field>
    </record>

    <!-- ============= Sequence: Reading Batch ============= -->
    <data noupdate="1">
        <record id="seq_utility_reading_batch" model="ir.sequence">
            <field name="name">تسلسل دفعات القراءات</field>
            <field name="code">utility.reading.batch</field>
            <field name="prefix">BATCH-</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>
