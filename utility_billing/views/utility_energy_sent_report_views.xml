<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_energy_sent_report_search" model="ir.ui.view">
        <field name="name">utility.energy.sent.report.search</field>
        <field name="model">utility.energy.sent.report</field>
        <field name="arch" type="xml">
            <search string="تقرير الطاقة المرسلة">
                <field name="date_range_id"/>
                <field name="region_id"/>
                <field name="area_id"/>
                <field name="substation_id"/>
                <field name="feeder_id"/>
                <filter name="positive_total_loss" string="فاقد إجمالي موجب" domain="[('total_loss', '&gt;', 0)]"/>
                <filter name="missing_feeder_reading" string="لا توجد قراءة خلية" domain="[('feeder_reading_id', '=', False)]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_period" string="الفترة" context="{'group_by': 'date_range_id'}"/>
                    <filter name="group_region" string="المنطقة" context="{'group_by': 'region_id'}"/>
                    <filter name="group_feeder" string="الخلية / الفيدر" context="{'group_by': 'feeder_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_utility_energy_sent_report_tree" model="ir.ui.view">
        <field name="name">utility.energy.sent.report.tree</field>
        <field name="model">utility.energy.sent.report</field>
        <field name="arch" type="xml">
            <tree string="تقرير الطاقة المرسلة" create="0" edit="0" delete="0">
                <field name="date_range_id"/>
                <field name="region_id" optional="show"/>
                <field name="area_id" optional="hide"/>
                <field name="substation_id" optional="hide"/>
                <field name="feeder_id"/>
                <field name="energy_sent" sum="إجمالي"/>
                <field name="energy_sold" sum="إجمالي"/>
                <field name="total_loss" sum="إجمالي"/>
                <field name="total_loss_percent"/>
            </tree>
        </field>
    </record>
    <record id="view_utility_energy_sent_report_pivot" model="ir.ui.view">
        <field name="name">utility.energy.sent.report.pivot</field>
        <field name="model">utility.energy.sent.report</field>
        <field name="arch" type="xml">
            <pivot string="تقرير الطاقة المرسلة">
                <field name="region_id" type="row"/>
                <field name="feeder_id" type="row"/>
                <field name="date_range_id" type="col"/>
                <field name="energy_sent" type="measure"/>
                <field name="energy_sold" type="measure"/>
                <field name="total_loss" type="measure"/>
                <field name="total_loss_percent" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_utility_energy_sent_report_graph" model="ir.ui.view">
        <field name="name">utility.energy.sent.report.graph</field>
        <field name="model">utility.energy.sent.report</field>
        <field name="arch" type="xml">
            <graph string="الطاقة والفاقد" type="bar">
                <field name="feeder_id"/>
                <field name="energy_sent" type="measure"/>
                <field name="energy_sold" type="measure"/>
                <field name="total_loss" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_utility_energy_sent_report" model="ir.actions.act_window">
        <field name="name">تقرير الطاقة المرسلة</field>
        <field name="res_model">utility.energy.sent.report</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="view_utility_energy_sent_report_search"/>
        <field name="context">{'search_default_group_period': 1}</field>
    </record>
    <menuitem id="menu_utility_energy_sent_report" name="تقرير الطاقة المرسلة"
        parent="menu_utility_billing_reports" action="action_utility_energy_sent_report"
        sequence="11"
        groups="base.group_system,utility_core.group_utility_admin,utility_core.group_utility_billing_manager,utility_core.group_utility_supervisor,utility_core.group_utility_revenue_manager,utility_core.group_utility_auditor"/>
</odoo>
