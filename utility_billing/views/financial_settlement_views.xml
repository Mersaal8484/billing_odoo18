<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE VIEW -->
    <record id="view_utility_financial_settlement_tree" model="ir.ui.view">
        <field name="name">utility.financial.settlement.tree</field>
        <field name="model">utility.financial.settlement</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'applied'"
                  decoration-info="state in ('submitted', 'approved')"
                  decoration-muted="state in ('draft', 'cancelled')"
                  default_order="date desc">
                <field name="name"/>
                <field name="account_id"/>
                <field name="settlement_type" widget="badge"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="date"/>
                <field name="submitted_by_id"/>
                <field name="approved_by_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'applied'"
                       decoration-info="state in ('submitted', 'approved')"
                       decoration-muted="state in ('draft', 'cancelled')"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_utility_financial_settlement_form" model="ir.ui.view">
        <field name="name">utility.financial.settlement.form</field>
        <field name="model">utility.financial.settlement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object"
                            string="تقديم للاعتماد" class="oe_highlight" invisible="(state != 'draft')"/>
                    <button name="action_approve" type="object"
                            string="اعتماد التسوية" class="oe_highlight" invisible="(state != 'submitted')"/>
                    <button name="action_apply_settlement" type="object"
                            string="تطبيق التسوية المالية" class="oe_highlight" invisible="(state != 'approved')"/>
                    <button name="action_cancel" type="object"
                            string="إلغاء" invisible="(state in ('applied', 'cancelled'))"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,applied"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object"
                                class="oe_stat_button" icon="fa-file-text-o" invisible="(move_id == False)">
                            <div class="o_form_label">القيد المحاسبي</div>
                            <div class="o_stat_info o_form_field">
                                <field name="move_id" class="o_stat_text"/>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="رقم التسوية المالية"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="معلومات الحساب">
                            <field name="account_id" options="{'no_create': True}" readonly="(state != 'draft')"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="region_id" readonly="1"/>
                            <field name="area_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="تفاصيل التسوية">
                            <field name="settlement_type" readonly="(state != 'draft')"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="(state != 'draft')"/>
                            <field name="date" readonly="(state != 'draft')"/>
                        </group>
                    </group>
                    <group string="السبب">
                        <field name="reason" placeholder="اذكر سبب التسوية المالية بالتفصيل..." readonly="(state != 'draft')"/>
                    </group>
                    <group string="سجل الإجراءات والتدقيق">
                        <group>
                            <field name="submitted_by_id"/>
                            <field name="submitted_date"/>
                            <field name="approved_by_id"/>
                            <field name="approved_date"/>
                        </group>
                        <group>
                            <field name="applied_by_id"/>
                            <field name="applied_date"/>
                            <field name="cancelled_by_id" invisible="(state != 'cancelled')"/>
                            <field name="cancelled_date" invisible="(state != 'cancelled')"/>
                            <field name="cancel_reason" invisible="(state != 'cancelled')"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_utility_financial_settlement_search" model="ir.ui.view">
        <field name="name">utility.financial.settlement.search</field>
        <field name="model">utility.financial.settlement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="settlement_type"/>
                <filter name="draft" string="مسودة" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="مُقدَّمة للاعتماد" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="معتمدة" domain="[('state','=','approved')]"/>
                <filter name="applied" string="تم التطبيق" domain="[('state','=','applied')]"/>
                <separator/>
                <group expand="0" string="تصنيف حسب">
                    <filter name="group_state" string="الحالة" context="{'group_by':'state'}"/>
                    <filter name="group_type" string="النوع" context="{'group_by':'settlement_type'}"/>
                    <filter name="group_date" string="التاريخ" context="{'group_by':'date'}"/>
                    <filter name="group_region" string="المنطقة" context="{'group_by':'region_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_utility_financial_settlement" model="ir.actions.act_window">
        <field name="name">التسويات المالية</field>
        <field name="res_model">utility.financial.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_utility_financial_settlement_search"/>
    </record>

    <menuitem id="menu_utility_financial_settlement" name="التسويات المالية"
              parent="utility_billing.menu_utility_accounting" sequence="40"
              action="action_utility_financial_settlement"/>
</odoo>
