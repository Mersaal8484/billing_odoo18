<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_bank_settlement_tree" model="ir.ui.view">
        <field name="name">utility.bank.settlement.tree</field>
        <field name="model">utility.bank.settlement</field>
        <field name="arch" type="xml">
            <list string="الإيداعات البنكية" default_order="deposit_date desc">
                <field name="name"/>
                <field name="deposit_date"/>
                <field name="bank_reference"/>
                <field name="bank_journal_id"/>
                <field name="deposited_amount" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'settled'"
                       decoration-warning="state == 'confirmed'"
                       decoration-muted="state in ('draft', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_utility_bank_settlement_form" model="ir.ui.view">
        <field name="name">utility.bank.settlement.form</field>
        <field name="model">utility.bank.settlement</field>
        <field name="arch" type="xml">
            <form string="إيداع وتسوية بنكية">
                <header>
                    <button name="action_confirm" type="object" string="تأكيد"
                            class="btn-primary" invisible="(state != 'draft')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,settled"/>
                </header>
                <sheet>
                    <group>
                        <group string="الإيداع">
                            <field name="name"/>
                            <field name="deposit_date"/>
                            <field name="bank_reference"/>
                            <field name="deposit_slip_number"/>
                            <field name="collector_id"/>
                            <field name="deposit_amount"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="الحساب البنكي">
                            <field name="bank_journal_id"/>
                            <field name="bank_account_id"/>
                            <field name="account_move_id"/>
                        </group>
                    </group>
                    <group string="المبالغ">
                        <field name="expected_amount" widget="monetary"/>
                        <field name="deposited_amount" widget="monetary"/>
                        <field name="difference_amount" widget="monetary"/>
                    </group>
                    <field name="line_ids" context="{'default_currency_id': currency_id}" readonly="(state != 'draft')">
                        <list editable="bottom">
                            <field name="collection_settlement_id"/>
                            <field name="allocated_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </list>
                    </field>
                    <field name="notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_utility_bank_settlement_search" model="ir.ui.view">
        <field name="name">utility.bank.settlement.search</field>
        <field name="model">utility.bank.settlement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="bank_reference"/>
                <field name="bank_journal_id"/>
                <field name="state"/>
                <filter name="settled" string="تمت التسوية"
                        domain="[('state', '=', 'settled')]"/>
            </search>
        </field>
    </record>

    <record id="action_utility_bank_settlement" model="ir.actions.act_window">
        <field name="name">الإيداعات البنكية</field>
        <field name="res_model">utility.bank.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_utility_bank_settlement_tree"/>
        <field name="search_view_id" ref="view_utility_bank_settlement_search"/>
    </record>
    <menuitem id="menu_utility_bank_settlements" name="الإيداعات البنكية"
              parent="menu_utility_accounting"
              action="action_utility_bank_settlement" sequence="38"/>
</odoo>
