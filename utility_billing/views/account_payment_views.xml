<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_utility" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.utility</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="utility_allocation_button_box">
                    <button name="action_view_utility_allocations" type="object"
                            class="oe_stat_button" icon="fa-money" invisible="(allocation_count == 0)">
                        <field name="allocation_count" string="التخصيصات" widget="statinfo"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//sheet/group" position="inside">
                <group string="تفاصيل الكهرباء" invisible="(utility_sale_order_id == False) and (utility_opening_move_id == False) and (service_charge_id == False)">
                    <field name="utility_sale_order_id" readonly="1" invisible="(utility_sale_order_id == False)"/>
                    <field name="utility_customer_id" readonly="1" invisible="(utility_customer_id == False)"/>
                    <field name="opening_customer_id" readonly="1" invisible="(utility_opening_move_id == False)"/>
                    <field name="utility_opening_move_id" readonly="1" invisible="(utility_opening_move_id == False)"/>
                    <field name="utility_invoice_id" invisible="(utility_sale_order_id == False) and (utility_opening_move_id == False)" readonly="(state != 'draft')"/>
                    <field name="service_charge_id" readonly="1" invisible="(service_charge_id == False)"/>
                    <field name="utility_payment_method" readonly="(state != 'draft')" invisible="(utility_sale_order_id == False) and (utility_opening_move_id == False)"/>
                    <field name="collector_id" invisible="((utility_sale_order_id == False) or (utility_payment_method != 'cash'))" readonly="(state != 'draft')"/>
                    <field name="electronic_doc_no" readonly="1" invisible="(utility_sale_order_id == False)"/>
                    <field name="is_invoice_verified" readonly="1" invisible="(utility_sale_order_id == False)"/>
                    <field name="date_range_id" readonly="1" invisible="(date_range_id == False)"/>
                    <field name="qr_code_url" readonly="1" invisible="(qr_code_url == False)"/>
                    <field name="allocation_count" readonly="1" invisible="(allocation_count == 0)"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
