<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== VIEW FOR IMAGES (WIZARD-LIKE) ===================== -->
    <record id="view_utility_reading_images" model="ir.ui.view">
        <field name="name">utility.reading.images.form</field>
        <field name="model">utility.reading</field>
        <field name="arch" type="xml">
            <form string="صور العداد">
                <field name="state" invisible="1"/>
                <field name="image_asset_id" invisible="1"/>
                <field name="meter_image_filename" invisible="1"/>
                <sheet>
                    <div class="o_utility_image_section p-4">
                        <div class="row g-4 align-items-stretch">
                            <div class="col-12 col-lg-8 o_utility_image_preview">
                                <div class="o_utility_image_container h-100 border-2 border rounded overflow-hidden bg-white text-center"
                                     style="min-height: 380px; border-color: #dee2e6 !important;">
                                    <field name="meter_image_url" widget="utility_media_image" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-4 o_utility_image_upload d-flex flex-column">
                                <div class="o_utility_upload_container h-100 border-2 border-dashed rounded p-4 d-flex align-items-center justify-content-center"
                                     style="border-color: #4f86c6 !important; background-color: #f0f5ff; min-height: 220px;">
                                    <field name="meter_image_upload" widget="binary"
                                           filename="meter_image_filename"
                                           class="o_utility_binary_upload" readonly="(state not in ('draft', 'under_review', 'error'))"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_save_image" string="حفظ" type="object" class="btn-primary"/>
                    <button string="إغلاق" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ===================== ACTION: Images ===================== -->
    <record id="action_open_meter_images" model="ir.actions.act_window">
        <field name="name">صورة العداد</field>
        <field name="res_model">utility.reading</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_utility_reading_images"/>
        <field name="target">new</field>
        <field name="context">{'form_view_initial_mode': 'edit', 'create': False, 'edit': True}</field>
    </record>

    <!-- ===================== LIST VIEW ===================== -->
    <record id="view_utility_reading_tree" model="ir.ui.view">
                <field name="name">utility.reading.tree</field>
                <field name="model">utility.reading</field>
                <field name="arch" type="xml">
            <list decoration-warning="state == 'under_review'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'error'">
                <field name="company_id" invisible="1"/>
                <field name="meter_image_url" widget="utility_media_image" class="oe_avatar" string="الصورة"/>
                <field name="reading_id" string="رقم القراءة"/>
                <field name="reading_purpose" widget="badge" string="غرض القراءة"/>
                <field name="customer_id" string="اسم المشترك"/>
                <field name="meter_id" string="العداد"/>
                <field name="reading_date" string="التاريخ"/>
                <field name="date_range_id" optional="show" string="الفترة"/>
                <field name="reading_value" string="القراءة الحالية"/>
                <field name="consumption" string="استهلاك العداد"/>
                <field name="carried_consumption" optional="show" string="استهلاك مرحل"/>
                <field name="billing_consumption" optional="show" string="استهلاك الفاتورة"/>
                <field name="consumption_alert" widget="badge" decoration-danger="consumption_alert in ('high','negative','zero')" decoration-success="consumption_alert == 'normal'" string="الاستهلاك"/>
                <field name="reading_type" string="نوع القراءة"/>
                <field name="image_state" optional="show" string="حالة الصورة"/>
                <field name="state" widget="badge" decoration-warning="state == 'under_review'" decoration-success="state == 'approved'" decoration-primary="state == 'billed'" string="الحالة"/>
                <field name="create_uid" string="القارئ (الاسم)"/>
                <field name="reviewer_id" optional="show" string="المراجع"/>
            </list>
        </field>
    </record>

    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_utility_reading_form" model="ir.ui.view">
        <field name="name">utility.reading.form</field>
        <field name="model">utility.reading</field>
        <field name="arch" type="xml">
            <form>
                <field name="available_meter_ids" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="image_asset_id" invisible="1"/>
                <field name="meter_image_filename" invisible="1"/>
                <header>
                    <!-- أزرار حسب الحالة -->
                    <button name="action_submit_review" type="object"
                            string="إرسال للمراجعة" class="oe_highlight"
                            groups="utility_core.group_utility_meter_reader,utility_core.group_utility_technician,utility_core.group_utility_supervisor,utility_core.group_utility_billing_manager,utility_core.group_utility_admin" invisible="(state != 'draft')"/>
                    <button name="action_mark_image_clear" type="object"
                            string="الصورة واضحة" class="btn-outline-success"
                            icon="fa-check"
                            groups="utility_core.group_utility_supervisor,utility_core.group_utility_billing_manager,utility_core.group_utility_revenue_manager,utility_core.group_utility_admin,utility_core.group_utility_auditor" invisible="((image_state == 'clear') or (state not in ('draft', 'under_review')))"/>
                    <button name="action_mark_image_not_clear" type="object"
                            string="الصورة غير واضحة" class="btn-outline-warning"
                            icon="fa-times"
                            groups="utility_core.group_utility_supervisor,utility_core.group_utility_billing_manager,utility_core.group_utility_revenue_manager,utility_core.group_utility_admin,utility_core.group_utility_auditor" invisible="((image_state == 'not_clear') or (state not in ('draft', 'under_review')))"/>
                    <button name="action_mark_image_not_same" type="object"
                            string="عداد غير مطابق" class="btn-outline-danger"
                            icon="fa-exclamation-triangle"
                            groups="utility_core.group_utility_supervisor,utility_core.group_utility_billing_manager,utility_core.group_utility_revenue_manager,utility_core.group_utility_admin,utility_core.group_utility_auditor" invisible="((image_state == 'not_same') or (state not in ('draft', 'under_review')))"/>
                    <button name="action_mark_image_loss_read" type="object"
                            string="فاقد قراءة" class="btn-outline-secondary"
                            icon="fa-eye-slash"
                            groups="utility_core.group_utility_supervisor,utility_core.group_utility_billing_manager,utility_core.group_utility_revenue_manager,utility_core.group_utility_admin,utility_core.group_utility_auditor" invisible="((image_state == 'loss_read') or (state not in ('draft', 'under_review')))"/>
                    <button name="action_approve" type="object"
                            string="اعتماد القراءة" class="oe_highlight"
                            groups="utility_core.group_utility_supervisor,utility_core.group_utility_billing_manager,utility_core.group_utility_revenue_manager,utility_core.group_utility_admin" invisible="(state != 'under_review')"/>
                    <button name="action_reject" type="object"
                            string="رفض" class="btn-danger"
                            groups="utility_core.group_utility_supervisor,utility_core.group_utility_billing_manager,utility_core.group_utility_revenue_manager,utility_core.group_utility_admin" invisible="(state not in ('under_review', 'approved'))"/>
                    <button name="action_generate_bill" type="object"
                            string="إنشاء فاتورة" class="oe_highlight"
                            groups="utility_core.group_utility_supervisor,utility_core.group_utility_billing_manager,utility_core.group_utility_revenue_manager,utility_core.group_utility_admin" invisible="((state not in ('approved', 'queued')) or (reading_purpose != 'periodic'))"/>
                    <button name="action_requeue" type="object"
                            string="إعادة للطابور" class="oe_highlight"
                            groups="utility_core.group_utility_billing_manager,utility_core.group_utility_admin" invisible="(state != 'error')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,under_review,approved,queued,billed,error"
                           options="{'clickable': False}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- صور العداد -->
                        <button name="action_open_meter_images" type="object"
                                class="oe_stat_button" icon="fa-camera"
                                help="صورة العداد">
                            <div class="o_stat_info">
                                <field name="image_state" widget="badge"/>
                            </div>
                        </button>
                        <!-- سجل القراءات -->
                        <button name="action_view_reading_history" type="object"
                                class="oe_stat_button" icon="fa-history"
                                help="سجل قراءات هذا العداد">
                            <div class="o_stat_info">
                                <field name="reading_history_count" widget="statinfo"/>
                                <span class="o_stat_text">سجل القراءات</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="معلومات القراءة">
                            <field name="reading_category" readonly="(state != 'draft')"/>
                            <field name="reading_id" readonly="1"/>
                            <field name="reading_purpose" readonly="(state != 'draft')"/>
                            <field name="reading_event" readonly="(state != 'draft')"/>
                            <field name="meter_serial_scan" widget="barcode_camera" invisible="(state != 'draft')"/>
                            <field name="meter_id" domain="[('id', 'in', available_meter_ids)]" options="{'no_create': True}" readonly="(state != 'draft')"/>
                            <field name="account_id" options="{'no_create': True}" readonly="(state != 'draft')"/>
                            <field name="reading_history_count" string="سجل القراءات" widget="statinfo"/>
                            <field name="transformer_id" invisible="(reading_category != 'transformer')"/>
                            <field name="is_private_transformer" invisible="1"/>
                            <field name="feeder_id" invisible="(reading_category != 'feeder')"/>
                            <field name="customer_id" invisible="((reading_category not in ('customer', 'transformer')) or ((reading_category == 'transformer') and (is_private_transformer == False)))"/>
                            <field name="reading_date" readonly="(state not in ('draft', 'error'))"/>
                            <field name="date_range_id" options="{'no_create': True}" readonly="(state not in ('draft', 'error'))" invisible="(reading_purpose != 'periodic')" required="(reading_purpose == 'periodic')"/>
                            <field name="replacement_id" readonly="1" invisible="(replacement_id == False)"/>
                            <field name="reading_type" readonly="(state != 'draft')"/>
                        </group>
                        <group string="قراءات العداد">
                            <field name="previous_reading" readonly="1"/>
                            <field name="previous_reading_date" readonly="1"/>
                            <field name="reading_value" readonly="(state not in ('draft', 'error'))"/>
                            <field name="is_rollover" readonly="(state not in ('draft', 'under_review', 'error'))"/>
                            <field name="max_reading_value" invisible="(is_rollover == False)" readonly="(state not in ('draft', 'under_review', 'error'))"/>
                            <field name="raw_consumption" readonly="1"/>
                            <field name="meter_multiplier" readonly="1"/>
                            <field name="consumption" class="text-success" readonly="1"/>
                            <field name="carried_consumption" readonly="1" invisible="(reading_purpose != 'periodic')"/>
                            <field name="billing_consumption" class="text-success" readonly="1" invisible="(reading_purpose != 'periodic')"/>
                            <!-- تحليل الاستهلاك -->
                            <field name="consumption_difference" invisible="(consumption_alert == 'normal')"/>
                            <field name="consumption_diff_percentage" invisible="(consumption_alert == 'normal')"/>
                            <field name="consumption_alert" widget="badge" readonly="1"/>
                        </group>
                    </group>
                    <div class="o_form_label mb-2 fw-bold">صور العداد</div>
                    <div class="o_utility_image_section border rounded p-4 mb-3">
                        <div class="row g-4 align-items-stretch">
                            <div class="col-12 col-lg-8 o_utility_image_preview">
                                <div class="o_utility_image_container h-100 border-2 border rounded overflow-hidden bg-white text-center"
                                     style="min-height: 320px; border-color: #dee2e6 !important;">
                                    <field name="meter_image_url" widget="utility_media_image" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-4 o_utility_image_upload d-flex flex-column">
                                <div class="o_utility_upload_container h-100 border-2 border-dashed rounded p-4 d-flex align-items-center justify-content-center"
                                     style="border-color: #4f86c6 !important; background-color: #f0f5ff; min-height: 180px;">
                                    <field name="meter_image_upload" widget="binary"
                                           filename="meter_image_filename"
                                           class="o_utility_binary_upload" readonly="(state not in ('draft', 'under_review', 'error'))"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <group string="المراجعة" groups="utility_core.group_utility_supervisor">
                        <field name="image_state" readonly="(state not in ('draft', 'under_review', 'error'))"/>
                        <field name="reviewer_id" readonly="1"/>
                        <field name="review_date" readonly="1"/>
                        <field name="review_notes" readonly="(state != 'under_review')"/>
                        <field name="rejection_reason" readonly="(state in ('queued', 'billed'))" invisible="(rejection_reason == False)"/>
                        <field name="rejected_by" readonly="1" invisible="(rejected_by == False)"/>
                        <field name="rejected_at" readonly="1" invisible="(rejected_at == False)"/>
                    </group>
                    <field name="remarks" nolabel="1" placeholder="ملاحظات إضافية..." readonly="(state not in ('draft', 'error'))"/>
                    <group string="خطأ الفوترة" invisible="(billing_error == False)">
                        <field name="billing_error" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ===================== KANBAN VIEW ===================== -->
    <record id="view_utility_reading_kanban" model="ir.ui.view">
        <field name="name">utility.reading.kanban</field>
        <field name="model">utility.reading</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="reading_id"/>
                <field name="customer_id"/>
                <field name="meter_id"/>
                <field name="reading_value"/>
                <field name="state"/>
                <field name="meter_image_url"/>
                <field name="create_uid"/>
                <field name="id"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{record.meter_image_url.raw_value || ''}')">
                                <img class="o_kanban_image_inner_pic" t-if="record.meter_image_url.raw_value" t-att-alt="record.reading_id.value" t-att-src="record.meter_image_url.raw_value"/>
                            </div>
                            <div class="o_kanban_image d-md-none" t-attf-style="background-image:url('#{record.meter_image_url.raw_value || ''}')">
                                <img class="o_kanban_image_inner_pic" t-if="record.meter_image_url.raw_value" t-att-alt="record.reading_id.value" t-att-src="record.meter_image_url.raw_value"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="reading_id"/></strong>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a role="menuitem" type="edit" class="dropdown-item">تعديل</a>
                                            <a role="menuitem" type="delete" class="dropdown-item">حذف</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><field name="customer_id"/></div>
                                    <div>العداد: <field name="meter_id"/></div>
                                    <div>القراءة: <field name="reading_value"/></div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        القارئ: <field name="create_uid"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'under_review': 'warning', 'approved': 'success', 'billed': 'primary'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===================== SEARCH VIEW ===================== -->

    <record id="view_utility_reading_search" model="ir.ui.view">
        <field name="name">utility.reading.search</field>
        <field name="model">utility.reading</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id" invisible="1"/>
                <field name="meter_id"/>
                <field name="account_id"/>
                <field name="reading_date"/>
                <!-- فلاتر سريعة -->
                <filter name="draft" string="مسودة" domain="[('state','=','draft')]"/>
                <filter name="under_review" string="قيد المراجعة" domain="[('state','=','under_review')]"
                        help="القراءات التي تنتظر المراجعة والاعتماد"/>
                <filter name="approved" string="معتمدة" domain="[('state','=','approved')]"/>
                <filter name="queued" string="في طابور الفوترة" domain="[('state','=','queued')]"/>
                <filter name="billed" string="مفوترة" domain="[('state','=','billed')]"/>
                <filter name="error" string="خطأ" domain="[('state','=','error')]"/>
                <filter name="awaiting_bill" string="تنتظر الفوترة" domain="[('state','=','approved')]"/>
                <filter name="estimated" string="تقديرية" domain="[('is_estimated','=',True)]"/>
                <separator/>
                <filter name="purpose_opening" string="افتتاحية" domain="[('reading_purpose','=','opening')]"/>
                <filter name="purpose_periodic" string="دورية" domain="[('reading_purpose','=','periodic')]"/>
                <filter name="purpose_closing" string="ختامية استبدال" domain="[('reading_purpose','=','replacement_closing')]"/>
                <filter name="pending_closing" string="ختاميات تنتظر الفوترة" domain="[('reading_purpose','=','replacement_closing'),('billing_anchor_id','=',False),('state','=','approved')]"/>
                <!-- مجموعات -->
                <group expand="0" string="حالة الصورة">
                    <filter name="img_clear" string="واضحة" domain="[('image_state','=','clear')]"/>
                    <filter name="img_not_clear" string="غير واضحة" domain="[('image_state','=','not_clear')]"/>
                    <filter name="img_no_image" string="بدون صورة" domain="[('image_state','=','none')]"/>
                </group>
                <separator/>
                <group expand="0" string="تجميع حسب">
                    <filter string="غرض القراءة" name="group_by_reading_purpose" domain="[]" context="{'group_by': 'reading_purpose'}"/>
                    <filter string="الحالة" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="نوع القراءة" name="group_by_reading_type" domain="[]" context="{'group_by': 'reading_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== ACTIONS ===================== -->
    <record id="action_utility_reading" model="ir.actions.act_window">
        <field name="name">قراءات العدادات</field>
        <field name="res_model">utility.reading</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_utility_reading_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                سجل قراءات العدادات. يتم رفع صورة مع كل قراءة، ثم تمر بالمراجعة والاعتماد قبل إنشاء الفاتورة.
            </p>
        </field>
    </record>

    <record id="action_utility_reading_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_utility_reading_tree"/>
        <field name="act_window_id" ref="action_utility_reading"/>
    </record>

    <record id="action_utility_reading_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_utility_reading_form"/>
        <field name="act_window_id" ref="action_utility_reading"/>
    </record>

    <record id="action_utility_readings_pending_review" model="ir.actions.act_window">
        <field name="name">قراءات تنتظر المراجعة</field>
        <field name="res_model">utility.reading</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', '=', 'under_review')]</field>
        <field name="context">{'default_state': 'under_review'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                القراءات التي تم تسجيلها وتنتظر المراجعة والاعتماد.
            </p>
        </field>
    </record>

    <!-- ======================= MENU ITEM ======================= -->
    <menuitem id="menu_utility_meter_readings" name="قراءات العدادات"
              parent="menu_utility_readings" sequence="10"
              action="action_utility_reading"/>

    <menuitem id="menu_utility_readings_pending_review"
              name="قراءات تنتظر المراجعة"
              parent="menu_utility_readings"
              action="action_utility_readings_pending_review"
              sequence="15"
              groups="utility_core.group_utility_supervisor"/>
</odoo>
