<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_deposit_tree" model="ir.ui.view">
        <field name="name">utility.deposit.tree</field>
        <field name="model">utility.deposit</field>
        <field name="arch" type="xml">
            <list decoration-info="status=='draft'" decoration-success="status=='released'" decoration-warning="status=='held'" decoration-danger="status=='forfeited'">
                <field name="deposit_number"/>
                <field name="customer_id"/>
                <field name="deposit_date"/>
                <field name="amount" sum="الإجمالي"/>
                <field name="deposit_type"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_utility_deposit_form" model="ir.ui.view">
        <field name="name">utility.deposit.form</field>
        <field name="model">utility.deposit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_receive_deposit" type="object" string="استلام الوديعة" class="oe_highlight" invisible="(status != 'draft')"/>
                    <button name="action_release_deposit" type="object" string="استرداد الوديعة" invisible="(status != 'held')"/>
                    <button name="action_forfeit_deposit" type="object" string="مصادرة الوديعة" invisible="(status != 'held')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,held,released,forfeited"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="deposit_number" string="رقم الوديعة/التأمين"/>
                        <h1><field name="deposit_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="بيانات المشترك">
                            <field name="customer_id"/>
                            <field name="account_id"/>
                            <field name="meter_id"/>
                        </group>
                        <group string="التفاصيل المالية">
                            <field name="amount" widget="monetary" decoration-bf="1"/>
                            <field name="deposit_date"/>
                            <field name="deposit_type"/>
                        </group>
                    </group>
                    <group string="القيود المحاسبية">
                        <group>
                            <field name="receipt_move_id" invisible="(receipt_move_id == False)"/>
                            <field name="release_move_id" invisible="(release_move_id == False)"/>
                            <field name="forfeit_move_id" invisible="(forfeit_move_id == False)"/>
                            <field name="release_date" invisible="(status != 'released')"/>
                            <field name="payment_id" invisible="(payment_id == False)"/>
                            <field name="move_id" invisible="(move_id == False)"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="ملاحظات">
                            <field name="notes" placeholder="ملاحظات إضافية..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
