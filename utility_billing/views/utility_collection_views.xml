<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_collection_tree" model="ir.ui.view">
        <field name="name">utility.collection.tree</field>
        <field name="model">utility.collection</field>
        <field name="arch" type="xml">
            <list string="تحصيلات الكهرباء" default_order="collection_date desc">
                <field name="name"/>
                <field name="collection_date"/>
                <field name="utility_customer_id"/>
                <field name="collector_id"/>
                <field name="amount" widget="monetary"/>
                <field name="settled_amount" widget="monetary"/>
                <field name="remaining_amount" widget="monetary"/>
                <field name="collection_method"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'settled'"
                       decoration-warning="state in ('posted', 'included_in_settlement')"
                       decoration-muted="state in ('draft', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_utility_collection_form" model="ir.ui.view">
        <field name="name">utility.collection.form</field>
        <field name="model">utility.collection</field>
        <field name="arch" type="xml">
            <form string="تحصيل كهرباء">
                <header>
                    <button name="action_confirm" type="object" string="تأكيد"
                            class="btn-primary" invisible="(state != 'draft')"/>
                    <button name="action_cancel" type="object" string="إلغاء" invisible="(state not in ('draft', 'confirmed'))"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,posted,included_in_settlement,settled"/>
                </header>
                <sheet>
                    <group>
                        <group string="التحصيل">
                            <field name="name"/>
                            <field name="collection_date"/>
                            <field name="collection_method"/>
                            <field name="collector_id" required="(collection_method in ('field_collector', 'external_collection'))"/>
                        </group>
                        <group string="الفاتورة والدفعة">
                            <field name="payment_id"/>
                            <field name="allocation_id"/>
                            <field name="utility_customer_id"/>
                            <field name="invoice_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group string="المبالغ">
                        <group>
                            <field name="currency_id"/>
                            <field name="amount" widget="monetary"/>
                        </group>
                        <group>
                            <field name="settled_amount" widget="monetary"/>
                            <field name="remaining_amount" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="تسوية المحصل">
                            <field name="settlement_line_ids" readonly="1">
                                <list>
                                    <field name="settlement_id"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="actual_settled_amount" widget="monetary"/>
                                </list>
                            </field>
                        </page>
                        <page string="المحاسبة">
                            <field name="account_move_id"/>
                            <field name="journal_id"/>
                        </page>
                        <page string="ملاحظات">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_utility_collection_search" model="ir.ui.view">
        <field name="name">utility.collection.search</field>
        <field name="model">utility.collection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="utility_customer_id"/>
                <field name="collector_id"/>
                <field name="payment_id"/>
                <field name="state"/>
                <filter name="unsettled" string="غير مسدد"
                        domain="[('remaining_amount', '&gt;', 0), ('state', 'in', ('posted', 'included_in_settlement'))]"/>
                <filter name="field_collections" string="تحصيل ميداني"
                        domain="[('collection_method', '=', 'field_collector')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="collector" string="المحصل" context="{'group_by': 'collector_id'}"/>
                    <filter name="state_group" string="الحالة" context="{'group_by': 'state'}"/>
                    <filter name="method_group" string="طريقة التحصيل" context="{'group_by': 'collection_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_utility_collection_settlement_tree" model="ir.ui.view">
        <field name="name">utility.collection.settlement.tree</field>
        <field name="model">utility.collection.settlement</field>
        <field name="arch" type="xml">
            <list string="تسويات المحصلين" default_order="settlement_date desc">
                <field name="name"/>
                <field name="settlement_date"/>
                <field name="collector_id"/>
                <field name="expected_amount" widget="monetary"/>
                <field name="declared_amount" widget="monetary"/>
                <field name="shortage_amount" widget="monetary"/>
                <field name="surplus_amount" widget="monetary"/>
                <field name="remaining_to_deposit" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'reconciled'"
                       decoration-warning="state in ('posted', 'deposited')"
                       decoration-muted="state in ('draft', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_utility_collection_settlement_form" model="ir.ui.view">
        <field name="name">utility.collection.settlement.form</field>
        <field name="model">utility.collection.settlement</field>
        <field name="arch" type="xml">
            <form string="تسوية عهدة محصل">
                <header>
                    <button name="action_confirm" type="object" string="تأكيد"
                            class="btn-primary" invisible="(state != 'draft')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,posted,deposited,reconciled"/>
                </header>
                <sheet>
                    <group>
                        <group string="بيانات التسوية">
                            <field name="name"/>
                            <field name="settlement_date"/>
                            <field name="collector_id"/>
                            <field name="settlement_method"/>
                            <field name="allocation_policy"/>
                            <field name="created_automatically"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="المبالغ">
                            <field name="expected_amount" widget="monetary"/>
                            <field name="declared_amount" widget="monetary"/>
                            <field name="actual_settled_amount" widget="monetary"/>
                            <field name="shortage_amount" widget="monetary"/>
                            <field name="surplus_amount" widget="monetary"/>
                            <field name="remaining_to_deposit" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="التحصيلات">
                            <field name="line_ids" context="{'default_currency_id': currency_id}" readonly="(state != 'draft')">
                                <list editable="bottom">
                                    <field name="collection_id"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="actual_settled_amount" widget="monetary" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="المحاسبة">
                            <field name="account_move_id"/>
                        </page>
                        <page string="ملاحظات">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_utility_collection_settlement_search" model="ir.ui.view">
        <field name="name">utility.collection.settlement.search</field>
        <field name="model">utility.collection.settlement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="collector_id"/>
                <field name="state"/>
                <filter name="shortage" string="عجز" domain="[('shortage_amount', '&gt;', 0)]"/>
                <filter name="pending_deposit" string="بانتظار الإيداع" domain="[('remaining_to_deposit', '&gt;', 0)]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="collector_group" string="المحصل" context="{'group_by': 'collector_id'}"/>
                    <filter name="state_group" string="الحالة" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_utility_collection" model="ir.actions.act_window">
        <field name="name">تحصيلات الكهرباء</field>
        <field name="res_model">utility.collection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_utility_collection_search"/>
    </record>
    <record id="action_utility_collection_settlement" model="ir.actions.act_window">
        <field name="name">تسويات المحصلين</field>
        <field name="res_model">utility.collection.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_utility_collection_settlement_tree"/>
        <field name="search_view_id" ref="view_utility_collection_settlement_search"/>
    </record>
    <menuitem id="menu_utility_collections" name="التحصيلات"
              parent="menu_utility_accounting" action="action_utility_collection"
              sequence="36"/>
    <menuitem id="menu_utility_collection_settlements" name="تسويات المحصلين"
              parent="menu_utility_accounting"
              action="action_utility_collection_settlement" sequence="37"/>
</odoo>
