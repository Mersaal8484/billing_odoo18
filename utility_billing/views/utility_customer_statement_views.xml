<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Wizard Form View -->
    <record id="view_utility_customer_statement_wizard_form" model="ir.ui.view">
        <field name="name">utility.customer.statement.wizard.form</field>
        <field name="model">utility.customer.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="كشف حساب المشترك">
                <sheet>
                    <div class="row">
                        <div class="col-12 col-lg-6 mb-3">
                            <div class="card o_settings_card h-100">
                                <div class="card-header bg-light">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-user fa-2x text-primary me-3" title="المشترك"/>
                                        <div>
                                            <h4 class="mb-0">بيانات المشترك</h4>
                                            <small class="text-muted">اختر الحساب وتحديد الخيارات</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label for="customer_id" class="o_light_label"/>
                                        <field name="customer_id" options="{'no_create': True}"/>
                                    </div>
                                    <div class="form-check mt-3">
                                        <field name="include_draft" class="form-check-input" id="include_draft"/>
                                        <label for="include_draft" class="form-check-label ms-2">تضمين الفواتير والسدادات المسودة</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 mb-3">
                            <div class="card o_settings_card h-100">
                                <div class="card-header bg-light">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-calendar fa-2x text-info me-3" title="الفترة"/>
                                        <div>
                                            <h4 class="mb-0">فترة الكشف</h4>
                                            <small class="text-muted">تحديد نطاق التواريخ</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label for="date_from" class="o_light_label"/>
                                        <field name="date_from"/>
                                    </div>
                                    <div class="mb-3">
                                        <label for="date_to" class="o_light_label"/>
                                        <field name="date_to"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_print_statement" type="object" string="طباعة كشف الحساب (PDF)" class="btn-primary" icon="fa-print"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 2. Wizard Action -->
    <record id="action_utility_customer_statement_wizard" model="ir.actions.act_window">
        <field name="name">كشف حساب المشترك</field>
        <field name="res_model">utility.customer.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_utility_customer_statement_wizard_form"/>
        <field name="target">new</field>
    </record>

    <!-- 3. Smart Button on Customer Form -->
    <record id="view_utility_customer_form_statement_button" model="ir.ui.view">
        <field name="name">utility.customer.form.statement.button</field>
        <field name="model">utility.customer</field>
        <field name="inherit_id" ref="utility_core.view_utility_customer_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_utility_customer_statement_wizard)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        context="{'default_customer_id': id}">
                    <div class="o_stat_info">
                        <span class="o_stat_text">كشف الحساب</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- 4. Report Action -->
    <record id="action_report_customer_statement" model="ir.actions.report">
        <field name="name">كشف حساب المشترك</field>
        <field name="model">utility.customer.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">utility_billing.report_customer_statement</field>
        <field name="report_file">utility_billing.report_customer_statement</field>
        <field name="print_report_name">'كشف_حساب_%s' % (object.customer_id.customer_number or 'مشترك')</field>
        <field name="binding_model_id" ref="model_utility_customer_statement_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 4b. Server Action on res.partner — يظهر في قائمة الإجراءات لصفحة المشترك -->
    <record id="action_partner_customer_statement_server" model="ir.actions.server">
        <field name="name">كشف حساب المشترك</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
partner = records[0] if records else None
customer = env['utility.customer'].search([('partner_id', '=', partner.id)], limit=1) if partner else None
if customer:
    wizard = env['utility.customer.statement.wizard'].create({
        'customer_id': customer.id,
        'date_to': fields.Date.context_today(env['utility.customer.statement.wizard']),
    })
    action = {
        'type': 'ir.actions.act_window',
        'name': 'كشف حساب المشترك',
        'res_model': 'utility.customer.statement.wizard',
        'view_mode': 'form',
        'res_id': wizard.id,
        'target': 'new',
    }
        </field>
    </record>

    <!-- 4c. Smart button on res.partner form (عملاء المشتركين) -->
    <record id="view_res_partner_statement_button" model="ir.ui.view">
        <field name="name">res.partner.statement.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_statement_wizard"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not has_utility_customer">
                    <div class="o_stat_info">
                        <span class="o_stat_text">كشف الحساب</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- 5. QWeb Report Template — مطابق للنموذج المرجعي بدقة عالية -->
    <template id="report_customer_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="statement" t-value="doc._prepare_report_values()"/>
                <t t-set="totals"   t-value="statement['totals']"/>
                <t t-set="lines"    t-value="statement['lines']"/>
                <t t-set="customer" t-value="statement['customer']"/>
                <t t-set="partner"  t-value="statement['partner']"/>

                <div class="article" style="width:100%; margin:0; padding:0; page-break-after:always;">
                    <div dir="rtl" style="
                        box-sizing:border-box;
                        width:100%;
                        padding:8mm 8mm 4mm;
                        background:#fff;
                        color:#111;
                        font-family:Tahoma, Arial, sans-serif;
                        font-size:9pt;
                        line-height:1.5;
                    ">

                        <!-- ======================================================== -->
                        <!-- رأس الصفحة: الجهة الحكومية + الشعار                       -->
                        <!-- ======================================================== -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:3mm;">
                            <tr>
                                <!-- اليسار: اسم الجمهورية/الوزارة -->
                                <td style="width:40%; vertical-align:top; text-align:right; padding:0;">
                                    <div style="font-size:8.5pt; color:#111;">الجمهورية اليمنية وزارة الكهرباء والطاقة</div>
                                </td>
                                <!-- الوسط: فراغ -->
                                <td style="width:20%;"></td>
                                <!-- اليمين: شعار الشركة -->
                                <td style="width:40%; vertical-align:top; text-align:left; padding:0;">
                                    <t t-if="res_company.logo">
                                        <img t-att-src="image_data_uri(res_company.logo)"
                                             style="display:block; margin-right:auto; max-height:16mm; max-width:30mm;" alt="Logo"/>
                                    </t>
                                    <div style="font-size:8pt; color:#075aa5; font-weight:bold; text-align:left;" t-esc="res_company.name"/>
                                </td>
                            </tr>
                        </table>

                        <!-- خط فاصل -->
                        <div style="border-top:1pt solid #333; margin-bottom:6mm;"></div>

                        <!-- ======================================================== -->
                        <!-- بيانات المشترك — يمين الصفحة                              -->
                        <!-- ======================================================== -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:4mm;">
                            <tr>
                                <td style="width:60%; vertical-align:top;"></td>
                                <td style="width:40%; vertical-align:top; text-align:right;">
                                    <div style="font-size:9.5pt; margin-bottom:1mm;">
                                        <span t-esc="partner.name or '--'"/>
                                        <t t-if="customer.customer_number">
                                            - <span t-esc="customer.customer_number"/>
                                        </t>
                                    </div>
                                    <div style="font-size:9pt; margin-bottom:0.5mm;">
                                        م.الراهد <span t-esc="customer.route_id.name or '--'"/>
                                    </div>
                                    <div style="font-size:9pt;">
                                        عداد على <span t-esc="customer.meter_id.meter_number or '--'"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ======================================================== -->
                        <!-- عنوان الكشف                                               -->
                        <!-- ======================================================== -->
                        <div style="text-align:center; margin-bottom:4mm;">
                            <span style="color:#0056b3; font-weight:bold; font-size:13pt; border-bottom:1.5pt solid #0056b3; padding-bottom:1mm;">
                                كشف حساب
                            </span>
                        </div>

                        <!-- ======================================================== -->
                        <!-- التاريخ والمنطقة                                          -->
                        <!-- ======================================================== -->
                        <div style="margin-bottom:1mm; font-size:9pt;">
                            <strong>التاريخ: </strong>
                            <span t-esc="doc.date_to"/>
                        </div>
                        <div style="margin-bottom:3mm; font-size:9pt;">
                            <strong>المنطقة: </strong>
                            <span t-esc="customer.area_id.name or customer.region_id.name or '--'"/>
                        </div>

                        <!-- ======================================================== -->
                        <!-- نص معلومات الفترة                                         -->
                        <!-- ======================================================== -->
                        <div style="margin-bottom:2mm; font-size:9pt;">
                            <t t-if="doc.date_from">
                                <span t-esc="doc.date_from"/>
                                <span> and </span>
                                <span t-esc="doc.date_to"/>
                                <span> كشف الحساب بين تاريخين </span>
                                in <span t-esc="doc.customer_id.partner_id.property_account_receivable_id.currency_id.name or res_company.currency_id.name"/>:
                            </t>
                            <t t-else="">
                                <span>كشف الحساب حتى تاريخ </span>
                                <span t-esc="doc.date_to"/>
                                in <span t-esc="res_company.currency_id.name"/>:
                            </t>
                        </div>

                        <!-- ======================================================== -->
                        <!-- الجدول الرئيسي                                            -->
                        <!-- ======================================================== -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:5mm; font-size:8.5pt;" border="1">
                            <thead>
                                <tr style="background:#eee; text-align:center; font-weight:bold;">
                                    <th style="border:0.5pt solid #888; padding:1.5mm 1mm; width:14%;">رقم المرجع/السند</th>
                                    <th style="border:0.5pt solid #888; padding:1.5mm 1mm; width:10%;">التاريخ</th>
                                    <th style="border:0.5pt solid #888; padding:1.5mm 1mm;">البيان</th>
                                    <th style="border:0.5pt solid #888; padding:1.5mm 1mm; width:10%;">القراءة السابقة</th>
                                    <th style="border:0.5pt solid #888; padding:1.5mm 1mm; width:10%;">القراءة الحالية</th>
                                    <th style="border:0.5pt solid #888; padding:1.5mm 1mm; width:8%;">الاستهلاك</th>
                                    <th style="border:0.5pt solid #888; padding:1.5mm 1mm; width:13%;">المبلغ</th>
                                    <th style="border:0.5pt solid #888; padding:1.5mm 1mm; width:13%;">الرصيد</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- صف الرصيد الافتتاحي -->
                                <t t-if="doc.date_from">
                                    <tr style="font-weight:bold; background:#f9f9f9;">
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:center;"></td>
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:center;">
                                            <span t-esc="doc.date_from"/>
                                        </td>
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm;">Balance Forward</td>
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:center;"></td>
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:center;"></td>
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:center;"></td>
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:left; direction:ltr;"></td>
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:left; direction:ltr;">
                                            <span t-esc="'{:,.2f}'.format(totals['opening'])"/>
                                            <span style="font-size:7pt;"> ر.ي</span>
                                        </td>
                                    </tr>
                                </t>

                                <!-- صفوف الحركات -->
                                <t t-foreach="lines" t-as="line">
                                    <tr t-attf-style="background:{{ 'white' if line_index % 2 == 0 else '#fafafa' }};">
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:center; direction:ltr; unicode-bidi:embed;">
                                            <span t-esc="line.get('ref') or ''"/>
                                        </td>
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:center; direction:ltr; unicode-bidi:embed;">
                                            <span t-esc="line.get('date') or ''"/>
                                        </td>
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm;">
                                            <span t-esc="line.get('description') or ''"/>
                                        </td>
                                        <!-- القراءة السابقة - تظهر فقط للفواتير -->
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:center;">
                                            <t t-if="line.get('kind') == 'invoice'">
                                                <span t-esc="line.get('prev_reading', '')"/>
                                            </t>
                                        </td>
                                        <!-- القراءة الحالية -->
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:center;">
                                            <t t-if="line.get('kind') == 'invoice'">
                                                <span t-esc="line.get('curr_reading', '')"/>
                                            </t>
                                        </td>
                                        <!-- الاستهلاك -->
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:center;">
                                            <t t-if="line.get('kind') == 'invoice'">
                                                <span t-esc="line.get('consumption', '')"/>
                                            </t>
                                        </td>
                                        <!-- المبلغ: مدين أو دائن -->
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:left; direction:ltr; unicode-bidi:embed;">
                                            <t t-if="line.get('debit', 0) > 0">
                                                <span t-esc="'{:,.2f}'.format(line['debit'])"/>
                                                <span style="font-size:7pt;"> ر.ي</span>
                                            </t>
                                            <t t-elif="line.get('credit', 0) > 0">
                                                <span style="color:#c4161c;">-<span t-esc="'{:,.2f}'.format(line['credit'])"/></span>
                                                <span style="font-size:7pt;"> ر.ي</span>
                                            </t>
                                        </td>
                                        <!-- الرصيد التراكمي -->
                                        <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:left; direction:ltr; unicode-bidi:embed; font-weight:bold;">
                                            <span t-esc="'{:,.2f}'.format(line.get('balance', 0))"/>
                                            <span style="font-size:7pt;"> ر.ي</span>
                                        </td>
                                    </tr>
                                </t>

                                <!-- صف الرصيد النهائي -->
                                <tr style="font-weight:bold; background:#f0f0f0;">
                                    <td colspan="2" style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:center;">
                                        <span t-esc="doc.date_to"/>
                                    </td>
                                    <td style="border:0.5pt solid #888; padding:1.5mm 1mm; color:#0056b3; font-weight:bold;">
                                        الرصيد النهائي
                                    </td>
                                    <td style="border:0.5pt solid #888; padding:1.5mm 1mm;"></td>
                                    <td style="border:0.5pt solid #888; padding:1.5mm 1mm;"></td>
                                    <td style="border:0.5pt solid #888; padding:1.5mm 1mm;"></td>
                                    <td style="border:0.5pt solid #888; padding:1.5mm 1mm;"></td>
                                    <td style="border:0.5pt solid #888; padding:1.5mm 1mm; text-align:left; direction:ltr; unicode-bidi:embed; font-size:10pt; color:#0056b3;">
                                        <span t-esc="'{:,.2f}'.format(totals['closing'])"/>
                                        <span style="font-size:7pt;"> ر.ي</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ======================================================== -->
                        <!-- قسم Aging Report                                          -->
                        <!-- ======================================================== -->
                        <div style="margin-bottom:3mm; font-size:9pt;">
                            <span>Aging Report at </span>
                            <span t-esc="doc.date_to"/>
                            <span> in </span>
                            <span t-esc="res_company.currency_id.name"/>:
                        </div>

                        <!-- ======================================================== -->
                        <!-- خط فاصل سفلي وتذييل الصفحة                               -->
                        <!-- ======================================================== -->
                        <div style="position:fixed; bottom:5mm; left:8mm; right:8mm; border-top:1pt solid #333; padding-top:2mm;">
                            <table style="width:100%; border-collapse:collapse; font-size:8pt;">
                                <tr>
                                    <td style="text-align:right; color:#555;">
                                        <span>تاريخ ووقت الطباعة: </span>
                                        <span style="direction:ltr; unicode-bidi:embed;"
                                              t-esc="context_timestamp(datetime.datetime.now()).strftime('%H:%M %d-%m-%Y')"/>
                                    </td>
                                    <td style="text-align:center; color:#555;">
                                        <span>طبع بواسطة: </span>
                                        <span t-esc="user.name"/>
                                    </td>
                                    <td style="text-align:left; color:#555;">
                                        <span>1 / 1 بصفحة</span>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
