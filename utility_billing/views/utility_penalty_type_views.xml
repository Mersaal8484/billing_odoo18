<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_penalty_type_tree" model="ir.ui.view">
        <field name="name">utility.penalty.type.tree</field>
        <field name="model">utility.penalty.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_utility_penalty_type_form" model="ir.ui.view">
        <field name="name">utility.penalty.type.form</field>
        <field name="model">utility.penalty.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="مؤرشف" bg_color="bg-danger" invisible="(active == True)"/>
                    <div class="oe_title">
                        <label for="name" string="اسم الغرامة"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الوصف">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
