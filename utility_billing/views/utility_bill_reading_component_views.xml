<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_bill_reading_component_tree" model="ir.ui.view">
        <field name="name">utility.bill.reading.component.tree</field>
        <field name="model">utility.bill.reading.component</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="sale_order_id"/>
                <field name="reading_id"/>
                <field name="reading_purpose" widget="badge"/>
                <field name="account_id"/>
                <field name="meter_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="previous_reading"/>
                <field name="current_reading"/>
                <field name="meter_multiplier"/>
                <field name="consumption" sum="إجمالي الاستهلاك"/>
                <field name="company_id" invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_utility_bill_reading_component_form" model="ir.ui.view">
        <field name="name">utility.bill.reading.component.form</field>
        <field name="model">utility.bill.reading.component</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="reading_id"/>
                            <field name="reading_purpose" widget="badge"/>
                            <field name="account_id"/>
                            <field name="meter_id"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="previous_reading"/>
                            <field name="current_reading"/>
                            <field name="meter_multiplier"/>
                            <field name="consumption"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
