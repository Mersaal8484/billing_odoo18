<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_report_sales_region_search" model="ir.ui.view">
        <field name="name">utility.report.sales.region.search</field>
        <field name="model">utility.report.sales.region</field>
        <field name="arch" type="xml">
            <search string="مبيعات وسداد المناطق لجميع الفترات">
                <field name="period_id"/>
                <field name="region_id"/>
                <field name="sub_region_id"/>
                <field name="customer_category"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_period" string="الفترة" context="{'group_by': 'period_id'}"/>
                    <filter name="group_region" string="المنطقة" context="{'group_by': 'region_id'}"/>
                    <filter name="group_sub_region" string="المنطقة الفرعية" context="{'group_by': 'sub_region_id'}"/>
                    <filter name="group_category" string="فئة المشترك" context="{'group_by': 'customer_category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_utility_report_sales_region_tree" model="ir.ui.view">
        <field name="name">utility.report.sales.region.tree</field>
        <field name="model">utility.report.sales.region</field>
        <field name="arch" type="xml">
            <tree string="مبيعات وسداد المناطق لجميع الفترات" default_order="period_id desc, region_id, sub_region_id">
                <field name="period_id"/>
                <field name="region_id"/>
                <field name="sub_region_id"/>
                <field name="customer_category"/>
                <field name="sale_count" sum="إجمالي"/>
                <field name="consumption_kwh" sum="إجمالي" string="المبيع ك.و"/>
                <field name="sale_amount" sum="إجمالي" string="المبيع ريال"/>
                <field name="service_fees" sum="إجمالي"/>
                <field name="council_fees" sum="إجمالي"/>
                <field name="energy_fees" sum="إجمالي"/>
                <field name="teacher_fund" sum="إجمالي"/>
                <field name="other_adjustments" sum="إجمالي" string="تسويات"/>
                <field name="adjustments" sum="إجمالي" string="تسويات مبيع"/>
                
                <field name="gross_sales" sum="إجمالي"/>
                <field name="payments" sum="إجمالي"/>
                <field name="remaining" sum="إجمالي"/>
            </tree>
        </field>
    </record>

    <record id="view_utility_report_sales_region_pivot" model="ir.ui.view">
        <field name="name">utility.report.sales.region.pivot</field>
        <field name="model">utility.report.sales.region</field>
        <field name="arch" type="xml">
            <pivot string="مبيعات وسداد المناطق لجميع الفترات" default_order="period_id desc">
                <field name="period_id" type="row"/>
                <field name="region_id" type="row"/>
                <field name="sub_region_id" type="row"/>
                <field name="customer_category" type="row"/>
                <field name="sale_count" type="measure"/>
                <field name="consumption_kwh" type="measure" string="المبيع ك.و"/>
                <field name="sale_amount" type="measure" string="المبيع ريال"/>
                <field name="service_fees" type="measure"/>
                <field name="council_fees" type="measure"/>
                <field name="energy_fees" type="measure"/>
                <field name="teacher_fund" type="measure"/>
                <field name="other_adjustments" type="measure" string="تسويات"/>
                
                <field name="gross_sales" type="measure"/>
                <field name="payments" type="measure"/>
                <field name="remaining" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_utility_report_sales_region" model="ir.actions.act_window">
        <field name="name">مبيعات وسداد المناطق لجميع الفترات</field>
        <field name="res_model">utility.report.sales.region</field>
        <field name="view_mode">pivot,tree</field>
        <field name="search_view_id" ref="view_utility_report_sales_region_search"/>
        <field name="domain">[('period_id', '!=', False)]</field>
        <field name="context">{'search_default_group_period': 1}</field>
    </record>

    <menuitem id="menu_utility_report_sales_region"
              name="مبيعات وسداد المناطق لجميع الفترات"
              parent="menu_utility_billing_reports"
              action="action_utility_report_sales_region"
              sequence="30"
              groups="base.group_system,utility_core.group_utility_admin,utility_core.group_utility_billing_manager,utility_core.group_utility_supervisor,utility_core.group_utility_revenue_manager,utility_core.group_utility_auditor"/>
</odoo>
