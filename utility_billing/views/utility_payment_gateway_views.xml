<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_payment_gateway_transaction_tree" model="ir.ui.view">
        <field name="name">utility.payment.gateway.transaction.tree</field>
        <field name="model">utility.payment.gateway.transaction</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-danger="state == 'failed'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="provider_id"/>
                <field name="payment_direction" widget="badge" decoration-info="payment_direction == 'inbound'" decoration-warning="payment_direction == 'outbound'"/>
                <field name="sale_order_id"/>
                <field name="customer_id"/>
                <field name="utility_invoice_id"/>
                <field name="amount"/>
                <field name="state" widget="badge"/>
                <field name="payment_id"/>
            </list>
        </field>
    </record>

    <record id="view_utility_payment_gateway_transaction_form" model="ir.ui.view">
        <field name="name">utility.payment.gateway.transaction.form</field>
        <field name="model">utility.payment.gateway.transaction</field>
        <field name="arch" type="xml">
            <form string="معاملة دفع / استرداد">
                <header>
                    <button name="action_mark_pending" type="object" string="إرسال للمزود" class="btn-primary" invisible="state not in ('draft')"/>
                    <button name="action_confirm_payment" type="object" string="تأكيد يدوي" class="btn-secondary" invisible="state not in ('pending')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="provider_id"/>
                            <field name="payment_direction"/>
                            <field name="sale_order_id"/>
                            <field name="customer_id"/>
                            <field name="utility_invoice_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="provider_reference"/>
                            <field name="payment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الطلب">
                            <field name="request_payload" nolabel="1"/>
                        </page>
                        <page string="رد المزود">
                            <field name="callback_payload" nolabel="1"/>
                            <field name="error_message" nolabel="1" invisible="(error_message == False)"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_utility_payment_gateway_transaction_search" model="ir.ui.view">
        <field name="name">utility.payment.gateway.transaction.search</field>
        <field name="model">utility.payment.gateway.transaction</field>
        <field name="arch" type="xml">
            <search string="بحث في معاملات الدفع والاصدارات">
                <field name="name" string="المرجع"/>
                <field name="customer_id" string="الحساب"/>
                <field name="sale_order_id" string="الفاتورة"/>
                <field name="provider_id" string="مزود الدفع"/>
                <filter string="وارد (تحصيل)" name="inbound" domain="[('payment_direction', '=', 'inbound')]"/>
                <filter string="صادر (استرداد)" name="outbound" domain="[('payment_direction', '=', 'outbound')]"/>
                <separator/>
                <filter string="مسودة" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="بانتظار التأكيد" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="مؤكدة" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="فاشلة" name="failed" domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter string="اتجاه الدفع" name="group_direction" context="{'group_by': 'payment_direction'}"/>
                    <filter string="الحالة" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="مزود الدفع" name="group_provider" context="{'group_by': 'provider_id'}"/>
                    <filter string="تاريخ الإنشاء" name="group_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_utility_payment_gateway_transaction" model="ir.actions.act_window">
        <field name="name">معاملات بوابة الدفع</field>
        <field name="res_model">utility.payment.gateway.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_utility_payment_gateway_transaction_search"/>
    </record>

    <menuitem id="menu_utility_payment_gateway_transaction" name="معاملات بوابة الدفع" parent="utility_core.menu_utility_integrations" sequence="30" action="action_utility_payment_gateway_transaction" groups="utility_core.group_utility_admin"/>
</odoo>
