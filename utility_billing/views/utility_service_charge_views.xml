<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_service_charge_tree" model="ir.ui.view">
        <field name="name">utility.service.charge.tree</field>
        <field name="model">utility.service.charge</field>
        <field name="arch" type="xml">
            <list create="0" default_order="date desc, id desc"
                  decoration-success="state == 'paid'"
                  decoration-warning="state in ('confirmed', 'payment_requested', 'invoiced')"
                  decoration-muted="state in ('cancelled', 'reversed')">
                <field name="name"/>
                <field name="date"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="activation_type" widget="badge"/>
                <field name="billing_method"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_utility_service_charge_form" model="ir.ui.view">
        <field name="name">utility.service.charge.form</field>
        <field name="model">utility.service.charge</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_confirm" string="تأكيد" type="object" class="btn-primary" invisible="state not in ('draft')"/>
                    <button name="action_create_invoice" string="إنشاء فاتورة" type="object" class="btn-primary" invisible="((billing_method != 'invoice')) or (state not in ('confirmed'))"/>
                    <button name="action_open_direct_payment" string="تحصيل مباشر" type="object" class="btn-primary" invisible="((billing_method != 'direct_payment')) or (state not in ('confirmed', 'payment_requested'))"/>
                    <button name="action_mark_paid_from_payment" string="تحديث حالة السداد" type="object" class="btn-secondary" invisible="state not in ('invoiced', 'payment_requested')"/>
                    <button name="action_cancel" string="إلغاء" type="object" class="btn-secondary" invisible="state not in ('draft', 'confirmed', 'payment_requested')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,invoiced,payment_requested,paid"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="بيانات المشترك">
                            <field name="account_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="activation_type" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group string="بيانات التحصيل">
                            <field name="date" readonly="(state != 'draft')"/>
                            <field name="billing_method" readonly="(state != 'draft')"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="تفاصيل الرسم">
                            <group>
                                <group>
                                    <field name="product_id" readonly="(state != 'draft')"/>
                                    <field name="description" readonly="(state != 'draft')"/>
                                    <field name="quantity" readonly="(state != 'draft')"/>
                                </group>
                                <group>
                                    <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="(state != 'draft')"/>
                                    <field name="tax_ids" widget="many2many_tags" readonly="(state != 'draft')"/>
                                    <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="المستندات المالية">
                            <group><field name="invoice_id" readonly="1"/><field name="payment_id" readonly="1"/></group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_utility_service_charge_search" model="ir.ui.view">
        <field name="name">utility.service.charge.search</field>
        <field name="model">utility.service.charge</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="account_id"/><field name="partner_id"/><field name="state"/>
                <filter name="filter_date" string="التاريخ" date="date"/>
                <filter name="filter_pending" string="بانتظار التحصيل" domain="[('state', 'in', ['confirmed', 'invoiced', 'payment_requested'])]"/>
                <filter name="filter_paid" string="مسدد" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="تصنيف حسب">
                    <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                    <filter name="group_activation" string="سبب الرسم" context="{'group_by': 'activation_type'}"/>
                    <filter name="group_customer" string="المشترك" context="{'group_by': 'account_id'}"/>
                    <filter name="group_company" string="الشركة" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_utility_service_charge" model="ir.actions.act_window">
        <field name="name">رسوم إدخال الخدمة</field>
        <field name="res_model">utility.service.charge</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_utility_service_charge_search"/>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_utility_service_charges" name="رسوم إدخال الخدمة"
              parent="utility_billing.menu_utility_accounting" sequence="35"
              action="action_utility_service_charge"/>
</odoo>
