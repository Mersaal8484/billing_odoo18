<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- مطابق لنسبة أبعاد نموذج فاتورة الاشتراك المعتمد. -->
    <record id="paperformat_utility_receipt" model="report.paperformat">
        <field name="name">فاتورة اشتراك كهرباء (134mm x 290mm)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">134</field>
        <field name="page_width">290</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- تقرير خاص لطباعة الفاتورة بالحجم المخصص دون التأثير على أوامر البيع العادية -->
    <record id="action_report_utility_bill" model="ir.actions.report">
        <field name="name">طباعة فاتورة المشترك (إيصال)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">utility_billing.report_electricity_bill</field>
        <field name="report_file">utility_billing.report_electricity_bill</field>
        <field name="print_report_name">'فاتورة - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="utility_billing.paperformat_utility_receipt"/>
    </record>

    <!-- قالب فاتورة الاشتراك: محاكاة مباشرة للنموذج الورقي المعتمد. -->
    <template id="report_electricity_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="values" t-value="report_data.get(o.id, {})"/>
                <div class="article" style="width:100%; margin:0; padding:0; page-break-after:always;" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" t-att-data-oe-lang="o.env.context.get('lang')">
                    <div dir="rtl" style="box-sizing:border-box; width:100%; min-height:130mm; border:0.75pt solid #000; padding:2mm; background:#fff; color:#151515; font-family:Tahoma, Arial, sans-serif; font-size:8pt; line-height:1.3;">
                        <table style="width:100%; border-collapse:collapse; table-layout:fixed; margin:0 0 1.5mm;">
                            <tr>
                                <td style="width:35%; vertical-align:top; padding:0 1.5mm 0 0;">
                                    <div style="color:#075aa5; font-weight:bold; font-size:8.5pt;">المشترك: <span style="color:#111; font-weight:normal;" t-esc="(o.partner_id.name or '--') + (' - ' + o.customer_id.customer_number if o.customer_id.customer_number else '')"/></div>
                                    <div style="color:#075aa5;">العنوان: <span style="color:#111;" t-esc="o.partner_id.contact_address or o.partner_id.street or '--'"/></div>
                                    <div style="color:#075aa5;">الجوال: <span style="color:#111; direction:ltr; unicode-bidi:embed;" t-esc="o.customer_id.mobile or o.partner_id.mobile or o.partner_id.phone or '--'"/></div>
                                    <div style="color:#075aa5;">الفترة: <span style="color:#111;" t-esc="o.date_range_id.name or '--'"/></div>
                                    <div style="color:#075aa5;">التعرفة: <span style="color:#111;" t-esc="o.contract_template_id.name or '--'"/></div>
                                    <div style="color:#075aa5;">الحرف: <span style="color:#111;" t-esc="o.customer_id.subscriber_id.name or '--'"/></div>
                                    <div style="color:#075aa5;">الفئة: <span style="color:#111;" t-esc="o.customer_id.category_id.name or '--'"/></div>
                                </td>
                                <td style="width:30%; vertical-align:top; text-align:center; padding:0 1mm;">
                                    <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="display:block; margin:0 auto .5mm; max-height:20mm; max-width:36mm;" alt="Logo"/>
                                    <div style="color:#075aa5; font-weight:bold; font-size:10pt;" t-esc="res_company.name"/>
                                    <div style="color:#075aa5; font-size:8.5pt;" t-if="o.region_id" t-esc="o.region_id.name"/>
                                    <div style="color:#075aa5; font-weight:bold; font-size:11pt; margin-top:1mm;">فــــاتـــورة كــــهـــربــــاء</div>
                                </td>
                                <td style="width:35%; vertical-align:top; direction:rtl; padding:0 0 0 1.5mm;">
                                    <div style="color:#075aa5;">رقم العداد: <span style="color:#111; direction:ltr; unicode-bidi:embed;" t-esc="o.meter_id.meter_number or '--'"/></div>
                                    <div style="color:#075aa5;">رقم المشترك: <span style="color:#111; direction:ltr; unicode-bidi:embed;" t-esc="o.customer_id.customer_number or '--'"/></div>
                                    <div style="color:#075aa5;">رقم الفاتورة: <span style="color:#111; direction:ltr; unicode-bidi:embed;" t-esc="o.name or '--'"/></div>
                                    <div style="color:#075aa5;">تاريخ الإصدار: <span style="color:#111; direction:ltr; unicode-bidi:embed;" t-esc="o.date_order.strftime('%d/%m/%Y') if o.date_order else '--'"/></div>
                                    <div style="color:#075aa5;">معامل الضرب: <span style="color:#111;" t-esc="o.meter_id.multiplier or 1.0"/></div>
                                    <div style="color:#075aa5;">المحول: <span style="color:#111;" t-esc="o.meter_id.transformer_id.name or o.customer_id.transformer_id.name or '--'"/></div>
                                    <div style="color:#075aa5;">المحصل: <span style="color:#111;" t-esc="values.get('collector_name') or '--'"/></div>
                                </td>
                            </tr>
                        </table>
                        <table style="width:100%; border-collapse:collapse; table-layout:fixed; text-align:center; margin:0; color:#c4161c;">
                            <tr style="background:#d7f3f5; font-weight:bold;">
                                <td style="border:.5pt solid #c4161c; padding:1.2mm .5mm;">القراءة السابقة</td>
                                <td style="border:.5pt solid #c4161c; padding:1.2mm .5mm;">القراءة الحالية</td>
                                <td style="border:.5pt solid #c4161c; padding:1.2mm .5mm;">الاستهلاك (ك.و)</td>
                                <td style="border:.5pt solid #c4161c; padding:1.2mm .5mm;">قيمة الاستهلاك</td>
                            </tr>
                            <tr style="font-weight:bold; font-size:9pt;">
                                <td style="border:.5pt solid #c4161c; padding:1.2mm .5mm;"><span t-esc="o.previous_reading"/></td>
                                <td style="border:.5pt solid #c4161c; padding:1.2mm .5mm;"><span t-esc="o.current_reading"/></td>
                                <td style="border:.5pt solid #c4161c; padding:1.2mm .5mm;"><span t-esc="o.consumption"/></td>
                                <td style="border:.5pt solid #c4161c; padding:1.2mm .5mm;"><span t-esc="o.amount_energy" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td>
                            </tr>
                        </table>
                        <table style="width:100%; border-collapse:collapse; table-layout:fixed; text-align:center; margin:1mm 0 0; color:#c4161c;">
                            <tr style="background:#d7f3f5; font-weight:bold;">
                                <td style="border:.5pt solid #c4161c; padding:1mm .3mm;">رسوم خدمات</td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;">رسوم مجلس محلي</td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;">رسوم نظافة</td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;">صندوق المعلم</td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;">مبلغ الفاتورة الحالية</td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;">المتأخرات السابقة</td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;">المبلغ المستحق</td>
                            </tr>
                            <tr style="font-weight:bold;">
                                <td style="border:.5pt solid #c4161c; padding:1mm .3mm;"><span t-esc="values.get('service_fee', 0.0)" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;"><span t-esc="values.get('municipality_fee', 0.0)" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;"><span t-esc="values.get('cleaning_fee', 0.0)" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;"><span t-esc="values.get('mu_allim_fee', 0.0)" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;"><span t-esc="o.amount_total" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;"><span t-esc="o.previous_balance" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;"><span t-esc="o.total_due_amount" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td>
                            </tr>
                        </table>
                        <table style="width:71.43%; border-collapse:collapse; table-layout:fixed; text-align:center; margin:1mm 0 0 auto; color:#c4161c;">
                            <tr style="background:#d7f3f5; font-weight:bold;"><td style="border:.5pt solid #c4161c; padding:1mm .3mm;">سداد الفترة السابقة</td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;">سداد الفترة الحالية</td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;">تسويات الفترة السابقة</td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;">تسويات الفترة الحالية</td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;">رصيد المشترك النهائي</td></tr>
                            <tr style="font-weight:bold;"><td style="border:.5pt solid #c4161c; padding:1mm .3mm;"><span t-esc="values.get('previous_payment', 0.0)" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;"><span t-esc="values.get('current_payment', 0.0)" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;"><span t-esc="values.get('previous_settlement', 0.0)" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;"><span t-esc="values.get('current_settlement', 0.0)" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td><td style="border:.5pt solid #c4161c; padding:1mm .3mm;"><span t-esc="o.total_due_amount" t-options='{"widget":"monetary", "display_currency":o.currency_id}'/></td></tr>
                        </table>
                        <div style="margin-top:2mm; padding:1mm 0; border-top:.5pt solid #c8c8c8; font-size:7pt;"><strong style="color:#e85c8e;">تنبيه هام:</strong> <span>المشترك مسؤول عن سداد فاتورته في الموعد المحدد، ويرجى عدم تسليم رقم المشترك أو رابط السداد لأي جهة غير معتمدة.</span></div>
                        <table style="width:100%; border-collapse:collapse; table-layout:fixed; margin-top:1mm; font-size:7pt;"><tr><td style="width:22%; text-align:right; direction:ltr;"><img t-if="o.qr_code_url" t-att-src="o.qr_code_url" style="width:19mm; height:19mm;" alt="QR Code"/></td><td style="width:50%; text-align:center; vertical-align:middle; color:#075aa5; font-weight:bold;"><div t-if="res_company.phone"><span t-esc="res_company.phone"/></div><div t-if="res_company.email"><span t-esc="res_company.email"/></div><div t-if="res_company.website"><span t-esc="res_company.website"/></div></td><td style="width:28%; vertical-align:middle; color:#e85c8e;"><div>طبع بواسطة: <span t-esc="user.name"/></div><div>تاريخ الطباعة: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/></div></td></tr></table>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- Update Standard Sale Order PDF Report -->
    <template id="report_saleorder_document_utility" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@name='total']//table" position="inside">
            <t t-if="doc.previous_balance &gt; 0">
                <tr class="border-black o_subtotal">
                    <td><strong>رصيد المتأخرات (سابق)</strong></td>
                    <td class="text-end">
                        <span t-field="doc.previous_balance"
                            t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </td>
                </tr>
                <tr class="border-black o_total">
                    <td><strong>إجمالي المطلوب سداده</strong></td>
                    <td class="text-end">
                        <span t-field="doc.total_due_amount"
                            t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </td>
                </tr>
            </t>
        </xpath>
    </template>
</odoo>
