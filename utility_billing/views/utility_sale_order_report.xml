<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- فاتورة اشتراك كهرباء — مقاس 210mm عرض × 70mm ارتفاع -->
    <record id="paperformat_utility_receipt" model="report.paperformat">
        <field name="name">فاتورة اشتراك كهرباء (210mm x 70mm)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">70</field>
        <field name="page_width">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- تقرير خاص لطباعة الفاتورة بالحجم المخصص -->
    <record id="action_report_utility_bill" model="ir.actions.report">
        <field name="name">طباعة فاتورة المشترك (إيصال)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">utility_billing.report_electricity_bill</field>
        <field name="report_file">utility_billing.report_electricity_bill</field>
        <!-- Add a timestamp so every browser download has a distinct filename. -->
        <field name="print_report_name">'فاتورة - %s - %s' % (object.name, time.strftime('%Y%m%d-%H%M%S'))</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="utility_billing.paperformat_utility_receipt"/>
    </record>

    <!-- قالب فاتورة الاشتراك — 210mm × 70mm مضغوط ومطابق للنموذج -->
    <template id="report_electricity_bill">
        <t t-call="web.html_container">
            <style>
                @page { size: 210mm 70mm; margin: 0 !important; }
                html, body {
                    width: 210mm !important;
                    height: 70mm !important;
                    margin: 0 !important;
                    padding: 0 !important;
                }
                .page.utility-electricity-bill {
                    box-sizing: border-box !important;
                    width: 210mm !important;
                    min-width: 210mm !important;
                    max-width: 210mm !important;
                    min-height: 70mm !important;
                    height: 70mm !important;
                    max-height: 70mm !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    overflow: hidden !important;
                    page-break-after: always;
                }
                .utility-electricity-bill .utility-electricity-bill-content {
                    box-sizing: border-box !important;
                    width: 210mm !important;
                    min-width: 210mm !important;
                    max-width: 210mm !important;
                    height: 70mm !important;
                    min-height: 70mm !important;
                    max-height: 70mm !important;
                    margin: 0 !important;
                }
            </style>
            <t t-foreach="docs" t-as="o">
                <t t-set="values" t-value="report_data.get(o.id, {})"/>
                <!--
                    `article` is required by ir.actions.report._prepare_html.
                    It makes Odoo rebuild this fragment with web.minimal_layout,
                    which supplies the UTF-8 HTML head used by wkhtmltopdf.
                    Keep the page-specific classes on the same element so the
                    custom 210 x 70 mm geometry remains unchanged.
                -->
                <div class="article page utility-electricity-bill" lang="ar" dir="rtl"
                     t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">

                    <div class="utility-electricity-bill-content" dir="rtl" style="
                        box-sizing:border-box;
                        width:210mm;
                        height:70mm;
                        border:0.5pt solid #222;
                        padding:1.2mm 2mm;
                        background:#fff;
                        color:#111;
                        font-family:Tahoma, Arial, sans-serif;
                        font-size:6pt;
                        line-height:1.25;
                        overflow:hidden;
                    ">

                        <!-- ======================================================== -->
                        <!-- الهيدر: بيانات المشترك | الشعار والعنوان | بيانات العداد  -->
                        <!-- ======================================================== -->
                        <table style="width:100%; border-collapse:collapse; table-layout:fixed; margin-bottom:0.8mm;">
                            <tr>
                                <!-- يمين: بيانات المشترك -->
                                <td style="width:38%; vertical-align:top; padding:0 0.8mm 0 0; font-size:6pt;">
                                    <div><span style="color:#075aa5; font-weight:bold;">المشترك: </span><span t-esc="o.partner_id.name or '--'"/></div>
                                    <div><span style="color:#075aa5; font-weight:bold;">العنوان: </span><span t-esc="o.partner_id.street or '--'"/></div>
                                    <div><span style="color:#075aa5; font-weight:bold;">الجوال: </span><span style="direction:ltr;unicode-bidi:embed;" t-esc="o.customer_id.mobile or o.partner_id.mobile or '--'"/></div>
                                    <div><span style="color:#075aa5; font-weight:bold;">الفترة: </span><span t-esc="o.date_range_id.name or '--'"/></div>
                                    <div><span style="color:#075aa5; font-weight:bold;">التعرفة: </span><span t-esc="o.contract_template_id.name or '--'"/></div>
                                    <div><span style="color:#075aa5; font-weight:bold;">الحرف: </span><span t-esc="o.customer_id.subscriber_id.name or '--'"/></div>
                                    <div><span style="color:#075aa5; font-weight:bold;">الفئة: </span><span t-esc="o.customer_id.category_id.name or '--'"/></div>
                                </td>

                                <!-- وسط: شعار + اسم + فاتورة كهرباء -->
                                <td style="width:24%; vertical-align:top; text-align:center; padding:0 0.5mm; font-size:6pt;">
                                    <t t-if="res_company.logo">
                                        <img t-att-src="image_data_uri(res_company.logo)"
                                             style="display:block; margin:0 auto 0.3mm; max-height:10mm; max-width:20mm;" alt="Logo"/>
                                    </t>
                                    <div style="color:#075aa5; font-weight:bold; font-size:6.5pt;" t-esc="res_company.name"/>
                                    <t t-if="o.region_id">
                                        <div style="color:#075aa5; font-size:5.5pt;" t-esc="o.region_id.name"/>
                                    </t>
                                    <div style="color:#075aa5; font-weight:bold; font-size:7.5pt; margin-top:0.5mm;">فاتورة كهرباء</div>
                                </td>

                                <!-- يسار: بيانات العداد -->
                                <td style="width:38%; vertical-align:top; padding:0 0 0 0.8mm; font-size:6pt;">
                                    <div><span style="color:#075aa5; font-weight:bold;">رقم العداد: </span><span style="direction:ltr;unicode-bidi:embed;" t-esc="o.meter_id.meter_number or '--'"/></div>
                                    <div><span style="color:#075aa5; font-weight:bold;">رقم المشترك: </span><span style="direction:ltr;unicode-bidi:embed;" t-esc="o.customer_id.customer_number or '--'"/></div>
                                    <div><span style="color:#075aa5; font-weight:bold;">رقم الفاتورة: </span><span style="direction:ltr;unicode-bidi:embed;" t-esc="o.name or '--'"/></div>
                                    <div><span style="color:#075aa5; font-weight:bold;">تاريخ الإصدار: </span><span style="direction:ltr;unicode-bidi:embed;" t-esc="o.date_order.strftime('%d/%m/%Y') if o.date_order else '--'"/></div>
                                    <div><span style="color:#075aa5; font-weight:bold;">معامل الضرب: </span><span t-esc="o.meter_id.multiplier or 1.0"/></div>
                                    <div><span style="color:#075aa5; font-weight:bold;">المحول: </span><span t-esc="o.meter_id.transformer_id.name or o.customer_id.transformer_id.name or '--'"/></div>
                                    <div><span style="color:#075aa5; font-weight:bold;">المحصل: </span><span t-esc="values.get('collector_name') or '--'"/></div>
                                </td>
                            </tr>
                        </table>

                        <!-- ======================================================== -->
                        <!-- جدول القراءات                                             -->
                        <!-- ======================================================== -->
                        <table style="width:100%; border-collapse:collapse; table-layout:fixed; text-align:center; margin:0; color:#c4161c; font-size:6pt;">
                            <tr style="background:#d7f3f5; font-weight:bold;">
                                <td style="border:0.5pt solid #c4161c; padding:0.8mm 0.3mm; width:25%;">القراءة السابقة</td>
                                <td style="border:0.5pt solid #c4161c; padding:0.8mm 0.3mm; width:25%;">القراءة الحالية</td>
                                <td style="border:0.5pt solid #c4161c; padding:0.8mm 0.3mm; width:25%;">الاستهلاك (ك.و)</td>
                                <td style="border:0.5pt solid #c4161c; padding:0.8mm 0.3mm; width:25%;">قيمة الاستهلاك ر.ي</td>
                            </tr>
                            <tr style="font-weight:bold; font-size:6.5pt;">
                                <td style="border:0.5pt solid #c4161c; padding:0.8mm 0.3mm;"><span t-esc="o.previous_reading"/></td>
                                <td style="border:0.5pt solid #c4161c; padding:0.8mm 0.3mm;"><span t-esc="o.current_reading"/></td>
                                <td style="border:0.5pt solid #c4161c; padding:0.8mm 0.3mm;"><span t-esc="o.consumption"/></td>
                                <td style="border:0.5pt solid #c4161c; padding:0.8mm 0.3mm;"><span t-esc="o.amount_energy" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                            </tr>
                        </table>

                        <!-- ======================================================== -->
                        <!-- جدول الرسوم (صفان)                                       -->
                        <!-- ======================================================== -->
                        <table style="width:100%; border-collapse:collapse; table-layout:fixed; text-align:center; margin-top:0.5mm; color:#c4161c; font-size:6pt;">
                            <tr style="background:#d7f3f5; font-weight:bold;">
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;">رسوم خدمات</td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;">رسوم مجلس محلي</td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;">رسوم نظافة</td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;">صندوق المعلم</td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;">مبلغ الفاتورة</td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;">متأخرات سابقة</td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm; background:#f8d7d7; font-weight:bold;">إجمالي المطلوب سداده</td>
                            </tr>
                            <tr style="font-weight:bold;">
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;"><span t-esc="values.get('service_fee',0.0)" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;"><span t-esc="values.get('municipality_fee',0.0)" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;"><span t-esc="values.get('cleaning_fee',0.0)" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;"><span t-esc="values.get('mu_allim_fee',0.0)" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;"><span t-esc="o.amount_total" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;"><span t-esc="o.previous_balance" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm; background:#f8d7d7; font-size:6.5pt; font-weight:bold;"><span t-esc="o.total_due_amount" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                            </tr>
                            <tr style="background:#d7f3f5; font-weight:bold;">
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;">سداد الفترة السابقة</td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;">سداد الفترة الحالية</td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;">تسويات سابقة</td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;">تسويات حالية</td>
                                <td colspan="3" style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm; background:#f8d7d7; font-weight:bold; font-size:6.5pt;">الرصيد النهائي (الفاتورة الحالية + المتأخرات)</td>
                            </tr>
                            <tr style="font-weight:bold;">
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;"><span t-esc="values.get('previous_payment',0.0)" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;"><span t-esc="values.get('current_payment',0.0)" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;"><span t-esc="values.get('previous_settlement',0.0)" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                                <td style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm;"><span t-esc="values.get('current_settlement',0.0)" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                                <td colspan="3" style="border:0.5pt solid #c4161c; padding:0.7mm 0.2mm; background:#f8d7d7; font-size:6.5pt; font-weight:bold;"><span t-esc="o.total_due_amount" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td>
                            </tr>
                        </table>

                        <!-- ======================================================== -->
                        <!-- التنبيه + QR + معلومات الطباعة                           -->
                        <!-- ======================================================== -->
                        <table style="width:100%; border-collapse:collapse; table-layout:fixed; margin-top:0.6mm; font-size:5.2pt;">
                            <tr>
                                <!-- QR -->
                                <td style="width:13%; vertical-align:bottom; padding:0; text-align:right;">
                                    <t t-if="o.qr_code_url">
                                        <img t-att-src="o.qr_code_url" style="width:11mm; height:11mm;" alt="QR"/>
                                    </t>
                                </td>
                                <!-- نص التنبيه + الاتصال -->
                                <td style="width:57%; vertical-align:middle; padding:0 0.8mm; font-size:5pt; color:#333;">
                                    <div><strong style="color:#e85c8e;">تنبيه: </strong>عزيزي المشترك يجب أخذ سند التحصيل من المختص عند السداد وكذلك التأكد من وصول رسالة SMS.</div>
                                    <div style="color:#075aa5; font-weight:bold; margin-top:0.3mm;">
                                        للشكاوى: <span style="color:#c4161c; direction:ltr; unicode-bidi:embed;">01604666 - 780240480</span>
                                        &amp; خدمة الجمهور: <span style="color:#c4161c;">8000144</span>
                                    </div>
                                </td>
                                <!-- الطابع + الوقت -->
                                <td style="width:30%; vertical-align:middle; padding:0; color:#e85c8e; font-size:5pt;">
                                    <div><strong>طبع بواسطة: </strong><span t-esc="user.name"/></div>
                                    <div><strong>وقت الطباعة: </strong><span style="direction:ltr; unicode-bidi:embed;" t-esc="context_timestamp(datetime.datetime.now()).strftime('%H:%M %d-%m-%Y')"/></div>
                                </td>
                            </tr>
                        </table>

                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- Update Standard Sale Order PDF Report -->
    <template id="report_saleorder_document_utility" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@name='total']//table" position="inside">
            <t t-if="doc.previous_balance &gt; 0">
                <tr class="border-black o_subtotal">
                    <td><strong>متأخرات سابقة</strong></td>
                    <td class="text-end">
                        <span t-field="doc.previous_balance"
                            t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </td>
                </tr>
                <tr class="border-black o_total">
                    <td><strong>إجمالي المطلوب سداده</strong></td>
                    <td class="text-end">
                        <span t-field="doc.total_due_amount"
                            t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </td>
                </tr>
            </t>
        </xpath>
    </template>
</odoo>
