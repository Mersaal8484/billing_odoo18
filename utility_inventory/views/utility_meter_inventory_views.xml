<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_meter_form_inventory" model="ir.ui.view">
        <field name="name">utility.meter.form.inventory</field>
        <field name="model">utility.meter</field>
        <field name="inherit_id" ref="utility_core.view_utility_meter_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='assignment']" position="after">
                <page name="inventory" string="المخزون والرقم المادي">
                    <group>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="lot_id" domain="[('product_id', '=', product_id)]" options="{'no_create': True}"/>
                        <field name="serial_number" readonly="1"/>
                    </group>
                    <div class="text-muted">
                        الرقم التسلسلي المادي مصدره Lot/Serial في المخزون ولا يُعدّل من شاشة العداد.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_utility_meter_tree_inventory" model="ir.ui.view">
        <field name="name">utility.meter.tree.inventory</field>
        <field name="model">utility.meter</field>
        <field name="inherit_id" ref="utility_core.view_utility_meter_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='operational_number']" position="after">
                <field name="serial_number" string="الرقم التسلسلي المادي"/>
            </xpath>
        </field>
    </record>

    <record id="view_utility_meter_search_inventory" model="ir.ui.view">
        <field name="name">utility.meter.search.inventory</field>
        <field name="model">utility.meter</field>
        <field name="inherit_id" ref="utility_core.view_utility_meter_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='operational_number']" position="after">
                <field name="serial_number" string="الرقم التسلسلي المادي"/>
                <field name="product_id"/>
                <field name="lot_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_utility_meter_model_form_inventory" model="ir.ui.view">
        <field name="name">utility.meter.model.form.inventory</field>
        <field name="model">utility.meter.model</field>
        <field name="inherit_id" ref="utility_core.view_utility_meter_model_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_product" type="object" class="oe_stat_button" icon="fa-cube" invisible="(product_id == False)">
                    <span class="o_stat_text">فتح المنتج</span>
                </button>
            </xpath>
            <xpath expr="//field[@name='communication_types']" position="after">
                <field name="product_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_utility_meter_model_tree_inventory" model="ir.ui.view">
        <field name="name">utility.meter.model.tree.inventory</field>
        <field name="model">utility.meter.model</field>
        <field name="inherit_id" ref="utility_core.view_utility_meter_model_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sts_supported']" position="after">
                <field name="product_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
