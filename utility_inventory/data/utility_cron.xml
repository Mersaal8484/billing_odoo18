<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_check_meter_stock_alignment" model="ir.cron">
            <field name="name">المخزون: تدقيق توافق العدادات والمواقع المخزنية</field>
            <field name="model_id" ref="utility_core.model_utility_meter"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_meter_stock_alignment(batch_limit=500)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="utility_managed" eval="True"/>
            <field name="utility_code">meter_stock_alignment_checker</field>
            <field name="utility_category">maintenance</field>
            <field name="utility_description">تدقيق التوافق بين الحالة المنطقية للعدادات ومواقعها المخزنية الفعلية وتسجيل الفروقات</field>
            <field name="prevent_overlap" eval="True"/>
            <field name="allow_manual_run" eval="True"/>
            <field name="batch_size">500</field>
        </record>
    </data>
</odoo>
