<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ═══════════════════════════════════════════════════════════════
             Multi-Company Record Rules for utility.meter.integrity.issue
             ═══════════════════════════════════════════════════════════════ -->
        <record id="rule_meter_integrity_issue_multi_company" model="ir.rule">
            <field name="name">Utility Meter Integrity Issue: Multi-Company</field>
            <field name="model_id" ref="model_utility_meter_integrity_issue"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('utility_core.group_utility_admin'))]"/>
        </record>

        <record id="rule_meter_integrity_issue_supervisor_scope" model="ir.rule">
            <field name="name">Utility Meter Integrity Issue: Supervisor Scope</field>
            <field name="model_id" ref="model_utility_meter_integrity_issue"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('utility_core.group_utility_supervisor'))]"/>
        </record>

        <record id="rule_meter_integrity_issue_technician_scope" model="ir.rule">
            <field name="name">Utility Meter Integrity Issue: Technician Read</field>
            <field name="model_id" ref="model_utility_meter_integrity_issue"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('utility_core.group_utility_technician'))]"/>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             Multi-Company Record Rules for stock.picking (utility extensions)
             Limits utility-tagged pickings to own company only.
             ═══════════════════════════════════════════════════════════════ -->
        <record id="rule_stock_picking_utility_multi_company" model="ir.rule">
            <field name="name">Stock Picking Utility: Multi-Company</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('utility_core.group_utility_admin'))]"/>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
             Multi-Company Record Rules for stock.warehouse (utility extensions)
             ═══════════════════════════════════════════════════════════════ -->
        <record id="rule_stock_warehouse_utility_multi_company" model="ir.rule">
            <field name="name">Stock Warehouse Utility: Multi-Company</field>
            <field name="model_id" ref="stock.model_stock_warehouse"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('utility_core.group_utility_admin'))]"/>
        </record>

    </data>
</odoo>
