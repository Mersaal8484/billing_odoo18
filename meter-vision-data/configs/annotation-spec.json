{
  "version": "0.2.0",
  "detection_classes": ["meter", "display", "meter_number", "qr_code"],
  "meter_families": ["digital_lcd", "digital_green", "mechanical_roller", "mechanical_round", "three_phase", "unknown"],
  "ocr_fields": [
    {"name": "reading", "required": true, "allow_decimal": true},
    {"name": "meter_number", "required": false, "allow_decimal": false}
  ],
  "capture_fields": ["group_id", "image_quality", "capture_issue"],
  "review_policy": {
    "gold_requires_reviewers": 2,
    "disagreement_requires_adjudication": true,
    "no_guessing": true
  }
}
