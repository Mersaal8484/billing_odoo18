<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== TREE VIEW ===================== -->
    <record id="view_utility_customer_tree" model="ir.ui.view">
        <field name="name">utility.customer.tree</field>
        <field name="model">utility.customer</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'closed'"
                  decoration-warning="state in ('suspended', 'disconnected')" 
                  decoration-success="state == 'active'">
                <field name="customer_number"/>
                <field name="external_qr_reference" optional="hide"/>
                <field name="partner_id"/>
                <field name="category_id" optional="hide"/>
                <field name="subscriber_id"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state in ('suspended', 'disconnected')" decoration-danger="state == 'closed'"/>
                <field name="region_id"/>
                <field name="area_id"/>
                <field name="route_id"/>
                <field name="company_currency_id" invisible="1"/>
                <field name="meter_id"/>
                <field name="opening_balance" optional="show" sum="Total Opening"/>
                <field name="accounting_balance" optional="show" sum="Total Balance" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                <field name="current_balance" optional="show" sum="Total Current"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_utility_customer_form" model="ir.ui.view">
        <field name="name">utility.customer.form</field>
        <field name="model">utility.customer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,suspended,disconnected,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_accounting_invoices" type="object"
                                class="oe_stat_button" icon="fa-usd">
                            <field name="accounting_balance" string="المديونية" widget="statinfo"/>
                        </button>
                        <button name="action_view_bills" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" string="الفواتير" widget="statinfo"/>
                        </button>
                        <button name="action_view_accounting_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="accounting_invoice_count" string="الفواتير المحاسبية" widget="statinfo"/>
                        </button>
                        <button name="action_view_readings" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="reading_count" string="القراءات" widget="statinfo"/>
                        </button>
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="payment_count" string="التحصيلات" widget="statinfo"/>
                        </button>
                        <button name="action_view_replacements" type="object"
                                class="oe_stat_button" icon="fa-retweet">
                            <field name="replacement_count" string="الاستبدالات" widget="statinfo"/>
                        </button>
                        <button name="action_view_tampers" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="tamper_count" string="التلاعب" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="customer_number" string="رقم المشترك / الحساب"/>
                        <h1><field name="customer_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="معلومات الهوية والنوع">
                            <field name="external_qr_reference" placeholder="QR-..."/>
                            <field name="partner_id" domain="[('utility_partner_type', '=', 'subscriber')]"/>
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="subscriber_id" options="{'no_create': True}"/>
                            <field name="payment_type" widget="badge" decoration-success="payment_type == 'postpaid'"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="معلومات الاتصال والمنطقة">
                            <field name="mobile"/>
                            <field name="region_id"/>
                            <field name="area_id"/>
                            <field name="zone_id"/>

                            <field name="available_route_ids" invisible="1"/>
                            <field name="route_id" domain="[('id', 'in', available_route_ids)]"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- صفحة 1: بيانات العقد والفوترة -->
                        <page name="billing" string="العقد والفوترة">
                            <group>
                                <group string="الأجهزة والتعرفة">
                                    <field name="meter_id" readonly="1" options="{'no_create': True}"/>
                                    <field name="last_reading_value" string="القراءة الحالية للعداد" readonly="1"/>
                                </group>
                                <group string="الأرصدة والمبيعات">
                                    <field name="company_currency_id" invisible="1"/>
                                    <field name="opening_balance"/>
                                    <field name="current_balance"/>
                                    <field name="accounting_balance" widget="monetary" options="{'currency_field': 'company_currency_id'}" invisible="(payment_type != 'postpaid')"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- صفحة 2: الاشتراك المتكرر -->
                        <page name="recurring_contract" string="الاشتراك المتكرر" invisible="(payment_type == 'prepaid')">
                            <group>
                                <group string="قالب العقد والتواريخ">
                                    <field name="available_contract_template_ids" invisible="1"/>
                                    <field name="contract_template_id" options="{'no_create': True}" domain="[('id', 'in', available_contract_template_ids)]"/>
                                    <field name="date_contract"/>
                                    <field name="date_sub_start"/>
                                    <field name="date_end"/>
                                </group>
                                <group string="دورة الفوترة والقرارات">
                                    <field name="last_reading_date" readonly="1"/>
                                    <field name="last_invoice_date" readonly="1"/>
                                    <field name="last_reading_value" readonly="1"/>
                                    <field name="last_invoice_reading" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- صفحة 3: الخلية والمحول -->
                        <page name="transformer_cell" string="الخلية والمحول">
                            <group>
                                <group string="الربط بالشبكة">
                                    <field name="is_private_transformer" invisible="1"/>
                                    <field name="cell_id" options="{'no_create': True}" invisible="(is_private_transformer == False)"/>
                                    <field name="transformer_id" options="{'no_create': True}"/>
                                    <field name="cell_coupling_meter_id" readonly="1" invisible="(is_private_transformer == False)"/>
                                </group>
                                <group string="رسوم المحول الخاص" invisible="(is_private_transformer == False)">
                                    <field name="private_transformer_fee" widget="monetary" string="رسوم المحول الخاص لكل دورة"/>
                                </group>
                            </group>
                        </page>

                        <page name="readings" string="القراءات" invisible="(payment_type == 'prepaid')">
                            <separator string="القراءات المرفوعة"/>
                            <field name="uploaded_reading_ids" nolabel="1" readonly="1">
                                <list limit="20" readonly="1" default_order="reading_date desc">
                                    <field name="reading_id"/>
                                    <field name="reading_purpose" widget="badge"/>
                                    <field name="reading_date"/>
                                    <field name="reading_value"/>
                                    <field name="consumption"/>
                                    <field name="state" widget="badge"/>
                                    <field name="date_range_id"/>
                                </list>
                            </field>
                            <separator string="القراءات المفوتـرة"/>
                            <field name="billed_reading_ids" nolabel="1" readonly="1">
                                <list limit="20" readonly="1" default_order="reading_date desc">
                                    <field name="reading_id"/>
                                    <field name="reading_purpose" widget="badge"/>
                                    <field name="reading_date"/>
                                    <field name="reading_value"/>
                                    <field name="consumption"/>
                                    <field name="date_range_id"/>
                                </list>
                            </field>
                        </page>

                        <!-- The location page was here, removed entirely -->
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================== SEARCH VIEW ===================== -->
    <record id="view_utility_customer_search" model="ir.ui.view">
        <field name="name">utility.customer.search</field>
        <field name="model">utility.customer</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_number"/>
                <field name="external_qr_reference" string="معرف QR الخارجي"/>
                <field name="partner_id"/>
                <field name="mobile"/>
                <field name="region_id"/>
                <field name="area_id"/>
                <field name="zone_id"/>
                <field name="route_id"/>
                <field name="meter_id"/>
                <field name="contract_template_id"/>
                
                <filter name="active" string="نشط" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="draft" string="مسودة" domain="[('state','=','draft')]"/>
                <filter name="active_state" string="فعال" domain="[('state','=','active')]"/>
                <filter name="suspended_state" string="موقوف" domain="[('state','=','suspended')]"/>
                <filter name="disconnected_state" string="مفصول" domain="[('state','=','disconnected')]"/>
                <filter name="closed_state" string="مغلق" domain="[('state','=','closed')]"/>
                <filter name="postpaid" string="آجل" domain="[('payment_type','=','postpaid')]"/>
                <filter name="private_transformer" string="محول خاص" domain="[('is_private_transformer','=',True)]"/>
                <filter name="without_meter" string="بدون عداد" domain="[('meter_id','=',False)]"/>
                <filter name="without_route" string="بدون مسار" domain="[('route_id','=',False)]"/>
                <separator/>
                
                <group expand="0" string="تصنيف حسب">
                    <filter name="group_state" string="الحالة" context="{'group_by':'state'}"/>
                    <filter name="group_region" string="المنطقة" context="{'group_by':'region_id'}"/>
                    <filter name="group_area" string="المنطقة الفرعية" context="{'group_by':'area_id'}"/>
                    <filter name="group_route" string="المسار" context="{'group_by':'route_id'}"/>
                    <filter name="group_subscriber" string="نوع المشترك" context="{'group_by':'subscriber_id'}"/>
                    <filter name="group_zone" string="المنطقة التفصيلية" context="{'group_by':'zone_id'}"/>
                    <filter name="group_transformer" string="المحول" context="{'group_by':'transformer_id'}"/>
                    <filter name="group_payment_type" string="نظام الدفع" context="{'group_by':'payment_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== ACTIONS ===================== -->
    <record id="action_utility_customer" model="ir.actions.act_window">
        <field name="name">العملاء</field>
        <field name="res_model">utility.customer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_utility_customer_search"/>
    </record>

    <!-- Action: عرض المشتركين كـ partners في قائمة العملاء -->
    <record id="action_utility_subscriber_partners" model="ir.actions.act_window">
        <field name="name">عملاء المشتركين</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('utility_partner_type', '=', 'subscriber')]</field>
        <field name="context">{'default_utility_partner_type': 'subscriber', 'default_is_subscriber': True, 'default_customer_rank': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                لا يوجد مشتركون مسجّلون بعد
            </p>
        </field>
    </record>
</odoo>
