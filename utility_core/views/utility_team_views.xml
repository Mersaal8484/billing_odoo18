<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_team_tree" model="ir.ui.view">
        <field name="name">utility.team.tree</field>
        <field name="model">utility.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="team_leader_id"/>
                <field name="member_count"/>
                <field name="region_id"/>
                <field name="area_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_utility_team_form" model="ir.ui.view">
        <field name="name">utility.team.form</field>
        <field name="model">utility.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="team_leader_id"/>
                            <field name="member_count"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="region_id" required="1" options="{'no_create': True}"/>
                            <field name="area_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="members" string="Members">
                            <field name="staff_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="employee_code"/>
                                    <field name="role_ids" widget="many2many_tags"/>
                                    <field name="mobile"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_utility_team_search" model="ir.ui.view">
        <field name="name">utility.team.search</field>
        <field name="model">utility.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="اسم الفريق" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code" string="رمز الفريق"/>
                <field name="region_id" string="المنطقة"/>
                <field name="area_id" string="الفرع"/>
                <field name="team_leader_id" string="قائد الفريق"/>
                <field name="staff_ids" string="أعضاء الفريق"/>
                <field name="company_id" string="الشركة" groups="base.group_multi_company"/>
                <separator/>
                <filter name="active" string="الفرق النشطة" domain="[('active','=',True)]"/>
                <filter name="inactive" string="الفرق المؤرشفة" domain="[('active','=',False)]"/>
                <filter name="has_area" string="لها فرع محدد" domain="[('area_id','!=',False)]"/>
                <filter name="no_area" string="بدون فرع محدد" domain="[('area_id','=',False)]"/>
                <filter name="has_leader" string="لها قائد" domain="[('team_leader_id','!=',False)]"/>
                <filter name="no_leader" string="بدون قائد" domain="[('team_leader_id','=',False)]"/>
                <filter name="has_members" string="لها أعضاء" domain="[('member_count','>',0)]"/>
                <filter name="no_members" string="بلا أعضاء" domain="[('member_count','=',0)]"/>
                <separator/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_region" string="المنطقة" context="{'group_by':'region_id'}"/>
                    <filter name="group_area" string="الفرع" context="{'group_by':'area_id'}"/>
                    <filter name="group_leader" string="قائد الفريق" context="{'group_by':'team_leader_id'}"/>
                    <filter name="group_company" string="الشركة" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
                    <filter name="group_active" string="الحالة" context="{'group_by':'active'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_utility_team" model="ir.actions.act_window">
        <field name="name">فرق العمل</field>
        <field name="res_model">utility.team</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_utility_team_search"/>
    </record>
</odoo>
