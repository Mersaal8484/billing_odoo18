<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_customer_meter_assignment_tree" model="ir.ui.view">
        <field name="name">utility.customer.meter.assignment.tree</field>
        <field name="model">utility.customer.meter.assignment</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'open'" decoration-muted="state == 'closed'">
                <field name="customer_id"/><field name="meter_id"/>
                <field name="assignment_type"/><field name="date_from"/><field name="date_to"/>
                <field name="initial_reading"/><field name="final_reading"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_utility_customer_meter_assignment_form" model="ir.ui.view">
        <field name="name">utility.customer.meter.assignment.form</field>
        <field name="model">utility.customer.meter.assignment</field>
        <field name="arch" type="xml">
            <form><sheet>
                <group><group><field name="customer_id"/><field name="meter_id"/><field name="assignment_type"/><field name="state"/></group>
                <group><field name="date_from"/><field name="date_to"/><field name="initial_reading"/><field name="final_reading"/></group></group>
                <group><field name="installed_by_id"/><field name="removed_by_id"/><field name="reason"/></group>
                <field name="notes"/>
            </sheet><chatter/></form>
        </field>
    </record>
    <record id="view_utility_customer_lifecycle_event_tree" model="ir.ui.view">
        <field name="name">utility.customer.lifecycle.event.tree</field>
        <field name="model">utility.customer.lifecycle.event</field>
        <field name="arch" type="xml">
            <list><field name="event_date"/><field name="customer_id"/><field name="event_type"/>
                <field name="old_state" widget="badge"/><field name="new_state" widget="badge"/>
                <field name="reason"/><field name="user_id"/></list>
        </field>
    </record>
    <record id="view_utility_customer_lifecycle_event_form" model="ir.ui.view">
        <field name="name">utility.customer.lifecycle.event.form</field>
        <field name="model">utility.customer.lifecycle.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0"><sheet>
                <group><group><field name="customer_id"/><field name="event_date"/><field name="event_type"/><field name="user_id"/></group>
                <group><field name="old_state"/><field name="new_state"/><field name="reason"/></group></group>
                <group><field name="old_meter_id"/><field name="new_meter_id"/><field name="reference"/></group><field name="notes"/>
            </sheet></form>
        </field>
    </record>
    <record id="action_utility_customer_meter_assignments" model="ir.actions.act_window">
        <field name="name">تخصيصات العدادات</field><field name="res_model">utility.customer.meter.assignment</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_utility_customer_meter_assignments" name="تخصيصات العدادات"
              parent="menu_utility_customer_management" action="action_utility_customer_meter_assignments"
              sequence="30" groups="utility_core.group_utility_supervisor,utility_core.group_utility_admin"/>

    <record id="view_utility_customer_form_lifecycle" model="ir.ui.view">
        <field name="name">utility.customer.form.lifecycle</field>
        <field name="model">utility.customer</field>
        <field name="inherit_id" ref="utility_core.view_utility_customer_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_activate" type="object" string="تفعيل الحساب" class="btn-primary" invisible="(state != 'draft')"/>
                <button name="action_open_lifecycle_wizard" type="object" string="تعليق الحساب" context="{'lifecycle_action': 'suspend'}" invisible="(state != 'active')"/>
                <button name="action_open_lifecycle_wizard" type="object" string="فصل الخدمة" context="{'lifecycle_action': 'disconnect'}" class="btn-danger" invisible="(state != 'active')"/>
                <button name="action_open_lifecycle_wizard" type="object" string="إعادة التفعيل" context="{'lifecycle_action': 'reactivate'}" invisible="(state != 'suspended')"/>
                <button name="action_open_lifecycle_wizard" type="object" string="إعادة التوصيل" context="{'lifecycle_action': 'reconnect'}" invisible="(state != 'disconnected')"/>
                <button name="action_open_lifecycle_wizard" type="object" string="إغلاق الحساب" context="{'lifecycle_action': 'close'}" invisible="(state not in ['active', 'suspended', 'disconnected'])"/>
                <button name="action_open_meter_replacement" type="object" string="استبدال العداد" invisible="(state != 'active')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_meter_assignments" type="object" class="oe_stat_button" icon="fa-tachometer">
                    <field name="meter_assignment_count" string="سجل العدادات" widget="statinfo"/>
                </button>
                <button name="action_view_lifecycle_events" type="object" class="oe_stat_button" icon="fa-history">
                    <field name="lifecycle_event_count" string="دورة الحياة" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='readings']" position="after">
                <page name="meter_history" string="سجل العدادات">
                    <field name="meter_assignment_ids" readonly="1" nolabel="1">
                        <list decoration-success="state == 'open'" decoration-muted="state == 'closed'">
                            <field name="meter_id"/><field name="assignment_type"/><field name="date_from"/><field name="date_to"/>
                            <field name="initial_reading"/><field name="final_reading"/><field name="reason"/><field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
                <page name="lifecycle_history" string="سجل دورة الحياة">
                    <field name="lifecycle_event_ids" readonly="1" nolabel="1">
                        <list default_order="event_date desc">
                            <field name="event_date"/><field name="event_type"/><field name="old_state"/><field name="new_state"/><field name="reason"/><field name="user_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
