<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_contract_template_block_tree" model="ir.ui.view">
        <field name="name">utility.contract.template.block.tree</field>
        <field name="model">utility.contract.template.block</field>
        <field name="arch" type="xml">
            <list>
                <field name="template_id"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="from_kwh"/>
                <field name="to_kwh"/>
                <field name="price_per_kwh"/>
                <field name="from_month"/>
                <field name="to_month"/>
                <field name="time_from"/>
                <field name="time_to"/>
            </list>
        </field>
    </record>

    <record id="view_utility_contract_template_block_form" model="ir.ui.view">
        <field name="name">utility.contract.template.block.form</field>
        <field name="model">utility.contract.template.block</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="template_id"/>
                            <field name="sequence"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="from_kwh"/>
                            <field name="to_kwh"/>
                            <field name="price_per_kwh"/>
                        </group>
                    </group>
                    <group string="موسمية">
                        <group>
                            <field name="from_month"/>
                            <field name="to_month"/>
                        </group>
                        <group>
                            <field name="time_from"/>
                            <field name="time_to"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
