<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_tariff_block_tree" model="ir.ui.view">
        <field name="name">utility.tariff.block.tree</field>
        <field name="model">utility.tariff.block</field>
        <field name="arch" type="xml">
            <list>
                <field name="tariff_id"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="from_kwh"/>
                <field name="to_kwh"/>
                <field name="price_per_kwh"/>
            </list>
        </field>
    </record>
    <record id="view_utility_tariff_block_form" model="ir.ui.view">
        <field name="name">utility.tariff.block.form</field>
        <field name="model">utility.tariff.block</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="tariff_id"/>
                            <field name="sequence"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="from_kwh"/>
                            <field name="to_kwh"/>
                            <field name="price_per_kwh"/>
                        </group>
                    </group>
                    <group string="Seasonal">
                        <group>
                            <field name="from_month"/>
                            <field name="to_month"/>
                        </group>
                        <group>
                            <field name="time_from"/>
                            <field name="time_to"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_utility_tariff_block" model="ir.actions.act_window">
        <field name="name">شرائح التعرفة</field>
        <field name="res_model">utility.tariff.block</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
