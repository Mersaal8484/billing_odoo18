<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_integration_provider_tree" model="ir.ui.view">
        <field name="name">utility.integration.provider.tree</field>
        <field name="model">utility.integration.provider</field>
        <field name="arch" type="xml">
            <list decoration-muted="active == False">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="mode"/>
                <field name="endpoint_url"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_utility_integration_provider_form" model="ir.ui.view">
        <field name="name">utility.integration.provider.form</field>
        <field name="model">utility.integration.provider</field>
        <field name="arch" type="xml">
            <form string="مزود تكامل">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group string="معلومات المزود">
                            <field name="name"/>
                            <field name="provider_type"/>
                            <field name="is_payment_capable" invisible="1"/>
                            <field name="payment_direction" invisible="(is_payment_capable == False)" required="(is_payment_capable == True)"/>
                            <field name="mode"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="إعدادات الاتصال والمصادقة">
                            <field name="endpoint_url" required="(mode == 'http_json')"/>
                            <field name="auth_header_style" invisible="(mode != 'http_json')"/>
                            <field name="api_key_header_name" invisible="((mode != 'http_json') or (auth_header_style != 'api_key_header'))"/>
                            <field name="api_key" password="True" invisible="((mode != 'http_json') or (auth_header_style == 'none'))"/>
                            <field name="webhook_secret" password="True"/>
                            <field name="timeout"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="إعدادات اليوميات الحسابية" invisible="(is_payment_capable == False)">
                            <group>
                                <group string="يوميات التحصيل (وارد)">
                                    <field name="inbound_journal_id" invisible="(payment_direction == 'outbound')"/>
                                </group>
                                <group string="يوميات الصرف / الإرجاع (صادر)">
                                    <field name="outbound_journal_id" invisible="(payment_direction == 'inbound')"/>
                                </group>
                            </group>
                        </page>
                        <page string="Headers إضافية (JSON)" invisible="(mode != 'http_json')">
                            <field name="extra_headers" placeholder='{"X-Custom-Header": "value", "Accept-Language": "ar"}'/>
                        </page>
                    </notebook>
                    <group string="آخر خطأ" invisible="(last_error == False)">
                        <field name="last_error" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_utility_integration_log_tree" model="ir.ui.view">
        <field name="name">utility.integration.log.tree</field>
        <field name="model">utility.integration.log</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'success'" decoration-danger="state == 'failed'">
                <field name="create_date"/>
                <field name="provider_id"/>
                <field name="provider_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="event_type"/>
                <field name="http_status"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_utility_integration_log_form" model="ir.ui.view">
        <field name="name">utility.integration.log.form</field>
        <field name="model">utility.integration.log</field>
        <field name="arch" type="xml">
            <form string="سجل تكامل">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="provider_id"/>
                            <field name="provider_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                            <field name="event_type"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="http_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الطلب">
                            <field name="request_payload" nolabel="1"/>
                        </page>
                        <page string="الاستجابة">
                            <field name="response_payload" nolabel="1"/>
                            <field name="error_message" nolabel="1" invisible="(error_message == False)"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_utility_integration_provider" model="ir.actions.act_window">
        <field name="name">مزودو التكامل</field>
        <field name="res_model">utility.integration.provider</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_utility_integration_log" model="ir.actions.act_window">
        <field name="name">سجل التكاملات</field>
        <field name="res_model">utility.integration.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_utility_integrations" name="التكاملات" parent="utility_core.menu_utility_config" sequence="130" groups="utility_core.group_utility_admin"/>
    <menuitem id="menu_utility_integration_provider" name="مزودو التكامل" parent="menu_utility_integrations" sequence="10" action="action_utility_integration_provider"/>
    <menuitem id="menu_utility_integration_log" name="سجل التكاملات" parent="menu_utility_integrations" sequence="20" action="action_utility_integration_log"/>
</odoo>