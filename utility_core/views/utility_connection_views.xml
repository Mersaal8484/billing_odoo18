<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_connection_tree" model="ir.ui.view">
        <field name="name">utility.connection.tree</field>
        <field name="model">utility.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="account_id"/>
                <field name="connection_type"/>
                <field name="meter_id"/>
                <field name="connection_date"/>
                <field name="status"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_utility_connection_form" model="ir.ui.view">
        <field name="name">utility.connection.form</field>
        <field name="model">utility.connection</field>
        <field name="arch" type="xml">
            <form>
                <field name="available_meter_ids" invisible="1"/>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="account_id"/>
                            <field name="connection_type"/>
                            <field name="meter_id" domain="[('id', 'in', available_meter_ids), ('customer_id', '=', customer_id)]"/>
                            <field name="connection_date"/>
                            <field name="status"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="address"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_utility_connection_search" model="ir.ui.view">
        <field name="name">utility.connection.search</field>
        <field name="model">utility.connection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="connection_type"/>
                <field name="status"/>
                <filter name="active" string="نشط" domain="[('status','=','active')]"/>
                <group expand="0" string="تصنيف حسب">
                    <filter name="group_status" string="الحالة" context="{'group_by':'status'}"/>
                    <filter name="group_type" string="نوع التوصيلة" context="{'group_by':'connection_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_utility_connection" model="ir.actions.act_window">
        <field name="name">التوصيلات</field>
        <field name="res_model">utility.connection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_utility_connection_search"/>
    </record>
</odoo>
