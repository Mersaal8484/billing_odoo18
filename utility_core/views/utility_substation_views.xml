<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_substation_tree" model="ir.ui.view">
        <field name="name">utility.substation.tree</field>
        <field name="model">utility.substation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="voltage_level"/>
                <field name="capacity_kva"/>
                <field name="status"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_utility_substation_form" model="ir.ui.view">
        <field name="name">utility.substation.form</field>
        <field name="model">utility.substation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="status"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="voltage_level"/>
                            <field name="capacity_kva"/>
                            <field name="address"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="feeders" string="Feeders">
                            <field name="feeder_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="voltage_level"/>
                                    <field name="rated_capacity"/>
                                </tree>
                            </field>
                        </page>
                        <page name="transformers" string="Transformers">
                            <field name="transformer_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="capacity"/>
                                    <field name="phase"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_utility_substation_search" model="ir.ui.view">
        <field name="name">utility.substation.search</field>
        <field name="model">utility.substation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="status"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_utility_substation" model="ir.actions.act_window">
        <field name="name">المحطات الفرعية</field>
        <field name="res_model">utility.substation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_utility_substation_search"/>
    </record>
</odoo>
