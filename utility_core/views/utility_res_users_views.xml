<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_users_form_inherit_utility" model="ir.ui.view">
        <field name="name">res.users.form.inherit.utility</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="utility_collection" string="صلاحيات الكهرباء">
                    <field name="has_collection_role" invisible="1"/>
                    <group string="النطاق التنظيمي الجغرافي (Organizational Scope)" col="2">
                        <field name="scope_mode" widget="radio"/>
                        <group>
                            <field name="assigned_region_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="اختر المناطق..." readonly="(scope_mode == 'global')"/>
                            <field name="assigned_branch_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="اختر الفروع..." readonly="(scope_mode == 'global')"/>
                            <field name="assigned_route_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="اختر خطوط السير..."/>
                        </group>
                    </group>
                    <separator string="الأدوار الوظيفية للكهرباء"/>
                    <group>
                        <field name="utility_role_ids" widget="many2many_tags"
                               options="{'no_create': True, 'no_create_edit': True}"
                               placeholder="اختر دورًا أو أكثر..."/>
                        <div class="text-muted">تُطبّق الصلاحيات تلقائيًا حسب الأدوار المختارة.</div>
                    </group>
                    <group invisible="(has_collection_role == False)">
                        <group string="إعدادات التحصيل النقدية">
                            <label for="collection_journal_id"/>
                            <div class="o_row">
                                <field name="collection_journal_id" options="{'no_create': True}"
                                       placeholder="اختر اليومية النقدية" class="oe_inline"/>
                                <button name="action_create_collection_journal"
                                        type="object"
                                        string="إنشاء يومية"
                                        class="btn btn-primary oe_inline"
                                        confirm="سيتم إنشاء يومية نقدية مستقلة وربطها بهذا المستخدم. هل تريد المتابعة؟" invisible="(collection_journal_id != False)"/>
                            </div>
                            <field name="collector_block_code" placeholder="مثال: A, B, C..."/>
                        </group>
                        <group string="بيانات النظام القديم (PEC)">
                            <field name="legacy_user_code" placeholder="معرف النظام السابق"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
