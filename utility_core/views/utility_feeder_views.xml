<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== TREE VIEW ===================== -->
    <record id="view_utility_feeder_tree" model="ir.ui.view">
        <field name="name">utility.feeder.tree</field>
        <field name="model">utility.feeder</field>
        <field name="arch" type="xml">
            <list decoration-muted="active == False">
                <field name="name"/>
                <field name="code"/>
                <field name="feeder_type"/>
                <field name="substation_id" optional="show"/>
                <field name="area_id" optional="show"/>
                <field name="voltage_level" widget="badge" optional="show"/>
                <field name="rated_capacity" optional="show"/>
                <field name="load_percentage" widget="progressbar" optional="show"/>
                <field name="coupling_meter_id" optional="show"/>
                <field name="transformer_count" string="محولات" optional="show"/>
                <field name="supplied_kwh" string="مزوّد (kWh)" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_utility_feeder_form" model="ir.ui.view">
        <field name="name">utility.feeder.form</field>
        <field name="model">utility.feeder</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_meters"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tachometer">
                            <div class="o_stat_info">
                                <span class="o_stat_text">عدادات</span>
                            </div>
                        </button>
                        <button name="action_view_readings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tachometer">
                            <div class="o_stat_info">
                                <span class="o_stat_text">قراءات الربط</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="اسم الفيدر / الخلية"/>
                        <h1><field name="name" placeholder="اسم الفيدر..."/></h1>
                    </div>

                    <!-- المعلومات الأساسية -->
                    <group>
                        <group string="معلومات الشبكة">
                            <field name="code"/>
                            <field name="feeder_type"/>
                            <field name="substation_id" options="{'no_create': True}"/>
                            <field name="area_id" readonly="1"/>
                            <field name="region_id" readonly="1"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="المواصفات الكهربائية">
                            <field name="voltage_level"/>
                            <field name="phase"/>
                            <field name="rated_capacity"/>
                            <field name="current_load"/>
                            <field name="load_percentage" widget="progressbar"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- صفحة 1: العدادات -->
                        <page name="meters" string="العدادات">
                            <group>
                                <group string="عداد الربط الرئيسي">
                                    <field name="coupling_meter_id"
                                           options="{'no_create': True}"
                                           domain="[('feeder_id', '=', id)]"/>
                                </group>
                                <group string="إحصائيات">
                                    <field name="supplied_kwh" readonly="1"/>
                                    <field name="transformer_count" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- صفحة 2: قراءات عداد الربط -->
                        <page name="coupling_readings" string="قراءات الربط">
                            <field name="coupling_reading_ids">
                                <list editable="bottom"
                                      decoration-success="state == 'approved'"
                                      decoration-danger="state == 'error'">
                                    <field name="reading_id" readonly="1"/>
                                    <field name="meter_id"
                                           domain="[('feeder_id', '=', parent.id)]"
                                           options="{'no_create': True}"/>
                                    <field name="reading_date"/>
                                    <field name="reading_value"/>
                                    <field name="previous_reading" readonly="1"/>
                                    <field name="consumption" readonly="1"/>
                                    <field name="date_range_id" options="{'no_create': True}"/>
                                    <field name="image_state" widget="badge" optional="show"/>
                                    <field name="state" widget="badge"/>
                                    <button name="action_submit_review" type="object"
                                            string="إرسال للمراجعة" icon="fa-check" invisible="(state != 'draft')"/>
                                </list>
                            </field>
                        </page>

                        <!-- صفحة 3: قراءات الفيدر -->
                        <page name="feeder_readings" string="قراءات الفيدر">
                            <field name="feeder_reading_ids">
                                <list editable="bottom"
                                      decoration-success="state == 'approved'"
                                      decoration-danger="state == 'error'">
                                    <field name="reading_id" readonly="1"/>
                                    <field name="meter_id"
                                           domain="[('feeder_id', '=', parent.id)]"
                                           options="{'no_create': True}"/>
                                    <field name="reading_date"/>
                                    <field name="reading_value"/>
                                    <field name="previous_reading" readonly="1"/>
                                    <field name="consumption" readonly="1"/>
                                    <field name="date_range_id" options="{'no_create': True}"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <!-- صفحة 4: المحولات -->
                        <page name="transformers" string="المحولات">
                            <field name="transformer_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="capacity"/>
                                    <field name="phase"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>

                        <!-- صفحة 5: ملاحظات -->
                        <page name="notes" string="ملاحظات">
                            <field name="notes" nolabel="1"
                                   placeholder="ملاحظات تقنية عن الفيدر/الخلية..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ===================== SEARCH VIEW ===================== -->
    <record id="view_utility_feeder_search" model="ir.ui.view">
        <field name="name">utility.feeder.search</field>
        <field name="model">utility.feeder</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="substation_id"/>
                <field name="voltage_level"/>
                <field name="feeder_type"/>
                <field name="coupling_meter_id"/>

                <filter name="active" string="نشط" domain="[('active', '=', True)]"/>
                <filter name="type_distribution" string="توزيع" domain="[('feeder_type', '=', 'distribution')]"/>
                <filter name="type_production_area" string="منطقة إنتاج" domain="[('feeder_type', '=', 'production_area')]"/>
                <separator/>
                <filter name="has_coupling" string="لديه عداد ربط"
                        domain="[('coupling_meter_id', '!=', False)]"/>
                <filter name="no_coupling" string="بدون عداد ربط"
                        domain="[('coupling_meter_id', '=', False)]"/>

                <group expand="0" string="تجميع حسب">
                    <filter name="group_substation" string="المحطة"     context="{'group_by': 'substation_id'}"/>
                    <filter name="group_area"     string="الفرع"        context="{'group_by': 'area_id'}"/>
                    <filter name="group_voltage"  string="الجهد"        context="{'group_by': 'voltage_level'}"/>
                    <filter name="group_feeder_type" string="نوع الفيدر" context="{'group_by': 'feeder_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== ACTION ===================== -->
    <record id="action_utility_feeder" model="ir.actions.act_window">
        <field name="name">الفيدرات / الخلايا</field>
        <field name="res_model">utility.feeder</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_utility_feeder_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                إضافة فيدر/خلية جديدة
            </p>
            <p>
                الفيدر (الخلية) هو المستوى الذي يتم عنده رفع قراءات الربط
                لحساب الفاقد الكهربائي.
            </p>
        </field>
    </record>

</odoo>
