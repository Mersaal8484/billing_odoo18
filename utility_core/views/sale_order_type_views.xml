<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- sale.order.type tree view -->
    <record id="view_sale_order_type_tree" model="ir.ui.view">
        <field name="name">sale.order.type.tree</field>
        <field name="model">sale.order.type</field>
        <field name="arch" type="xml">
            <list string="أنواع أوامر البيع">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="journal_id"/>
                <field name="sequence_id"/>
                <field name="picking_policy"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- sale.order.type form view -->
    <record id="view_sale_order_type_form" model="ir.ui.view">
        <field name="name">sale.order.type.form</field>
        <field name="model">sale.order.type</field>
        <field name="arch" type="xml">
            <form string="نوع أمر البيع">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="مثال: مبيعات عدادات مسبقة الدفع..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="إعدادات الفوترة والقيود">
                            <field name="code"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="sequence_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="الشروط وقوائم الأسعار">
                            <field name="warehouse_id" options="{'no_create': True}"/>
                            <field name="picking_policy"/>
                            <field name="payment_term_id" options="{'no_create': True}"/>
                            <field name="pricelist_id" options="{'no_create': True}"/>
                            <field name="incoterm_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="قواعد المطابقة التلقائية" name="matching_rules">
                            <field name="rule_ids">
                                <list string="قواعد المطابقة">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="product_ids" widget="many2many_tags"/>
                                    <field name="product_category_ids" widget="many2many_tags"/>
                                </list>
                                <form string="قاعدة مطابقة">
                                    <group>
                                        <field name="name"/>
                                        <field name="sequence"/>
                                        <field name="product_ids" widget="many2many_tags"/>
                                        <field name="product_category_ids" widget="many2many_tags"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="الوصف">
                            <field name="description" placeholder="ملاحظات توضيحية لنوع أمر البيع..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- sale.order.type search view -->
    <record id="view_sale_order_type_search" model="ir.ui.view">
        <field name="name">sale.order.type.search</field>
        <field name="model">sale.order.type</field>
        <field name="arch" type="xml">
            <search string="البحث في أنواع أوامر البيع">
                <field name="name"/>
                <field name="code"/>
                <field name="journal_id"/>
                <separator/>
                <filter string="مؤرشف" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- sale.order.type action -->
    <record id="action_sale_order_type" model="ir.actions.act_window">
        <field name="name">أنواع أوامر البيع</field>
        <field name="res_model">sale.order.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sale_order_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                إنشاء نوع أمر بيع جديد
            </p>
            <p>
                استخدم أنواع أوامر البيع لتحديد دفاتر اليومية، تسلسلات الإيصالات، سياسات التسليم، وقواعد المطابقة التلقائية حسب المنتجات.
            </p>
        </field>
    </record>

    <menuitem id="menu_sale_order_type" name="أنواع الفواتير والمبيعات"
              parent="utility_core.menu_utility_master_data" sequence="60"
              action="action_sale_order_type"/>
</odoo>
