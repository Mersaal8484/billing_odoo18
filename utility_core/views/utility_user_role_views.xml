<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_user_role_tree" model="ir.ui.view">
        <field name="name">utility.user.role.tree</field>
        <field name="model">utility.user.role</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>
    <record id="view_utility_user_role_form" model="ir.ui.view">
        <field name="name">utility.user.role.form</field>
        <field name="model">utility.user.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                    </group>
                    <group>
                        <field name="group_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_utility_user_role" model="ir.actions.act_window">
        <field name="name">أدوار المستخدمين</field>
        <field name="res_model">utility.user.role</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
