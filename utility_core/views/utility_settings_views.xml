<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_config_settings" model="ir.ui.view">
        <field name="name">إعدادات الكهرباء</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="إدارة الكهرباء" string="إدارة الكهرباء" data-key="utility_core" groups="utility_core.group_utility_admin">
                    <div class="row mt16 mb16 o_settings_container">
                        <div class="col-12 col-lg-12">
                            <div class="alert alert-info d-flex align-items-center justify-content-between mb-0" role="alert">
                                <div>
                                    <h4 class="alert-heading mb-1" role="status"><i class="fa fa-magic me-2"/>تهيئة وتوليد البيانات الناقصة</h4>
                                    <span>اضغط على الزر لفحص وتوليد الحسابات واليوميات والمنتجات وموديلات العدادات الناقصة تلقائياً لقاعدة البيانات.</span>
                                </div>
                                <button name="action_populate_missing_defaults"
                                        string="توليد البيانات الناقصة تلقائياً"
                                        type="object"
                                        class="btn btn-primary ms-3 fw-bold"
                                        icon="fa-magic"/>
                            </div>
                        </div>
                    </div>

                    <h2>عدادات وإعدادات القراءة</h2>
                    <div class="row mt16 o_settings_container" id="utility_meter">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="meter_review_required"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="meter_review_required"/>
                                <div class="text-muted">
                                    مطلوب مراجعة صورة العداد قبل اعتماد القراءة
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="meter_image_mandatory"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="meter_image_mandatory"/>
                                <div class="text-muted">
                                    صورة العداد إلزامية عند تسجيل القراءة
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="meter_reading_validation"/>
                                <div class="text-muted">
                                    طريقة التحقق من صحة قراءة العداد
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="meter_reading_validation" class="o_light_label" widget="radio"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>



                    <h2>إشعارات SMS</h2>
                    <div class="row mt16 o_settings_container" id="utility_sms">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="send_sms_on_invoice"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="send_sms_on_invoice"/>
                                <div class="text-muted">
                                    إرسال رسالة نصية عند إصدار الفاتورة
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="send_sms_on_payment"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="send_sms_on_payment"/>
                                <div class="text-muted">
                                    إرسال رسالة نصية عند استلام الدفعة
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="send_sms_on_overdue"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="send_sms_on_overdue"/>
                                <div class="text-muted">
                                    إرسال رسالة نصية عند تأخر الفاتورة
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    إرسال رسالة نصية عند انخفاض الرصيد
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2>الحسابات المحاسبية وإعدادات الفوترة</h2>
                    <div class="row mt16 o_settings_container" id="utility_accounts">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="sales_journal_id"/>
                                <div class="text-muted">يومية مبيعات الكهرباء (الفواتير)</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="sales_journal_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="electricity_income_account_id"/>
                                <div class="text-muted">حساب إيرادات مبيعات الكهرباء</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="electricity_income_account_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="electricity_product_id"/>
                                <div class="text-muted">منتج طاقة الكهرباء الرئيسي</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="electricity_product_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="discount_product_id"/>
                                <div class="text-muted">منتج الخصم والإعفاءات</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="discount_product_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="penalty_product_id"/>
                                <div class="text-muted">منتج الغرامات</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="penalty_product_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="mu_allim_product_id"/>
                                <div class="text-muted">منتج المعلم</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="mu_allim_product_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="cleaning_product_id"/>
                                <div class="text-muted">منتج النظافة</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="cleaning_product_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="local_fee_product_id"/>
                                <div class="text-muted">منتج رسوم المجالس المحلية</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="local_fee_product_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="private_transformer_fee_product_id"/>
                                <div class="text-muted">منتج رسوم المحول الخاص (يُضاف تلقائياً لكل دورة فوترة لحسابات المحولات الخاصة)</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="private_transformer_fee_product_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="fine_account_id"/>
                                <div class="text-muted">حساب إيرادات الغرامات</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="fine_account_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="discount_account_id"/>
                                <div class="text-muted">حساب الخصومات</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="discount_account_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="deposit_account_id"/>
                                <div class="text-muted">حساب التأمينات</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="deposit_account_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="settlement_account_id"/>
                                <div class="text-muted">حساب التسويات المالية</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="settlement_account_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="writeoff_journal_id"/>
                                <div class="text-muted">يومية الإعفاءات</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="writeoff_journal_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="deposit_journal_id"/>
                                <div class="text-muted">يومية التأمينات والودائع</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="deposit_journal_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="settlement_journal_id"/>
                                <div class="text-muted">يومية التسويات</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="settlement_journal_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="writeoff_account_id"/>
                                <div class="text-muted">حساب الإعفاءات</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="writeoff_account_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="collection_journal_id"/>
                                <div class="text-muted">يومية التحصيل الافتراضية</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="collection_journal_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="opening_journal_id"/>
                                <div class="text-muted">يومية الأرصدة الافتتاحية</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="opening_journal_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="opening_clearing_account_id"/>
                                <div class="text-muted">الحساب المقابل للأرصدة الافتتاحية</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="opening_clearing_account_id" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="legacy_single_phase_meter_model_id"/>
                                <div class="text-muted">الموديل الافتراضي للعدادات القديمة أحادية الطور</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="legacy_single_phase_meter_model_id" domain="[('phase', '=', 'single')]" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="legacy_three_phase_meter_model_id"/>
                                <div class="text-muted">الموديل الافتراضي للعدادات القديمة ثلاثية الطور</div>
                                <div class="content-group">
                                    <div class="mt16"><field name="legacy_three_phase_meter_model_id" domain="[('phase', '=', 'three')]" class="o_light_label"/></div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="media_backend"/>
                                <div class="text-muted">مُحَوِّل تخزين الصور والوسائط الرقمية</div>
                                <div class="content-group mt16">
                                    <field name="media_backend" class="o_light_label"/>
                                </div>
                                <div attrs="{'invisible': [('media_backend', '!=', 'filesystem')]}" class="mt16 border p-2 bg-light rounded">
                                    <label for="filesystem_storage_path" class="o_light_label"/>
                                    <field name="filesystem_storage_path"/>
                                </div>
                                <div attrs="{'invisible': [('media_backend', '!=', 's3')]}" class="mt16 border p-2 bg-light rounded">
                                    <div>
                                        <label for="s3_endpoint_url" class="o_light_label"/>
                                        <field name="s3_endpoint_url"/>
                                    </div>
                                    <div class="mt8">
                                        <label for="s3_bucket_name" class="o_light_label"/>
                                        <field name="s3_bucket_name"/>
                                    </div>
                                    <div class="mt8">
                                        <label for="s3_access_key" class="o_light_label"/>
                                        <field name="s3_access_key"/>
                                    </div>
                                    <div class="mt8">
                                        <label for="s3_secret_key" class="o_light_label"/>
                                        <field name="s3_secret_key"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- إضافة خيار القائمة للإعدادات -->
    <record id="action_utility_config_settings" model="ir.actions.act_window">
        <field name="name">إعدادات ERP الكهرباء</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'utility_core'}</field>
    </record>

    <menuitem id="menu_utility_config_settings"
              name="الإعدادات العامة"
              parent="menu_utility_config"
              sequence="10"
              action="action_utility_config_settings"
              groups="group_utility_admin"/>
</odoo>
