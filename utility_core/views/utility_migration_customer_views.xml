<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_download_migration_template" model="ir.actions.act_url">
        <field name="name">تحميل قالب الرفع</field>
        <field name="url">/utility_core/static/src/Migration_Template.xlsx</field>
        <field name="target">new</field>
    </record>

    <record id="view_utility_migration_customer_tree" model="ir.ui.view">
        <field name="name">utility.migration.customer.tree</field>
        <field name="model">utility.migration.customer</field>
        <field name="arch" type="xml">
            <list string="بيانات التهيئة"
                  decoration-muted="state=='draft'"
                  decoration-info="state=='queued'"
                  decoration-warning="state=='processing'"
                  decoration-success="state=='imported'"
                  decoration-danger="state=='error'">
                <header>
                    <button name="%(action_download_migration_template)d"
                            string="⬇ تحميل القالب"
                            type="action"
                            class="btn-primary"/>
                    <button name="action_queue_migration"
                            string="🚀 مطابقة واستيراد السجلات المحددة"
                            type="object"
                            class="btn-success"/>
                    <button name="action_repair_balance_allocation"
                            string="⚖️ تصحيح توزيع الأرصدة المحددة"
                            type="object"
                            class="btn-warning"
                            confirm="سيتم إنشاء قيود تسوية محاسبية للسجلات المحددة دون حذف القيود الأصلية. هل تريد المتابعة؟"/>
                </header>
                <field name="customer_number"/>
                <field name="subscriber_no"/>
                <field name="name"/>
                <field name="mobile"/>
                <field name="region_id"/>
                <field name="area_id"/>
                <field name="legacy_transformer_code"/>
                <field name="transformer_id"/>
                <field name="route_id"/>
                <field name="is_active"/>
                <field name="current_balance"/>
                <field name="meter_reading"/>
                <field name="current_reading"/>
                <field name="last_reading_date"/>
                <field name="phase"/>
                <field name="last_batch_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-muted="state=='draft'"
                       decoration-info="state=='queued'"
                       decoration-warning="state=='processing'"
                       decoration-success="state=='imported'"
                       decoration-danger="state=='error'"/>
            </list>
        </field>
    </record>

    <record id="view_utility_migration_customer_form" model="ir.ui.view">
        <field name="name">utility.migration.customer.form</field>
        <field name="model">utility.migration.customer</field>
        <field name="arch" type="xml">
            <form string="تهيئة العميل">
                <header>
                    <button name="action_map_codes"
                            string="مطابقة الترميز"
                            type="object"
                            class="btn-secondary" invisible="(state == 'imported')"/>
                    <button name="action_import_data"
                            string="✅ رفع البيانات"
                            type="object"
                            class="oe_highlight" invisible="(state == 'imported')"/>
                    <button name="action_activate_inactive"
                            string="🔄 تفعيل العميل"
                            type="object"
                            class="btn-warning"
                            confirm="سيتم إنشاء حساب مشترك + عداد + رصيد افتتاحي. هل أنت متأكد؟" invisible="((state != 'imported') or ((is_active == True) or (created_customer_id != False)))"/>
                    <button name="action_repair_balance_allocation"
                            string="⚖️ تصحيح توزيع الأرصدة"
                            type="object"
                            class="btn-warning"
                            confirm="سيتم إنشاء قيد تسوية محاسبي دون حذف القيد الأصلي. هل تريد المتابعة؟" invisible="((state != 'imported') or (balance_allocation_repaired == True))"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,processing,imported,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_customer"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user" invisible="(created_customer_id == False)">
                            <div class="o_stat_info">
                                <span class="o_stat_text">حساب المشترك</span>
                            </div>
                        </button>
                        <button name="action_open_meter"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tachometer" invisible="(created_meter_id == False)">
                            <div class="o_stat_info">
                                <span class="o_stat_text">العداد</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" placeholder="اسم المشترك..."/></h1>
                    </div>
                    <group>
                        <group string="البيانات الأساسية">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="customer_number"/>
                            <field name="mobile"/>
                            <field name="national_id"/>
                            <field name="legacy_category"/>
                            <field name="category_id" readonly="True"/>
                            <field name="legacy_subscriber_type"/>
                            <field name="subscriber_type_id" readonly="True"/>
                            <field name="is_active"/>
                            <field name="legacy_contract" invisible="(is_active == False)"/>
                            <field name="contract_template_id" invisible="(is_active == False)" readonly="True"/>
                        </group>
                        <group string="الموقع والعداد">
                            <field name="legacy_region"/>
                            <field name="region_id" readonly="True"/>
                            <field name="legacy_area"/>
                            <field name="area_id" readonly="True"/>
                            <field name="legacy_transformer_code"/>
                            <field name="transformer_id" readonly="True"/>
                            <field name="route_id" readonly="True"/>
                            <field name="meter_number" invisible="(is_active == False)"/>
                            <field name="last_reading" invisible="(is_active == False)"/>
                            <field name="current_reading" invisible="(is_active == False)"/>
                            <field name="last_reading_date" invisible="(is_active == False)"/>
                            <field name="meter_reading" invisible="(is_active == False)"/>
                            <field name="opening_reading" invisible="(is_active == False)"/>
                            <field name="phase"/>
                            <field name="is_private_transformer"/>
                            <field name="last_batch_id" readonly="1"/>
                        </group>
                        <group string="بيانات أخرى">
                            <field name="char_code"/>
                            <field name="subscriber_no"/>
                        </group>
                    </group>
                    <group string="الأرصدة">
                        <group>
                            <field name="current_balance"/>
                            <field name="previous_balance"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="رسالة الخطأ" invisible="(state != 'error')">
                            <field name="error_message" style="color: red;"/>
                        </page>
                        <page string="الارتباطات المنشأة" invisible="(state != 'imported')">
                            <group>
                                <field name="created_partner_id"/>
                                <field name="created_customer_id"/>
                                <field name="created_meter_id"/>
                                <field name="opening_move_id"/>
                                <field name="balance_repair_move_id"/>
                                <field name="balance_allocation_repaired"/>
                                <field name="source_row_number"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_utility_migration_customer_search" model="ir.ui.view">
        <field name="name">utility.migration.customer.search</field>
        <field name="model">utility.migration.customer</field>
        <field name="arch" type="xml">
            <search string="بحث التهيئة">
                <field name="customer_number"/>
                <field name="name"/>
                <field name="mobile"/>
                <field name="national_id"/>
                <field name="legacy_transformer_code"/>
                <field name="transformer_id"/>
                <field name="route_id"/>
                <field name="last_reading_date"/>
                <field name="last_batch_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="العملاء الفعالين"    name="filter_active"   domain="[('is_active', '=', True)]"/>
                <filter string="العملاء غير الفعالين" name="filter_inactive" domain="[('is_active', '=', False)]"/>
                <separator/>
                <filter string="مسودة"   name="filter_draft"    domain="[('state', '=', 'draft')]"/>
                <filter string="في الانتظار" name="filter_queued" domain="[('state', '=', 'queued')]"/>
                <filter string="قيد المعالجة" name="filter_processing" domain="[('state', '=', 'processing')]"/>
                <filter string="تم الرفع" name="filter_imported" domain="[('state', '=', 'imported')]"/>
                <filter string="خطأ"     name="filter_error"    domain="[('state', '=', 'error')]"/>
                <filter string="بانتظار التفعيل" name="filter_pending_activation"
                        domain="[('state', '=', 'imported'), ('is_active', '=', False), ('created_customer_id', '=', False)]"/>
                <group expand="0" string="تجميع حسب...">
                    <filter string="الحالة"  name="group_by_state"  context="{'group_by': 'state'}"/>
                    <filter string="الدفعة الأخيرة" name="group_by_batch" context="{'group_by': 'last_batch_id'}"/>
                    <filter string="المنطقة" name="group_by_region" context="{'group_by': 'region_id'}"/>
                    <filter string="المحول" name="group_by_transformer" context="{'group_by': 'transformer_id'}"/>
                    <filter string="المسار" name="group_by_route" context="{'group_by': 'route_id'}"/>
                    <filter string="هل فعال؟" name="group_by_active" context="{'group_by': 'is_active'}"/>
                    <filter string="الشركة" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_server_activate_inactive_customer" model="ir.actions.server">
        <field name="name">تفعيل العميل غير الفعال</field>
        <field name="model_id" ref="model_utility_migration_customer"/>
        <field name="binding_model_id" ref="model_utility_migration_customer"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_activate_inactive()</field>
    </record>

    <record id="action_utility_migration_customer" model="ir.actions.act_window">
        <field name="name">تهيئة العملاء</field>
        <field name="res_model">utility.migration.customer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_utility_migration_root"
              name="التهيئة والرفع"
              parent="utility_core.menu_utility_root"
              sequence="100"/>

    <menuitem id="menu_utility_migration_customer"
              name="بيانات العملاء (المؤقتة)"
              parent="menu_utility_migration_root"
              action="action_utility_migration_customer"
              sequence="10"/>

    <menuitem id="menu_utility_migration_batch"
              name="دفعات تنفيذ الميجريشن"
              parent="menu_utility_migration_root"
              action="action_utility_migration_batch"
              sequence="15"/>

    <menuitem id="menu_utility_migration_mapping"
              name="جدول الترميز"
              parent="menu_utility_migration_root"
              action="action_utility_migration_mapping"
              sequence="20"/>

    <menuitem id="menu_utility_migration_download_template"
              name="تحميل قالب العملاء"
              parent="menu_utility_migration_root"
              action="action_download_migration_template"
              sequence="30"/>
    <menuitem id="menu_utility_migration_import_wizard"
              name="رفع بيانات الإكسل"
              parent="menu_utility_migration_root"
              action="action_utility_migration_import_wizard"
              sequence="40"/>

</odoo>

