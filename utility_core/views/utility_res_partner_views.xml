<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit res.partner form view to add utility fields -->
    <record id="view_partner_form_inherit_utility_core" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.utility.core</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_utility_customer_registration" type="object"
                        class="oe_stat_button" icon="fa-bolt" invisible="(has_utility_customer == False)">
                    <div class="o_stat_info">
                        <span class="o_stat_text">فتح حساب الكهرباء</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_utility_customer_registration" type="object" 
                            string="تفعيل كمشترك كهرباء" class="oe_highlight" invisible="((utility_partner_type != 'subscriber') or (has_utility_customer == True))"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="has_utility_customer" invisible="1"/>
                <field name="nickname" placeholder="الاسم المختصر..."/>
                <field name="national_id" placeholder="الهوية الوطنية"/>
                <field name="char_code" placeholder="الرمز التعريفي"/>
                <field name="subscriber_no" placeholder="الرقم الجديد"/>
                <field name="utility_partner_type"/>
                <field name="is_subscriber" invisible="1"/>
                <field name="subscriber_status" widget="radio" options="{'horizontal': true}" invisible="(utility_partner_type != 'subscriber')"/>
                <field name="subscriber_active_status" widget="radio" options="{'horizontal': true}" invisible="(utility_partner_type != 'subscriber')"/>
                <field name="subscriber_id" options="{'no_create': True}" invisible="(utility_partner_type != 'subscriber')"/>
                <field name="sector_id" options="{'no_create': True}" invisible="(utility_partner_type != 'subscriber')"/>
                <field name="sale_type" options="{'no_create': True}"/>
            </xpath>

            <notebook position="inside">
                <page name="utility_technical_details" string="البيانات الفنية للكهرباء" invisible="(utility_partner_type != 'subscriber')">
                    <group>
                        <group string="التسلسل الجغرافي للشبكة (NUTS)">
                            <field name="utility_region_id" options="{'no_create': True}"/>
                            <field name="utility_area_id" options="{'no_create': True}"/>
                            <field name="direct_branch_id" options="{'no_create': True}"/>
                            <field name="transformer_zone_id" options="{'no_create': True}"/>
                            <field name="residential_compound_id" options="{'no_create': True}"/>
                            <field name="region_id" options="{'no_create': True}"/>
                            <field name="area_id" options="{'no_create': True}"/>
                            <field name="zone_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="بيانات العداد والافتتاح">
                            <field name="meter_number"/>
                            <field name="meter_reading"/>
                            <field name="opening_reading"/>
                            <field name="consumption_difference"/>
                            <field name="register_number"/>
                            <field name="open_balance"/>
                            <field name="is_credit_raised"/>
                            <field name="pec_credit" invisible="(is_credit_raised == False)"/>
                            <field name="credit_raise_date" invisible="(is_credit_raised == False)"/>
                        </group>
                        <group string="السجل المالي والمحاسبي">
                            <field name="last_payment"/>
                            <field name="last_payment_date"/>
                            <field name="last_invoice"/>
                            <field name="last_invoice_date"/>

                            <field name="payment_token_ids" invisible="1"/>
                            <field name="payment_token_id" options="{'no_create': True}"/>
                        </group>
                    </group>

                </page>
            </notebook>
        </field>
    </record>

    <!-- Inherit res.partner tree view to add utility fields -->
    <record id="view_partner_tree_inherit_utility_core" model="ir.ui.view">
        <field name="name">res.partner.tree.inherit.utility.core</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='country_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='email']" position="after">
                <field name="region_id" optional="show"/>
                <field name="area_id" optional="show"/>
                <field name="meter_number" optional="show"/>
                <field name="subscriber_status" optional="show"/>
                <field name="subscriber_active_status" optional="show"/>
                <field name="open_balance" optional="show" sum="Total Open Balance"/>
                <field name="utility_postpaid_balance" optional="show" sum="Total Balance"/>
                <field name="pec_credit" optional="show" sum="Total PEC Credit"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit res.partner search view to add utility filters -->
    <record id="view_res_partner_filter_inherit_utility" model="ir.ui.view">
        <field name="name">res.partner.search.inherit.utility</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="utility_partner_type"/>
                <field name="subscriber_status"/>
                <field name="subscriber_active_status"/>
                <field name="meter_number"/>
                <field name="subscriber_no"/>
            </xpath>
            <xpath expr="//filter[@name='type_person']" position="after">
                <separator/>
                <filter string="مشترك كهرباء" name="filter_is_subscriber" domain="[('utility_partner_type', '=', 'subscriber')]"/>
                <filter string="موظف / مستخدم" name="filter_utility_employee" domain="[('utility_partner_type', '=', 'employee')]"/>
                <filter string="جهة مانحة" name="filter_utility_donor" domain="[('utility_partner_type', '=', 'donor')]"/>
                <filter string="جهة مدعومة" name="filter_utility_supported_entity" domain="[('utility_partner_type', '=', 'supported_entity')]"/>
                <filter string="مشترك جديد" name="filter_subscriber_new" domain="[('subscriber_status', '=', 'new')]"/>
                <filter string="مشترك قديم" name="filter_subscriber_old" domain="[('subscriber_status', '=', 'old')]"/>
                <separator/>
                <filter string="فعال" name="filter_subscriber_active" domain="[('subscriber_active_status', '=', 'active')]"/>
                <filter string="غير مفعل" name="filter_subscriber_inactive" domain="[('subscriber_active_status', '=', 'inactive')]"/>
            </xpath>
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter string="نوع الاشتراك" name="group_by_subscriber_status" context="{'group_by': 'subscriber_status'}"/>
                <filter string="حالة التفعيل" name="group_by_active_status" context="{'group_by': 'subscriber_active_status'}"/>
                <filter string="تصنيف الشريك" name="group_by_utility_partner_type" context="{'group_by': 'utility_partner_type'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_server_open_utility_customer_registration" model="ir.actions.server">
        <field name="name">إنشاء/فتح حساب كهرباء</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
if len(records) != 1:
    action = {
        'type': 'ir.actions.client',
        'tag': 'display_notification',
        'params': {
            'title': 'Warning',
            'message': 'Please select one partner only.',
            'type': 'warning',
            'sticky': False,
        },
    }
else:
    action = records.action_open_utility_customer_registration()
        ]]></field>
    </record>

    <!-- Inherit ir.attachment form view to add custom storage path and URL -->
    <record id="view_attachment_form_inherit_utility" model="ir.ui.view">
        <field name="name">ir.attachment.form.inherit.utility</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mimetype']" position="after">
                <field name="custom_storage_path" readonly="1" groups="base.group_no_one"/>
                <field name="invoice_attachment_url" readonly="1" widget="url" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>
</odoo>
