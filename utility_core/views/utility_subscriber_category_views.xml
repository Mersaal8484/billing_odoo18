<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== SUBSCRIBER CATEGORY VIEWS ===================== -->
    <record id="view_utility_subscriber_category_tree" model="ir.ui.view">
        <field name="name">utility.subscriber.category.tree</field>
        <field name="model">utility.subscriber.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_utility_subscriber_category_form" model="ir.ui.view">
        <field name="name">utility.subscriber.category.form</field>
        <field name="model">utility.subscriber.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="اسم الفئة"/>
                        <h1>
                            <field name="name" placeholder="مثال: سكني، تجاري..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="التهيئة الأساسية">
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>

                    </group>

                    <notebook>
                        <page string="الوصف">
                            <field name="description" placeholder="اكتب وصفاً للفئة هنا..."/>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_utility_subscriber_category" model="ir.actions.act_window">
        <field name="name">فئات المشتركين</field>
        <field name="res_model">utility.subscriber.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_utility_subscriber_category" name="فئات المشتركين الرئيسية" parent="utility_core.menu_utility_master_data" action="action_utility_subscriber_category" sequence="10"/>

    <!-- ===================== FORMULA VIEWS ===================== -->
    <record id="view_utility_formula_tree" model="ir.ui.view">
        <field name="name">utility.formula.tree</field>
        <field name="model">utility.formula</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active" decoration-muted="not active"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_utility_formula_form" model="ir.ui.view">
        <field name="name">utility.formula.form</field>
        <field name="model">utility.formula</field>
        <field name="arch" type="xml">
            <form string="معادلة الاحتساب">
                <header>
                    <button name="action_test_formula" type="object" string="تشغيل واختبار المعادلة" class="oe_highlight" icon="fa-cogs"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contract_lines" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="(contract_line_count == 0)">
                            <field name="contract_line_count" widget="statinfo" string="بنود العقود"/>
                        </button>
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'active'}"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="مؤرشف" bg_color="bg-danger" invisible="(active == True)"/>
                    <div class="oe_title">
                        <label for="name" string="اسم المعادلة" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="مثال: معادلة احتساب الاستهلاك الشهري..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2">
                                <i class="fa fa-code"/> يتم كتابة الكود بلغة Python ويتم تنفيذه ديناميكياً عند احتساب الفواتير.
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="كود الاحتساب (Python)" icon="fa-code">
                            <div class="alert alert-info oe_edit_only" role="alert" style="margin-bottom: 10px;">
                                <i class="fa fa-lightbulb-o"/> اكتب كود Python لحساب قيمة <code>result</code>. يمكنك الضغط على "تشغيل واختبار المعادلة" في الأعلى لتجربة الحساب.
                            </div>
                            <field name="code" widget="ace" options="{'mode': 'python', 'theme': 'monokai', 'fontSize': 14}" nolabel="1" placeholder="# مثال:\n# خصم 20% من الاستهلاك الأول 100 كيلوواط\nif consumption &lt;= 100:\n    result = consumption * 0.20\nelse:\n    result = 20 + (consumption - 100) * 0.15\nname = 'خصم استهلاك'"/>
                        </page>
                        <page string="دليل المتغيرات المتاحة" icon="fa-book">
                            <div class="alert alert-warning" role="alert" style="margin-bottom: 15px;">
                                <i class="fa fa-info-circle"/> المتغيرات التالية يتم تمريرها تلقائياً أثناء فوترة المشترك. يجب أن ينتهي الكود بتعيين المتغير <code>result</code>.
                            </div>
                            <group string="متغيرات الإدخال (Input Variables)">
                                <group>
                                    <div class="o_row" title="كمية الاستهلاك الفعلي بالكيلوواط">
                                        <span class="badge badge-pill badge-primary" style="font-size: 14px;"><code>consumption</code></span>
                                        <span class="text-muted ml-2"> — (float) الاستهلاك الفعلي (kWh)</span>
                                    </div>
                                    <div class="o_row" title="قراءة العداد السابقة">
                                        <span class="badge badge-pill badge-info" style="font-size: 14px;"><code>previous_reading</code></span>
                                        <span class="text-muted ml-2"> — (float) القراءة السابقة للعداد</span>
                                    </div>
                                    <div class="o_row" title="قراءة العداد الحالية">
                                        <span class="badge badge-pill badge-info" style="font-size: 14px;"><code>current_reading</code></span>
                                        <span class="text-muted ml-2"> — (float) القراءة الحالية للعداد</span>
                                    </div>

                                </group>
                                <group>
                                    <div class="o_row" title="كائن حساب المشترك">
                                        <span class="badge badge-pill badge-secondary" style="font-size: 14px;"><code>account</code></span>
                                        <span class="text-muted ml-2"> — (record) حساب المشترك (utility.customer)</span>
                                    </div>
                                    <div class="o_row" title="كائن فئة المشترك">
                                        <span class="badge badge-pill badge-secondary" style="font-size: 14px;"><code>category</code></span>
                                        <span class="text-muted ml-2"> — (record) فئة المشترك (utility.subscriber.category)</span>
                                    </div>
                                    <div class="o_row" title="كائن بند العقد الحالي">
                                        <span class="badge badge-pill badge-secondary" style="font-size: 14px;"><code>line</code></span>
                                        <span class="text-muted ml-2"> — (record) بند نموذج العقد الحالي</span>
                                    </div>
                                </group>
                            </group>
                            <group string="متغيرات الإخراج (Output Variables)">
                                <div class="o_row" title="القيمة النهائية المحسوبة">
                                    <span class="badge badge-pill badge-success" style="font-size: 14px;"><code>result</code></span>
                                    <span class="text-muted ml-2"> — (float) <strong>إلزامي: القيمة النهائية التي يتم احتساب البند بناءً عليها</strong></span>
                                </div>
                                <div class="o_row" title="الاسم المخصص للبند">
                                    <span class="badge badge-pill badge-warning" style="font-size: 14px;"><code>name</code></span>
                                    <span class="text-muted ml-2"> — (str) اختياري: لتعديل اسم البند في الفاتورة ديناميكياً</span>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_utility_formula" model="ir.actions.act_window">
        <field name="name">معادلات الاحتساب</field>
        <field name="res_model">utility.formula</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_utility_formula" name="المعادلات وصيغ الاحتساب" parent="utility_core.menu_utility_master_data" action="action_utility_formula" sequence="40"/>
</odoo>
