<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_office_tree" model="ir.ui.view">
        <field name="name">utility.office.tree</field>
        <field name="model">utility.office</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="area_id"/>
                <field name="phone"/>
                <field name="manager_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_utility_office_form" model="ir.ui.view">
        <field name="name">utility.office.form</field>
        <field name="model">utility.office</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="area_id"/>
                            <field name="region_id"/>
                            <field name="manager_id"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="address"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_utility_office_search" model="ir.ui.view">
        <field name="name">utility.office.search</field>
        <field name="model">utility.office</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="area_id"/>
                <field name="manager_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_area" string="Area" context="{'group_by':'area_id'}"/>
                    <filter name="group_region" string="Region" context="{'group_by':'region_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_utility_office" model="ir.actions.act_window">
        <field name="name">المكاتب</field>
        <field name="res_model">utility.office</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_utility_office_search"/>
    </record>
</odoo>
