<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_contract_template_tree" model="ir.ui.view">
        <field name="name">utility.contract.template.tree</field>
        <field name="model">utility.contract.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="recurring_rule_type"/>
                <field name="recurring_invoicing_type"/>
                <field name="recurring_interval"/>

                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_utility_contract_template_search" model="ir.ui.view">
        <field name="name">utility.contract.template.search</field>
        <field name="model">utility.contract.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="subscriber_category_ids"/>
                <field name="subscriber_ids"/>
                <field name="region_ids"/>
                <field name="area_ids"/>
                <field name="recurring_rule_type"/>
                <field name="pricing_mode"/>
                <field name="scope"/>
                <field name="sponsor_id" domain="[('utility_partner_type', '=', 'donor')]"/>
                <field name="effective_date"/>
                <field name="end_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="active" string="نشط" domain="[('active', '=', True)]"/>
                <filter name="archived" string="مؤرشف" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="monthly" string="شهري" domain="[('recurring_rule_type', '=', 'monthly')]"/>
                <filter name="semi_monthly" string="نصف شهري" domain="[('recurring_rule_type', '=', 'semi_monthly')]"/>
                <filter name="quarterly" string="ربع سنوي" domain="[('recurring_rule_type', '=', 'quarterly')]"/>
                <filter name="yearly" string="سنوي" domain="[('recurring_rule_type', '=', 'yearly')]"/>
                <separator/>
                <filter name="pricing_flat" string="سعر موحّد" domain="[('pricing_mode', '=', 'flat')]"/>
                <filter name="pricing_tier" string="شريحة واحدة" domain="[('pricing_mode', '=', 'tier')]"/>
                <filter name="pricing_block" string="شرائح تصاعدية" domain="[('pricing_mode', '=', 'block')]"/>
                <separator/>
                <filter name="currently_effective" string="ساري حاليًا" domain="[('is_active', '=', True)]"/>
                <filter name="not_currently_effective" string="خارج السريان" domain="[('is_active', '=', False)]"/>
                <filter name="restricted" string="نطاق جغرافي مخصص" domain="[('scope', '=', 'restricted')]"/>
                <filter name="global" string="نطاق عام" domain="[('scope', '=', 'global')]"/>
                <filter name="sponsored" string="يتضمن دعمًا" domain="[('sponsor_id', '!=', False)]"/>
                <filter name="postpaid" string="آجل" domain="[('recurring_invoicing_type', '=', 'postpaid')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_cadence" string="دورية الفوترة" context="{'group_by': 'recurring_rule_type'}"/>
                    <filter name="group_pricing" string="نمط التسعير" context="{'group_by': 'pricing_mode'}"/>
                    <filter name="group_scope" string="النطاق الجغرافي" context="{'group_by': 'scope'}"/>
                    <filter name="group_sponsor" string="الجهة الداعمة" context="{'group_by': 'sponsor_id'}"/>
                    <filter name="group_effective" string="تاريخ السريان" context="{'group_by': 'effective_date:month'}"/>
                    <filter name="group_invoicing" string="نوع الفوترة" context="{'group_by': 'recurring_invoicing_type'}"/>
                    <filter name="group_company" string="الشركة" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_utility_contract_template_form" model="ir.ui.view">
        <field name="name">utility.contract.template.form</field>
        <field name="model">utility.contract.template</field>
        <field name="arch" type="xml">
            <form string="قالب العقد">
                <header>
                    <button name="action_open_clone_wizard" type="object" string="استنساخ كقالب جديد" class="btn-secondary" icon="fa-clone"/>
                    <button name="action_sync_lines_with_template" type="object" string="إضافة / مزامنة بنود القالب" class="oe_highlight" icon="fa-plus"/>
                    <button name="action_create_biweekly_blocks" type="object" string="توليد شرائح نموذجية (نصف شهري)" class="btn-secondary" icon="fa-list-ol" attrs="{'invisible': [('pricing_mode', 'not in', ['tier', 'block'])]}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_versions" class="oe_stat_button" icon="fa-history" attrs="{'invisible': [('version_count', '=', 0)]}">
                            <field name="version_count" widget="statinfo" string="الإصدارات"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="اسم القالب"/>
                        <h1>
                            <field name="name" placeholder="مثال: عقد سكني دوري..."/>
                        </h1>
                        <h4>
                            <field name="current_version_id" readonly="1" options="{'no_open': False}"/>
                        </h4>
                    </div>
                    <group>
                        <group string="التهيئة الأساسية">
                            <field name="code"/>
                            <field name="subscriber_category_ids" widget="many2many_tags" placeholder="فئات المشتركين الرئيسية..." required="1"/>
                            <field name="subscriber_ids" widget="many2many_tags" placeholder="انواع المشتركين..." required="1" domain="[('category_id', 'in', subscriber_category_ids)]"/>
                            <field name="scope" widget="radio" options="{'horizontal': true}"/>
                            <field name="region_ids" widget="many2many_tags" placeholder="اختر المناطق الرئيسية المسموح بها..." domain="[('type', '=', 'region'), ('recurring_rule_type', '=', recurring_rule_type)]" attrs="{'invisible': [('scope', '!=', 'restricted')], 'required': [('scope', '=', 'restricted')]}"/>
                            <field name="area_ids" widget="many2many_tags" placeholder="اختر المناطق الفرعية المسموح بها..." domain="[('type', '=', 'area'), ('parent_id', 'in', region_ids), ('recurring_rule_type', '=', recurring_rule_type)]" attrs="{'invisible': [('scope', '!=', 'restricted')], 'required': [('scope', '=', 'restricted')]}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="قواعد التكرار">
                            <field name="recurring_rule_type"/>
                            <field name="recurring_invoicing_type"/>
                            <field name="recurring_interval"/>
                        </group>
                    </group>
                    <group string="الإعدادات الافتراضية وسير العمل">
                        <group>
                            <field name="pricelist_id" invisible="1"/>
                            <field name="journal_id"/>

                        </group>
                        <group>
                            <field name="sale_autoconfirm"/>
                            <field name="create_invoice_automatically"/>
                            <field name="validate_invoice_automatically"/>
                        </group>
                    </group>
                    <group string="الدفع التلقائي">
                        <field name="is_auto_pay"/>
                        <field name="auto_pay_retries" attrs="{'invisible': [('is_auto_pay', '=', False)]}"/>
                        <field name="auto_pay_retry_hours" attrs="{'invisible': [('is_auto_pay', '=', False)]}"/>
                    </group>
                    <notebook>
                        <page string="التسعير">
                            <group>
                                <group string="نمط التسعير والصلاحية">
                                    <field name="pricing_mode"/>
                                    <field name="effective_date"/>
                                    <field name="end_date"/>
                                    <field name="is_active" readonly="1"/>
                                </group>
                                <group string="الأسعار الأساسية">
                                    <field name="price_per_kwh"/>
                                    <field name="service_charge"/>
                                </group>
                            </group>
                            <group>
                                <group string="حدود الفوترة">
                                    <field name="min_charge"/>
                                    <field name="max_charge"/>
                                </group>
                                <group string="الرسوم المحلية (محسوبة × الاستهلاك)">
                                    <field name="local_fee_per_kwh"/>
                                    <field name="local_fee_mu_allim"/>
                                    <field name="local_fee_cleaning"/>
                                </group>
                            </group>
                            <group string="خصم الدعم">
                                <field name="subsidy_enabled" widget="boolean_toggle"/>
                            </group>
                            <group string="إعدادات خصم الدعم" attrs="{'invisible': [('subsidy_enabled', '=', False)]}">
                                <field name="sponsor_id" domain="[('utility_partner_type', '=', 'donor')]" invisible="1"/>
                                <field name="discount_formula_id"/>
                            </group>
                        </page>
                        <page string="شرائح التسعير"
                               attrs="{'invisible': [('pricing_mode', 'not in', ['block', 'tier', 'seasonal', 'tou'])]}">
                            <field name="block_ids" context="{'default_is_discount': False}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="from_kwh"/>
                                    <field name="to_kwh"/>
                                    <field name="price_per_kwh"/>
                                    <field name="from_month" optional="hide"/>
                                    <field name="to_month" optional="hide"/>
                                    <field name="time_from" optional="hide"/>
                                    <field name="time_to" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="شرائح الخصم التدريجية" attrs="{'invisible': ['|', ('subsidy_enabled', '=', False), ('discount_formula_id', '=', False)]}">
                            <field name="discount_block_ids" context="{'default_is_discount': True}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="is_discount" invisible="1"/>
                                    <field name="name"/>
                                    <field name="from_kwh"/>
                                    <field name="to_kwh"/>
                                    <field name="price_per_kwh" string="قيمة الخصم لكل kWh"/>
                                    <field name="from_month" optional="hide"/>
                                    <field name="to_month" optional="hide"/>
                                    <field name="time_from" optional="hide"/>
                                    <field name="time_to" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="سجل تغييرات التسعير">
                            <field name="history_ids" readonly="1">
                                <tree decoration-muted="1">
                                    <field name="change_date"/>
                                    <field name="old_price"/>
                                    <field name="new_price"/>
                                    <field name="old_service_charge"/>
                                    <field name="new_service_charge"/>
                                    <field name="reason"/>
                                    <field name="changed_by"/>
                                </tree>
                            </field>
                        </page>
                        <page string="بنود العقد">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_type"/>
                                    <field name="specific_price"/>
                                    <field name="meter_line_type"/>
                                    <field name="qty_formula_id"/>
                                    <field name="is_subsidized"
                                           attrs="{'column_invisible': [('meter_line_type', '!=', 'discount')]}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group string="تتبع الاستنساخ" attrs="{'invisible': [('cloned_from_template_id', '=', False)]}">
                        <group>
                            <field name="cloned_from_template_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="cloned_at" readonly="1"/>
                            <field name="cloned_by" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_server_sync_template_lines" model="ir.actions.server">
        <field name="name">توليد / تحديث بنود التسعيرة</field>
        <field name="model_id" ref="utility_core.model_utility_contract_template"/>
        <field name="binding_model_id" ref="utility_core.model_utility_contract_template"/>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_sync_lines_with_template()
        </field>
    </record>

    <record id="action_utility_contract_template" model="ir.actions.act_window">
        <field name="name">قوالب العقود</field>
        <field name="res_model">utility.contract.template</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_utility_contract_template_search"/>
    </record>

    <menuitem id="menu_utility_contract_template" name="قوالب العقود" parent="utility_core.menu_utility_customer_management" action="action_utility_contract_template" sequence="50"/>
</odoo>
