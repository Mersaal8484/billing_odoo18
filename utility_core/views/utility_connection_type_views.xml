<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_connection_type_tree" model="ir.ui.view">
        <field name="name">utility.connection.type.tree</field>
        <field name="model">utility.connection.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="voltage_level"/>
                <field name="phase"/>
            </list>
        </field>
    </record>
    <record id="view_utility_connection_type_form" model="ir.ui.view">
        <field name="name">utility.connection.type.form</field>
        <field name="model">utility.connection.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="voltage_level"/>
                            <field name="phase"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_utility_connection_type" model="ir.actions.act_window">
        <field name="name">أنواع التوصيلات</field>
        <field name="res_model">utility.connection.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
