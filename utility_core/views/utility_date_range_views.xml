<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         DATE RANGE TYPE — Views
         ===================================================================== -->

    <!-- Tree View: أنواع الفترات -->
    <record id="view_utility_date_range_type_tree" model="ir.ui.view">
        <field name="name">date.range.type.utility.tree</field>
        <field name="model">date.range.type</field>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="parent_type_id" optional="show"/>
                <field name="default_billing_period" optional="show"/>
                <field name="reading_start_offset_days" optional="show"/>
                <field name="reading_end_offset_days" optional="show"/>
                <field name="payment_start_offset_days" optional="show"/>
                <field name="payment_end_offset_days" optional="show"/>
                <field name="fiscal_year" widget="boolean_toggle"/>
                <field name="allow_overlap" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View: نوع الفترة -->
    <record id="view_utility_date_range_type_form" model="ir.ui.view">
        <field name="name">date.range.type.utility.form</field>
        <field name="model">date.range.type</field>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="معلومات النوع">
                            <field name="name"/>
                            <field name="parent_type_id" options="{'no_create': True}"/>
                            <field name="default_billing_period"/>
                        </group>
                        <group string="الإعدادات العامة">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="fiscal_year"/>
                            <field name="allow_overlap"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="إعدادات الإزاحة الافتراضية للنوافذ التشغيلية (بالأيام بالنسبة لنهاية الاستهلاك)">
                        <group>
                            <field name="reading_start_offset_days"/>
                            <field name="reading_end_offset_days"/>
                        </group>
                        <group>
                            <field name="payment_start_offset_days"/>
                            <field name="payment_end_offset_days"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search: أنواع الفترات -->
    <record id="view_utility_date_range_type_search" model="ir.ui.view">
        <field name="name">date.range.type.utility.search</field>
        <field name="model">date.range.type</field>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="السنوات المالية" name="fiscal" domain="[('fiscal_year', '=', True)]"/>
                <separator/>
                <filter string="مؤرشف" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- =====================================================================
         DATE RANGE — Views (Redesigned & Simplified)
         ===================================================================== -->

    <!-- Tree View: الدورات الموحدة -->
    <record id="view_utility_date_range_tree" model="ir.ui.view">
        <field name="name">date.range.utility.tree</field>
        <field name="model">date.range</field>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <tree decoration-success="reading_state == 'open' and collection_state == 'open'"
                  decoration-info="reading_state == 'closing' or collection_state == 'closing'"
                  decoration-warning="reading_state == 'closed'"
                  decoration-muted="state == 'locked'">
                <field name="period_code"/>
                <field name="name"/>
                <field name="billing_cadence" widget="badge"
                       decoration-success="billing_cadence == 'monthly'"
                       decoration-primary="billing_cadence == 'semi_monthly'"/>
                <!-- تواريخ القراءة -->
                <field name="date_start" string="من القراءة"/>
                <field name="date_end" string="إلى القراءة"/>
                <!-- نطاق الدفع -->
                <field name="payment_start" string="من الدفع" optional="show"/>
                <field name="payment_end" string="إلى الدفع" optional="show"/>
                <!-- الحالات المستقلة -->
                <field name="reading_state" widget="badge"
                       decoration-success="reading_state == 'open'"
                       decoration-info="reading_state == 'closing'"
                       decoration-warning="reading_state == 'closed'"
                       decoration-muted="reading_state == 'locked'"
                       string="حالة القراءة"/>
                <field name="collection_state" widget="badge"
                       decoration-success="collection_state == 'open'"
                       decoration-info="collection_state == 'closing'"
                       decoration-secondary="collection_state == 'reconciled'"
                       decoration-muted="collection_state == 'locked'"
                       string="حالة التحصيل"/>
                <!-- الإحصائيات -->
                <field name="received_readings" string="القراءات" optional="show"/>
                <field name="bills_generated" string="الفواتير" optional="show"/>
                <field name="collection_rate" string="نسبة التحصيل %" widget="progressbar" optional="show"/>
                <!-- حقول التوافق العكسي -->
                <field name="period_role" optional="hide"/>
                <field name="state" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View: الفترة الزمنية المتطورة -->
    <record id="view_utility_date_range_form" model="ir.ui.view">
        <field name="name">date.range.utility.form</field>
        <field name="model">date.range</field>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- === الدورة الموحدة: أزرار القراءة === -->
                    <button name="action_open_period" type="object" string="فتح الدورة للعمليات" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'planned')]}"/>

                    <!-- أزرار القراءة -->
                    <button name="action_start_closing" type="object" string="بدء إغلاق القراءة" class="btn-warning"
                            attrs="{'invisible': ['|', ('period_role', '!=', 'reading'), ('reading_state', 'not in', ('open',))]}"/>
                    <button name="action_close_reading" type="object" string="إغلاق القراءة" class="btn-danger"
                            confirm="هل أنت متأكد من إغلاق القراءة؟ التحصيل سيبقى مفتوحاً."
                            attrs="{'invisible': ['|', ('period_role', '!=', 'reading'), ('reading_state', 'not in', ('open', 'closing'))]}"/>
                    <button name="action_open_reading" type="object" string="إعادة فتح القراءة" class="btn-outline-warning"
                            attrs="{'invisible': ['|', ('period_role', '!=', 'reading'), ('reading_state', 'not in', ('closing', 'closed'))]}"/>

                    <!-- أزرار التحصيل -->
                    <button name="action_reconcile_collection" type="object" string="مطابقة التحصيل" class="btn-success"
                            attrs="{'invisible': ['|', ('period_role', '!=', 'reading'), ('collection_state', 'not in', ('open', 'closing'))]}"/>
                    <button name="action_open_payment" type="object" string="إعادة فتح التحصيل" class="btn-outline-success"
                            attrs="{'invisible': ['|', ('period_role', '!=', 'reading'), ('collection_state', 'not in', ('closing', 'reconciled'))]}"/>

                    <!-- التوافق العكسي: أزرار فترات payment التاريخية -->
                    <button name="action_reconcile_payment" type="object" string="مطابقة التحصيل (تاريخي)" class="btn-success"
                            attrs="{'invisible': ['|', ('period_role', '!=', 'payment'), ('state', 'not in', ('open', 'closing', 'closed'))]}"/>
                    <button name="action_close_payment" type="object" string="إغلاق التحصيل (تاريخي)" class="btn-danger"
                            attrs="{'invisible': ['|', ('period_role', '!=', 'payment'), ('state', 'not in', ('open',))]}"/>

                    <!-- إقفال تاريخي ومعالج التعديل -->
                    <button name="action_lock_period" type="object" string="إقفال تاريخي" class="btn-outline-dark"
                            attrs="{'invisible': [('state', 'not in', ('closed', 'reconciled'))]}"/>
                    <button name="%(action_utility_period_adjust_wizard)d" type="action"
                            string="تعديل / تمديد الفترة" class="btn-secondary"
                            context="{'default_period_id': active_id}"
                            attrs="{'invisible': [('state', '=', 'locked')]}"/>
                    <button name="action_sync_regions_by_cadence" type="object"
                            string="مزامنة المناطق حسب الدورية"
                            class="btn-outline-info"
                            icon="fa-refresh"
                            attrs="{'invisible': [('state', '!=', 'planned')]}"
                            confirm="سيتم تحديث المناطق المشتركة في هذه الفترة بناءً على دوريتها. هل تريد المتابعة؟"/>

                    <!-- شريط الحالة: دورة موحدة (reading) -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,open,closing,closed,locked"
                           attrs="{'invisible': [('period_role', '!=', 'reading')]}"/>
                    <!-- شريط الحالة: فترة تحصيل تاريخية (payment) -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,open,closing,reconciled,locked"
                           attrs="{'invisible': [('period_role', '=', 'reading')]}"/>
                </header>

                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-tachometer">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="received_readings"/></span>
                                <span class="o_stat_text">قراءة مستلمة</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="bills_generated"/></span>
                                <span class="o_stat_text">فاتورة منشأة</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-money">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="billed_amount"/></span>
                                <span class="o_stat_text">إجمالي المطلوب</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-check-circle text-success">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="collected_in_window"/></span>
                                <span class="o_stat_text">تم تحصيله</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="period_code" string="رمز الفترة الفريد"/>
                        <h1><field name="period_code" placeholder="مثال: READ-SEMI-2026-08-H1"/></h1>
                        <label for="name" string="اسم الفترة الوصفي"/>
                        <h2><field name="name" placeholder="مثال: النصف الأول أغسطس 2026 (قراءة ومراجعة)"/></h2>
                    </div>

                    <!-- 2-Column Card Layout -->
                    <div class="row">
                        <div class="col-12 col-lg-6">
                            <div class="card o_settings_card mb-3">
                                <div class="card-header">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-tag fa-2x text-primary me-3" title="الدورة والنوع"/>
                                        <div>
                                            <h4 class="mb-0">نوع والدورية والتصنيف</h4>
                                            <small class="text-muted">تحديد الدور ورمز الدورة والدورية الرئيسية</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label for="cycle_key" class="o_light_label"/>
                                        <field name="cycle_key" placeholder="مثال: SEMI-2026-08-H1"/>
                                    </div>
                                    <div class="mb-3" attrs="{'invisible': [('period_role', '=', 'reading')]}">
                                        <label for="period_role" class="o_light_label"/>
                                        <field name="period_role" readonly="1"/>
                                    </div>
                                    <div class="mb-3">
                                        <label for="billing_cadence" class="o_light_label"/>
                                        <field name="billing_cadence"
                                               attrs="{'readonly': [('period_role', '=', 'payment')]}"/>
                                        <small class="text-muted"
                                               attrs="{'invisible': [('period_role', '!=', 'payment')]}"
                                        >مشتقة من فترة القراءة المرتبطة</small>
                                    </div>
                                    <div class="mb-3">
                                        <label for="type_id" class="o_light_label"/>
                                        <field name="type_id" options="{'no_create': True}"/>
                                    </div>
                                    <div class="mb-3" attrs="{'invisible': [('period_role', '!=', 'payment')]}">
                                        <label for="reading_period_id" class="o_light_label"/>
                                        <field name="reading_period_id" domain="[('period_role', '=', 'reading'), ('billing_cadence', '=', billing_cadence)]" options="{'no_create': True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="card o_settings_card mb-3">
                                <div class="card-header">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-calendar fa-2x text-success me-3" title="التواريخ والنوافذ"/>
                                        <div>
                                            <h4 class="mb-0">نطاقات القراءة والدفع</h4>
                                            <small class="text-muted">نطاق القراءة (date_start/end) ونطاق الدفع (payment_start/end)</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <!-- نطاق القراءة -->
                                    <div class="row mb-2">
                                        <div class="col-12"><small class="text-muted fw-bold"><i class="fa fa-book"/> نطاق القراءة والفوترة</small></div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6 mb-3">
                                            <label for="date_start" class="o_light_label"/>
                                            <field name="date_start"/>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <label for="date_end" class="o_light_label"/>
                                            <field name="date_end"/>
                                        </div>
                                    </div>
                                    <div class="row" attrs="{'invisible': [('period_role', '!=', 'reading')]}">
                                        <div class="col-6 mb-3">
                                            <label for="consumption_start" class="o_light_label"/>
                                            <field name="consumption_start"/>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <label for="consumption_end" class="o_light_label"/>
                                            <field name="consumption_end"/>
                                        </div>
                                    </div>
                                    <!-- نطاق الدفع (الدورة الموحدة) -->
                                    <div class="row mb-2" attrs="{'invisible': [('period_role', '!=', 'reading')]}">
                                        <div class="col-12"><small class="text-muted fw-bold"><i class="fa fa-money"/> نطاق الدفع والتحصيل</small></div>
                                    </div>
                                    <div class="row" attrs="{'invisible': [('period_role', '!=', 'reading')]}">
                                        <div class="col-6 mb-3">
                                            <label for="payment_start" class="o_light_label"/>
                                            <field name="payment_start"/>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <label for="payment_end" class="o_light_label"/>
                                            <field name="payment_end"/>
                                        </div>
                                    </div>
                                    <!-- نوافذ القراءة التفصيلية -->
                                    <div class="row" attrs="{'invisible': [('period_role', '!=', 'reading')]}">
                                        <div class="col-6 mb-3">
                                            <label for="reading_window_start" class="o_light_label"/>
                                            <field name="reading_window_start"/>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <label for="reading_window_end" class="o_light_label"/>
                                            <field name="reading_window_end"/>
                                        </div>
                                    </div>
                                    <!-- نوافذ التحصيل التاريخية -->
                                    <div class="row" attrs="{'invisible': [('period_role', '!=', 'payment')]}">
                                        <div class="col-6 mb-3">
                                            <label for="payment_window_start" class="o_light_label"/>
                                            <field name="payment_window_start"/>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <label for="payment_window_end" class="o_light_label"/>
                                            <field name="payment_window_end"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <!-- === تبويب القراءة (للدورات الموحدة) === -->
                        <page string="حالة القراءة" attrs="{'invisible': [('period_role', '!=', 'reading')]}">
                            <group>
                                <group string="نطاق القراءة">
                                    <field name="reading_state" widget="badge"
                                           decoration-success="reading_state == 'open'"
                                           decoration-info="reading_state == 'closing'"
                                           decoration-warning="reading_state == 'closed'"
                                           decoration-muted="reading_state == 'locked'"/>
                                    <field name="reading_closed_at" readonly="1"
                                           attrs="{'invisible': [('reading_closed_at', '=', False)]}"/>
                                </group>
                                <group string="إحصائيات القراءة">
                                    <field name="received_readings"/>
                                    <field name="pending_review"/>
                                    <field name="approved_readings"/>
                                    <field name="rejected_readings"/>
                                    <field name="missing_readings"/>
                                </group>
                            </group>
                        </page>

                        <!-- === تبويب التحصيل (للدورات الموحدة) === -->
                        <page string="حالة التحصيل" attrs="{'invisible': [('period_role', '!=', 'reading')]}">
                            <group>
                                <group string="نطاق الدفع">
                                    <field name="payment_start"/>
                                    <field name="payment_end"/>
                                    <field name="collection_state" widget="badge"
                                           decoration-success="collection_state == 'open'"
                                           decoration-info="collection_state == 'closing'"
                                           decoration-secondary="collection_state == 'reconciled'"
                                           decoration-muted="collection_state == 'locked'"/>
                                    <field name="collection_reconciled_at" readonly="1"
                                           attrs="{'invisible': [('collection_reconciled_at', '=', False)]}"/>
                                </group>
                                <group string="إحصائيات التحصيل">
                                    <field name="bills_generated"/>
                                    <field name="billed_amount"/>
                                    <field name="collected_in_window"/>
                                    <field name="outstanding_amount"/>
                                    <field name="collection_rate" widget="progressbar"/>
                                </group>
                            </group>
                        </page>

                        <!-- === المناطق المشتركة === -->
                        <page string="المناطق المشتركة">
                            <field name="region_ids" widget="many2many_tags" options="{&#x27;no_create&#x27;: True}" readonly="1"/>
                            <div class="text-muted mt-2">
                                <i class="fa fa-info-circle"/> المناطق snapshot مشتقة تلقائياً من الدورية، وتعديلها يدوياً غير مسموح.
                            </div>
                        </page>

                        <!-- === فترات التحصيل التاريخية (للسجلات القديمة فقط) === -->
                        <page string="فترات التحصيل المرتبطة (تاريخي)" attrs="{'invisible': [('period_role', '!=', 'reading')]}">
                            <field name="payment_period_ids" readonly="1">
                                <tree>
                                    <field name="period_code"/>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="payment_window_start"/>
                                    <field name="payment_window_end"/>
                                    <field name="collected_in_window"/>
                                </tree>
                            </field>
                            <div class="text-muted mt-2">
                                <i class="fa fa-info-circle"/> هذه السجلات تاريخية. في الدورات الجديدة يُستخدم payment_start/end في نفس السجل.
                            </div>
                        </page>

                        <page string="سجل التدقيق والتغييرات">
                            <field name="log_ids" readonly="1">
                                <tree>
                                    <field name="timestamp"/>
                                    <field name="user_id"/>
                                    <field name="action_type" optional="show"/>
                                    <field name="old_state" optional="show"/>
                                    <field name="new_state" optional="show"/>
                                    <field name="changed_fields" optional="show"/>
                                    <field name="reason"/>
                                </tree>
                            </field>
                        </page>

                        <page string="ملاحظات">
                            <field name="notes" placeholder="ملاحظات إضافية عن هذه الدورة..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View: الفترات الزمنية -->
    <record id="view_utility_date_range_search" model="ir.ui.view">
        <field name="name">date.range.utility.search</field>
        <field name="model">date.range</field>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <search string="بحث في الفترات الزمنية">
                <field name="period_code"/>
                <field name="cycle_key"/>
                <field name="name"/>
                <field name="type_id"/>

                <!-- فلاتر الدور -->
                <filter string="الدورات الموحدة (قراءة)" name="reading_roles" domain="[('period_role', '=', 'reading')]"/>
                <filter string="فترات تحصيل تاريخية" name="payment_roles" domain="[('period_role', '=', 'payment')]"/>
                <separator/>

                <!-- فلاتر حالة القراءة -->
                <filter string="القراءة مفتوحة" name="reading_open" domain="[('reading_state', '=', 'open')]"/>
                <filter string="القراءة مغلقة" name="reading_closed" domain="[('reading_state', '=', 'closed')]"/>
                <separator/>

                <!-- فلاتر حالة التحصيل -->
                <filter string="التحصيل مفتوح" name="collection_open" domain="[('collection_state', '=', 'open')]"/>
                <filter string="التحصيل تمت مطابقته" name="collection_reconciled" domain="[('collection_state', '=', 'reconciled')]"/>
                <separator/>

                <!-- فلاتر الحالة الإجمالية -->
                <filter string="الفترات المفتوحة" name="open_periods" domain="[('state', '=', 'open')]"/>
                <filter string="قيد الإغلاق والمطابقة" name="closing_periods" domain="[('state', '=', 'closing')]"/>
                <filter string="المغلقة والمطابقة" name="closed_periods" domain="[('state', 'in', ('closed', 'reconciled'))]"/>
                <separator/>

                <!-- فلاتر الدورية -->
                <filter string="شهري"      name="monthly"      domain="[('billing_cadence', '=', 'monthly')]"/>
                <filter string="نصف شهري"  name="semi_monthly" domain="[('billing_cadence', '=', 'semi_monthly')]"/>
                <separator/>

                <filter string="مؤرشف" name="inactive" domain="[('active', '=', False)]"/>

                <group expand="0" string="تجميع حسب">
                    <filter string="رمز الدورة التشغيلية" name="group_cycle" context="{'group_by': 'cycle_key'}"/>
                    <filter string="دور الفترة"      name="group_role"     context="{'group_by': 'period_role'}"/>
                    <filter string="دورية الفوترة"   name="group_cadence"  context="{'group_by': 'billing_cadence'}"/>
                    <filter string="حالة القراءة"    name="group_reading_state" context="{'group_by': 'reading_state'}"/>
