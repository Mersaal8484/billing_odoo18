<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_transformer_balance_wizard_form" model="ir.ui.view">
        <field name="name">utility.transformer.balance.wizard.form</field>
        <field name="model">utility.transformer.balance.wizard</field>
        <field name="arch" type="xml">
            <form string="تقرير توازن المحول">
                <sheet>
                    <group>
                        <group string="نطاق التقرير">
                            <field name="transformer_id" options="{'no_create': True}"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="ملخص الفاقد">
                            <field name="show_loss_threshold"/>
                            <field name="total_supplied_kwh" readonly="1"/>
                            <field name="total_consumed_kwh" readonly="1"/>
                            <field name="total_loss_kwh" readonly="1"/>
                            <field name="loss_percentage" readonly="1" widget="progressbar"/>
                        </group>
                    </group>

                    <field name="is_loss_warning" invisible="1"/>
                    <div class="alert alert-danger" role="alert" invisible="(is_loss_warning == False)">
                        <strong>تحذير:</strong>
                        نسبة الفاقد تجاوزت الحد المحدد لهذا التقرير.
                    </div>

                    <notebook>
                        <page string="عدادات الربط">
                            <field name="coupling_meter_ids" readonly="1">
                                <list>
                                    <field name="meter_number"/>
                                    <field name="installation_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="عدادات المشتركين">
                            <field name="child_meter_ids" readonly="1">
                                <list>
                                    <field name="meter_number"/>
                                    <field name="customer_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_print_report" string="طباعة التقرير" type="object" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_utility_transformer_balance_wizard" model="ir.actions.act_window">
        <field name="name">تقرير توازن المحول</field>
        <field name="res_model">utility.transformer.balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_utility_transformer_balance_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
