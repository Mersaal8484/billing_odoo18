<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_formula_test_wizard_form" model="ir.ui.view">
        <field name="name">utility.formula.test.wizard.form</field>
        <field name="model">utility.formula.test.wizard</field>
        <field name="arch" type="xml">
            <form string="تشغيل المعادلة">
                <field name="state" invisible="1"/>
                <group>
                    <field name="formula_id"/>
                    <field name="template_id"/>
                </group>
                <group invisible="(state != 'input')">
                    <group string="قيم الاختبار">
                        <field name="consumption"/>
                        <field name="previous_reading"/>
                        <field name="current_reading"/>
                        <field name="discount_first_units"/>
                    </group>
                </group>
                <group invisible="(state != 'result')">
                    <group string="النتيجة">
                        <field name="result" readonly="1"/>
                        <field name="computed_name" readonly="1"/>
                    </group>
                    <div class="alert alert-danger" role="alert"
                         style="margin-top: 15px;" invisible="(error_message == False)">
                        <i class="fa fa-exclamation-triangle" title="خطأ"/>
                        <strong>خطأ:</strong>
                        <field name="error_message" nolabel="1"/>
                    </div>
                </group>
                <footer>
                    <button name="action_run" string="تشغيل" type="object" class="oe_highlight" invisible="(state != 'input')"/>
                    <button name="action_reset" string="إعادة" type="object" class="btn-secondary" invisible="(state != 'result')"/>
                    <button string="إغلاق" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
