<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- System Configuration Parameters -->
        <record id="config_meter_review_required" model="ir.config_parameter">
            <field name="key">utility.meter_review_required</field>
            <field name="value">True</field>
        </record>
        <record id="config_meter_image_mandatory" model="ir.config_parameter">
            <field name="key">utility.meter_image_mandatory</field>
            <field name="value">False</field>
        </record>
        <record id="config_meter_reading_validation" model="ir.config_parameter">
            <field name="key">utility.meter_reading_validation</field>
            <field name="value">both</field>
        </record>
    </data>
    <data noupdate="0">
        <!-- Ensure Yemeni Rial (YER) is Active -->
        <record id="base.YER" model="res.currency">
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
