        <field name="name">تعرفة عامة - نصف شهري</field>
        <field name="code">TMPL_GENERAL_BI</field>
        <field name="pricing_mode">tier</field>
        <field name="recurring_rule_type">semi_monthly</field>
        <field name="recurring_invoicing_type">postpaid</field>
        <field name="recurring_interval">1</field>
        <field name="service_charge">500</field>
        <field name="subscriber_category_ids" eval="[(6, 0, [ref('utility_core.cat_public'), ref('utility_core.cat_large'), ref('utility_core.cat_government')])]"/>
