        <field name="sale_autoconfirm" eval="True"/>
        <field name="create_invoice_automatically" eval="True"/>
        <field name="validate_invoice_automatically" eval="False"/>
        <field name="subsidy_enabled" eval="False"/>
        <field name="active" eval="True"/>
    </record>

