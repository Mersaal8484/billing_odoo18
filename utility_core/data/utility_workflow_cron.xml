<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_workflow_command_dispatcher" model="ir.cron">
            <field name="name">ERP الكهرباء: موزع أوامر مسارات العمل (Workflow Command Dispatcher)</field>
            <field name="model_id" ref="utility_core.model_utility_workflow_command"/>
            <field name="state">code</field>
            <field name="code">model.cron_dispatch_pending_commands(batch_size=20)</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="utility_managed" eval="True"/>
            <field name="utility_code">workflow_command_dispatcher</field>
            <field name="utility_category">operations</field>
            <field name="utility_description">توزيع ومعالجة طابور أوامر مسارات العمل المحلية المؤهلة للتنفيذ في بيئة التطوير</field>
            <field name="prevent_overlap" eval="True"/>
            <field name="allow_manual_run" eval="True"/>
        </record>
    </data>
</odoo>
