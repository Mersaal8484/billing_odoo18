<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_process_pending_migration_batches" model="ir.cron">
            <field name="name">ميجريشن: معالجة دفعات التنفيذ في الانتظار</field>
            <field name="model_id" ref="model_utility_migration_batch"/>
            <field name="state">code</field>
            <field name="code">model.cron_process_pending_batches()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="utility_managed" eval="True"/>
            <field name="utility_code">migration_batch_processor</field>
            <field name="utility_category">operations</field>
            <field name="utility_description">معالجة دفعات ترحيل البيانات (العملاء، العدادات، المحولات، المغذيات) العالقة أو قيد الانتظار</field>
            <field name="prevent_overlap" eval="True"/>
            <field name="allow_manual_run" eval="True"/>
            <field name="batch_size">10</field>
        </record>
    </data>
</odoo>
