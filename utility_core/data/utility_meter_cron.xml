<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_check_idle_meters" model="ir.cron">
            <field name="name">العدادات: فحص العدادات الخاملة والمعطلة</field>
            <field name="model_id" ref="model_utility_meter"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_idle_meters()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <field name="utility_managed" eval="True"/>
            <field name="utility_code">idle_meter_detector</field>
            <field name="utility_category">operations</field>
            <field name="utility_description">تحديث عدد الأشهر الخاملة لكل عداد كهرباء وإنشاء أوامر فحص وتفتيش ميداني آلي للعدادات الخاملة 3 أشهر أو أكثر</field>
            <field name="prevent_overlap" eval="True"/>
            <field name="allow_manual_run" eval="True"/>
            <field name="batch_size">500</field>
        </record>
    </data>
</odoo>
