<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="tmpl_commercial" model="utility.contract.template" context="{'skip_tier_validation': True}">
            <field name="name">قالب القطاع التجاري</field>
            <field name="code">TM_COM</field>
            <field name="pricing_mode">tier</field>
            <field name="recurring_rule_type">semi_monthly</field>
            <field name="recurring_invoicing_type">postpaid</field>
            <field name="recurring_interval">1</field>
            <field name="subscriber_category_ids" eval="[(6, 0, [ref('utility_core.cat_public')])]" />
            <field name="subscriber_ids" eval="[(6, 0, [ref('utility_core.sub_public_commercial')])]" />
            <field name="scope">global</field>
            <field name="sale_autoconfirm" eval="True" />
            <field name="create_invoice_automatically" eval="True" />
            <field name="active" eval="True" />
        </record>

        <!-- Lines -->
        <record id="tmpl_commercial_line_electricity" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_commercial" />
            <field name="sequence">10</field>
            <field name="product_id" ref="utility_core.utility_product_consumption" />
            <field name="name">استهلاك كهرباء (تجاري)</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">consumption</field>
        </record>
        
        <record id="tmpl_commercial_line_service" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_commercial" />
            <field name="sequence">20</field>
            <field name="product_id" ref="utility_core.utility_product_service_charge" />
            <field name="name">رسوم خدمات إضافية ثابتة</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">service_charge</field>
        </record>

        <record id="tmpl_commercial_line_mu_allim" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_commercial" />
            <field name="sequence">30</field>
            <field name="product_id" ref="utility_core.utility_product_mu_allim" />
            <field name="name">رسم المعلم</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">mu_allim</field>
        </record>

        <record id="tmpl_commercial_line_cleaning" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_commercial" />
            <field name="sequence">40</field>
            <field name="product_id" ref="utility_core.utility_product_cleaning" />
            <field name="name">رسم النظافة</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">cleaning</field>
        </record>

        <record id="tmpl_commercial_line_municipality" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_commercial" />
            <field name="sequence">50</field>
            <field name="product_id" ref="utility_core.utility_product_municipality" />
            <field name="name">رسم المجالس المحلية</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">municipality</field>
        </record>

        <!-- Blocks -->
        <record id="tmpl_commercial_block_1" model="utility.contract.template.block">
            <field name="template_id" ref="tmpl_commercial" />
            <field name="sequence">10</field>
            <field name="name">الشريحة الأولى (0-2,999)</field>
            <field name="from_kwh">0</field>
            <field name="to_kwh">3000</field>
            <field name="price_per_kwh">0</field>
        </record>

        <record id="tmpl_commercial_block_2" model="utility.contract.template.block">
            <field name="template_id" ref="tmpl_commercial" />
            <field name="sequence">20</field>
            <field name="name">الشريحة الثانية (3,000-9,999)</field>
            <field name="from_kwh">3000</field>
            <field name="to_kwh">10000</field>
            <field name="price_per_kwh">0</field>
        </record>

        <record id="tmpl_commercial_block_3" model="utility.contract.template.block">
            <field name="template_id" ref="tmpl_commercial" />
            <field name="sequence">30</field>
            <field name="name">الشريحة الثالثة (10,000+)</field>
            <field name="from_kwh">10000</field>
            <field name="to_kwh">0</field>
            <field name="price_per_kwh">0</field>
        </record>
    </data>
</odoo>
