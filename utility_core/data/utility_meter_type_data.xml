<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Pure Operational / Business Purpose Classification -->
        <record id="meter_type_subscriber" model="utility.meter.type">
            <field name="name">عداد مشترك (Subscriber Meter)</field>
            <field name="code">SUB_MTR</field>
            <field name="description">تصنيف تشغيلي لعدادات قياس استهلاك المشتركين والأفراد</field>
        </record>
        <record id="meter_type_feeder" model="utility.meter.type">
            <field name="name">عداد فيدر (Feeder Meter)</field>
            <field name="code">FDR_MTR</field>
            <field name="description">تصنيف تشغيلي لعدادات قياس وتتبع أحمال الخطوط المغذية</field>
        </record>
        <record id="meter_type_transformer" model="utility.meter.type">
            <field name="name">عداد محول (Transformer Meter)</field>
            <field name="code">TRF_MTR</field>
            <field name="description">تصنيف تشغيلي لعدادات قياس وتوازن محولات التوزيع</field>
        </record>
        <record id="meter_type_main" model="utility.meter.type">
            <field name="name">عداد رئيسي / ربط (Main / Coupling Meter)</field>
            <field name="code">MAIN_MTR</field>
            <field name="description">تصنيف تشغيلي لعدادات القياس الرئيسية والربط الشبكي</field>
        </record>
        <record id="meter_type_sub" model="utility.meter.type">
            <field name="name">عداد فرعي (Sub Meter)</field>
            <field name="code">SUB_MTR_CHILD</field>
            <field name="description">تصنيف تشغيلي لعدادات القياس الفرعية التابعة</field>
        </record>
        <record id="meter_type_reference" model="utility.meter.type">
            <field name="name">عداد مرجعي / موازن (Check / Reference Meter)</field>
            <field name="code">REF_MTR</field>
            <field name="description">تصنيف تشغيلي لعدادات المطابقة والتحقق من المفاقيد</field>
        </record>

        <!-- Preserved XML ID Aliases for Upgrades & Backward Compatibility -->
        <record id="meter_type_em_single" model="utility.meter.type">
            <field name="name">عداد مشترك أحادي الطور</field>
            <field name="code">EM_SP</field>
            <field name="description">عداد قياس استهلاك مشتركين فردي</field>
        </record>
        <record id="meter_type_em_three" model="utility.meter.type">
            <field name="name">عداد مشترك ثلاثي الطور</field>
            <field name="code">EM_TP</field>
            <field name="description">عداد قياس استهلاك مشتركين ثلاثي</field>
        </record>
        <!-- Removed: meter_type_sts_single_prepaid & meter_type_sts_three_prepaid -->
        <!-- V1 is strictly Postpaid. Prepaid/STS meter types are OUT OF SCOPE. -->
        <!-- These XML IDs are retired; do not reuse in V1 data files.           -->

        <record id="meter_type_smart_single_postpaid" model="utility.meter.type">
            <field name="name">عداد مشترك آجل الدفع</field>
            <field name="code">SMART_SP_POST</field>
            <field name="description">عداد قياس استهلاك آجل الدفع</field>
        </record>
        <record id="meter_type_smart_three_postpaid" model="utility.meter.type">
            <field name="name">عداد مشترك كبار مشتركين</field>
            <field name="code">SMART_TP_POST</field>
            <field name="description">عداد قياس استهلاك كبار المشتركين</field>
        </record>
        <record id="meter_type_smart_single_gsm" model="utility.meter.type">
            <field name="name">عداد مشترك ذكي متصل</field>
            <field name="code">SMART_SP_GSM</field>
            <field name="description">عداد قياس استهلاك ذكي متصل بالشبكة</field>
        </record>
        <record id="meter_type_smart_three_gsm" model="utility.meter.type">
            <field name="name">عداد محطة / مبيعات متصل</field>
            <field name="code">SMART_TP_GSM</field>
            <field name="description">عداد قياس محطات وتوزيع متصل بالشبكة</field>
        </record>
        <record id="meter_type_dc_solar" model="utility.meter.type">
            <field name="name">عداد طاقة شمسية / متجددة</field>
            <field name="code">DC_SOLAR</field>
            <field name="description">عداد قياس طاقة متجددة وطاقة شمسية</field>
        </record>

        <!-- Legacy Demo Meter Type References (Preserved for Upgrade Safety) -->
        <record id="demo_meter_type_smart_single" model="utility.meter.type">
            <field name="name">عداد ذكي أحادي الطور</field>
            <field name="code">DEMO_SMART_SP</field>
            <field name="description">عداد ذكي أحادي الطور لتجارب العينات</field>
        </record>
        <record id="demo_meter_type_smart_three" model="utility.meter.type">
            <field name="name">عداد ذكي ثلاثي الطور</field>
            <field name="code">DEMO_SMART_TP</field>
            <field name="description">عداد ذكي ثلاثي الطور لتجارب العينات</field>
        </record>
        <record id="demo_meter_type_mech_single" model="utility.meter.type">
            <field name="name">عداد ميكانيكي أحادي الطور</field>
            <field name="code">DEMO_MECH_SP</field>
            <field name="description">عداد ميكانيكي أحادي الطور لتجارب العينات</field>
        </record>
        <record id="demo_meter_type_mech_three" model="utility.meter.type">
            <field name="name">عداد ميكانيكي ثلاثي الطور</field>
            <field name="code">DEMO_MECH_TP</field>
            <field name="description">عداد ميكانيكي ثلاثي الطور لتجارب العينات</field>
        </record>
    </data>
</odoo>
