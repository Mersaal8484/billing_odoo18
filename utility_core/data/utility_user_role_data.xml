<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="role_meter_reader" model="utility.user.role">
            <field name="name">قارئ عدادات</field>
            <field name="code">meter_reader</field>
            <field name="group_ids" eval="[(4, ref('utility_core.group_utility_meter_reader'))]"/>
        </record>

        <record id="role_inspector" model="utility.user.role">
            <field name="name">مفتش ميداني</field>
            <field name="code">inspector</field>
            <field name="group_ids" eval="[(4, ref('utility_core.group_utility_field_inspector'))]"/>
        </record>
        
        <record id="role_cashier" model="utility.user.role">
            <field name="name">أمين صندوق</field>
            <field name="code">cashier</field>
            <field name="group_ids" eval="[(4, ref('utility_core.group_utility_cashier'))]"/>
        </record>

        <record id="role_collector" model="utility.user.role">
            <field name="name">متحصل ميداني</field>
            <field name="code">collector</field>
            <field name="group_ids" eval="[(4, ref('utility_core.group_utility_collector'))]"/>
        </record>

        <record id="role_supervisor" model="utility.user.role">
            <field name="name">مشرف</field>
            <field name="code">supervisor</field>
            <field name="group_ids" eval="[(4, ref('utility_core.group_utility_supervisor'))]"/>
        </record>

        <record id="role_technician" model="utility.user.role">
            <field name="name">فني</field>
            <field name="code">technician</field>
            <field name="group_ids" eval="[(4, ref('utility_core.group_utility_technician'))]"/>
        </record>

        <record id="role_manager" model="utility.user.role">
            <field name="name">مدير</field>
            <field name="code">manager</field>
            <field name="group_ids" eval="[(4, ref('utility_core.group_utility_revenue_manager'))]"/>
        </record>

        <!-- Additional organizational roles using the existing security groups. -->
        <record id="role_reading_reviewer" model="utility.user.role">
            <field name="name">مراجع قراءات</field>
            <field name="code">reading_reviewer</field>
            <field name="group_ids" eval="[(4, ref('utility_core.group_utility_auditor'))]"/>
            <field name="description">مراجع القراءات والصور الرقمية ضمن النطاق الجغرافي المخصص له.</field>
        </record>

        <record id="role_commercial_manager" model="utility.user.role">
            <field name="name">مدير تجاري</field>
            <field name="code">commercial_manager</field>
            <field name="group_ids" eval="[(4, ref('utility_core.group_utility_revenue_manager'))]"/>
            <field name="description">إدارة العمليات التجارية والإيرادات على مستوى المنطقة أو الفرع المخصص للمستخدم، وفق صلاحيات مدير الإيرادات الحالية.</field>
        </record>

        <record id="role_area_accountant" model="utility.user.role">
            <field name="name">محاسب منطقة</field>
            <field name="code">area_accountant</field>
            <field name="group_ids" eval="[(4, ref('utility_core.group_utility_auditor'))]"/>
            <field name="description">متابعة السجلات والبيانات المحاسبية للمنطقة المخصصة بصلاحيات القراءة الحالية.</field>
        </record>
    </data>
</odoo>
