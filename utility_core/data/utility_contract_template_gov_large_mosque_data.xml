<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- 1. TM_MOSQUE -->
        <record id="tmpl_mosque" model="utility.contract.template" context="{'skip_tier_validation': True}">
            <field name="name">قالب المساجد ودور العبادة</field>
            <field name="code">TM_MOSQUE</field>
            <field name="pricing_mode">flat</field>
            <field name="recurring_rule_type">semi_monthly</field>
            <field name="recurring_invoicing_type">postpaid</field>
            <field name="recurring_interval">1</field>
            <field name="subscriber_category_ids" eval="[(6, 0, [ref('utility_core.cat_public')])]" />
            <field name="subscriber_ids" eval="[(6, 0, [ref('utility_core.sub_public_mosque')])]" />
            <field name="scope">global</field>
            <field name="sale_autoconfirm" eval="True" />
            <field name="create_invoice_automatically" eval="True" />
            <field name="active" eval="True" />
        </record>

        <record id="tmpl_mosque_line_electricity" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_mosque" />
            <field name="sequence">10</field>
            <field name="product_id" ref="utility_core.utility_product_consumption" />
            <field name="name">استهلاك كهرباء (دور العبادة - مدعوم)</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">consumption</field>
        </record>
        
        <record id="tmpl_mosque_line_mu_allim" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_mosque" />
            <field name="sequence">20</field>
            <field name="product_id" ref="utility_core.utility_product_mu_allim" />
            <field name="name">رسم المعلم</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">mu_allim</field>
        </record>


        <!-- 2. TM_GOV -->
        <record id="tmpl_gov" model="utility.contract.template" context="{'skip_tier_validation': True}">
            <field name="name">قالب المرافق والجهات الحكومية</field>
            <field name="code">TM_GOV</field>
            <field name="pricing_mode">tier</field>
            <field name="recurring_rule_type">semi_monthly</field>
            <field name="recurring_invoicing_type">postpaid</field>
            <field name="recurring_interval">1</field>
            <field name="subscriber_category_ids" eval="[(6, 0, [ref('utility_core.cat_government')])]" />
            <field name="subscriber_ids" eval="[(6, 0, [ref('utility_core.sub_category_government_new'), ref('utility_core.sub_gov_b')])]" />
            <field name="scope">global</field>
            <field name="sale_autoconfirm" eval="True" />
            <field name="create_invoice_automatically" eval="True" />
            <field name="active" eval="True" />
        </record>

        <!-- TM_GOV Lines -->
        <record id="tmpl_gov_line_electricity" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_gov" />
            <field name="sequence">10</field>
            <field name="product_id" ref="utility_core.utility_product_consumption" />
            <field name="name">استهلاك كهرباء (حكومي)</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">consumption</field>
        </record>
        <record id="tmpl_gov_line_service" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_gov" />
            <field name="sequence">20</field>
            <field name="product_id" ref="utility_core.utility_product_service_charge" />
            <field name="name">رسوم خدمات إضافية ثابتة</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">service_charge</field>
        </record>
        <record id="tmpl_gov_line_mu_allim" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_gov" />
            <field name="sequence">30</field>
            <field name="product_id" ref="utility_core.utility_product_mu_allim" />
            <field name="name">رسم المعلم</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">mu_allim</field>
        </record>
        <record id="tmpl_gov_line_cleaning" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_gov" />
            <field name="sequence">40</field>
            <field name="product_id" ref="utility_core.utility_product_cleaning" />
            <field name="name">رسم النظافة</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">cleaning</field>
        </record>
        <record id="tmpl_gov_line_municipality" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_gov" />
            <field name="sequence">50</field>
            <field name="product_id" ref="utility_core.utility_product_municipality" />
            <field name="name">رسم المجالس المحلية</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">municipality</field>
        </record>

        <!-- TM_GOV Blocks -->
        <record id="tmpl_gov_block_1" model="utility.contract.template.block">
            <field name="template_id" ref="tmpl_gov" />
            <field name="sequence">10</field><field name="name">الشريحة الأولى (0-19,999)</field><field name="from_kwh">0</field><field name="to_kwh">20000</field><field name="price_per_kwh">0</field>
        </record>
        <record id="tmpl_gov_block_2" model="utility.contract.template.block">
            <field name="template_id" ref="tmpl_gov" />
            <field name="sequence">20</field><field name="name">الشريحة الثانية (20,000-99,999)</field><field name="from_kwh">20000</field><field name="to_kwh">100000</field><field name="price_per_kwh">0</field>
        </record>
        <record id="tmpl_gov_block_3" model="utility.contract.template.block">
            <field name="template_id" ref="tmpl_gov" />
            <field name="sequence">30</field><field name="name">الشريحة الثالثة (100,000+)</field><field name="from_kwh">100000</field><field name="to_kwh">0</field><field name="price_per_kwh">0</field>
        </record>


        <!-- 3. TM_LARGE -->
        <record id="tmpl_large" model="utility.contract.template" context="{'skip_tier_validation': True}">
            <field name="name">قالب كبار المستهلكين والمحولات الخاصة</field>
            <field name="code">TM_LARGE</field>
            <field name="pricing_mode">tier</field>
            <field name="recurring_rule_type">semi_monthly</field>
            <field name="recurring_invoicing_type">postpaid</field>
            <field name="recurring_interval">1</field>
            <field name="subscriber_category_ids" eval="[(6, 0, [ref('utility_core.cat_large')])]" />
            <field name="subscriber_ids" eval="[(6, 0, [ref('utility_core.sub_category_large')])]" />
            <field name="scope">global</field>
            <field name="sale_autoconfirm" eval="True" />
            <field name="create_invoice_automatically" eval="True" />
            <field name="active" eval="True" />
        </record>

        <!-- TM_LARGE Lines -->
        <record id="tmpl_large_line_electricity" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_large" />
            <field name="sequence">10</field>
            <field name="product_id" ref="utility_core.utility_product_consumption" />
            <field name="name">استهلاك كهرباء (كبار مستهلكين)</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">consumption</field>
        </record>
        <record id="tmpl_large_line_service" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_large" />
            <field name="sequence">20</field>
            <field name="product_id" ref="utility_core.utility_product_service_charge" />
            <field name="name">رسوم خدمات إضافية ثابتة</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">service_charge</field>
        </record>
        <record id="tmpl_large_line_mu_allim" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_large" />
            <field name="sequence">30</field>
            <field name="product_id" ref="utility_core.utility_product_mu_allim" />
            <field name="name">رسم المعلم</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">mu_allim</field>
        </record>
        <record id="tmpl_large_line_cleaning" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_large" />
            <field name="sequence">40</field>
            <field name="product_id" ref="utility_core.utility_product_cleaning" />
            <field name="name">رسم النظافة</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">cleaning</field>
        </record>
        <record id="tmpl_large_line_municipality" model="utility.contract.template.line">
            <field name="template_id" ref="tmpl_large" />
            <field name="sequence">50</field>
            <field name="product_id" ref="utility_core.utility_product_municipality" />
            <field name="name">رسم المجالس المحلية</field>
            <field name="price_type">fixed</field>
            <field name="specific_price">0</field>
            <field name="meter_line_type">municipality</field>
        </record>

        <!-- TM_LARGE Blocks -->
        <record id="tmpl_large_block_1" model="utility.contract.template.block">
            <field name="template_id" ref="tmpl_large" />
            <field name="sequence">10</field><field name="name">الشريحة الأولى (0-9,999)</field><field name="from_kwh">0</field><field name="to_kwh">10000</field><field name="price_per_kwh">0</field>
        </record>
        <record id="tmpl_large_block_2" model="utility.contract.template.block">
            <field name="template_id" ref="tmpl_large" />
            <field name="sequence">20</field><field name="name">الشريحة الثانية (10,000-49,999)</field><field name="from_kwh">10000</field><field name="to_kwh">50000</field><field name="price_per_kwh">0</field>
        </record>
        <record id="tmpl_large_block_3" model="utility.contract.template.block">
            <field name="template_id" ref="tmpl_large" />
            <field name="sequence">30</field><field name="name">الشريحة الثالثة (50,000-99,999)</field><field name="from_kwh">50000</field><field name="to_kwh">100000</field><field name="price_per_kwh">0</field>
        </record>
        <record id="tmpl_large_block_4" model="utility.contract.template.block">
            <field name="template_id" ref="tmpl_large" />
            <field name="sequence">40</field><field name="name">الشريحة الرابعة (100,000+)</field><field name="from_kwh">100000</field><field name="to_kwh">0</field><field name="price_per_kwh">0</field>
        </record>
    </data>
</odoo>
