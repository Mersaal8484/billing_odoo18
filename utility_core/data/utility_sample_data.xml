        <record id="deactivate_other_currencies" model="ir.actions.server">
            <field name="name">Deactivate all currencies except YER</field>
            <field name="model_id" ref="base.model_res_currency" />
            <field name="state">code</field>
            <field name="code">used_currency_ids = env['res.company'].with_context(active_test=False).search([]).mapped('currency_id').ids
env['res.currency'].with_context(active_test=False).search([('name', '!=', 'YER'), ('id', 'not in', used_currency_ids)]).write({'active': False})
            </field>
        </record>
        <function model="ir.actions.server" name="run">
            <value eval="[ref('deactivate_other_currencies')]" />
        </function>
        <record id="deactivate_all_taxes" model="ir.actions.server">
            <field name="name">Deactivate all taxes globally</field>
            <field name="model_id" ref="base.model_res_company" />
            <field name="state">code</field>
            <field name="code"># 1. إزالة الضرائب الافتراضية للشركة
env['res.company'].search([]).write({
    'account_sale_tax_id': False,
    'account_purchase_tax_id': False,
})
# 2. تعطيل جميع سجلات الضرائب
taxes = env['account.tax'].with_context(active_test=False).search([])
if taxes:
    taxes.write({'active': False})
# 3. إزالة الضرائب من جميع المنتجات
products = env['product.template'].with_context(active_test=False).search([])
if products:
    products.write({'taxes_id': [(5, 0, 0)], 'supplier_taxes_id': [(5, 0, 0)]})
            </field>
        </record>
        <function model="ir.actions.server" name="run">
