        <record id="action_update_general_biweekly_blocks" model="ir.actions.server">
            <field name="name">Update General Biweekly Template Blocks</field>
            <field name="model_id" ref="utility_core.model_utility_contract_template" />
            <field name="state">code</field>
            <field name="code">template = env.ref('utility_core.demo_tmpl_general_biweekly', raise_if_not_found=False)
if not template:
    template = env['utility.contract.template'].browse(1)
if template:
    old_blocks = template.block_ids
    blocks_data = [
        {'sequence': 10, 'name': 'الشريحة الأولى (0-2,999)', 'from_kwh': 0, 'to_kwh': 3000, 'price_per_kwh': 230},
        {'sequence': 20, 'name': 'الشريحة الثانية (3,000-9,999)', 'from_kwh': 3000, 'to_kwh': 10000, 'price_per_kwh': 220},
        {'sequence': 30, 'name': 'الشريحة الثالثة (10,000-19,999)', 'from_kwh': 10000, 'to_kwh': 20000, 'price_per_kwh': 200},
        {'sequence': 40, 'name': 'الشريحة الرابعة (20,000-29,999)', 'from_kwh': 20000, 'to_kwh': 30000, 'price_per_kwh': 190},
        {'sequence': 50, 'name': 'الشريحة الخامسة (30,000-99,999)', 'from_kwh': 30000, 'to_kwh': 100000, 'price_per_kwh': 185},
        {'sequence': 60, 'name': 'الشريحة السادسة (100,000-199,999)', 'from_kwh': 100000, 'to_kwh': 200000, 'price_per_kwh': 180},
        {'sequence': 70, 'name': 'الشريحة السابعة (200,000-299,999)', 'from_kwh': 200000, 'to_kwh': 300000, 'price_per_kwh': 175},
        {'sequence': 80, 'name': 'الشريحة الثامنة (300,000+)', 'from_kwh': 300000, 'to_kwh': 0, 'price_per_kwh': 170},
    ]
    has_discount = bool(template.discount_formula_id and template.line_ids.filtered(lambda line: line.meter_line_type == 'discount'))
    if has_discount:
        blocks_data.append({
            'sequence': 10,
            'name': 'الوحدات المدعومة (0-100)',
            'from_kwh': 0,
            'to_kwh': 100,
            'price_per_kwh': blocks_data[0]['price_per_kwh'],
            'is_discount': True,
        })
    env.cr.execute("DELETE FROM utility_contract_template_block WHERE template_id = %s", [template.id])
    for b in blocks_data:
        b['template_id'] = template.id
    env['utility.contract.template.block'].create(blocks_data)
            </field>
        </record>
        <function model="ir.actions.server" name="run">
            <value eval="[ref('action_update_general_biweekly_blocks')]" />
        </function>
    </data>
