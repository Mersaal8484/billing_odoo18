<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_meter_vision" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.meter.vision</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="رؤية العدادات" string="رؤية العدادات"
                     data-key="utility_meter_vision" groups="utility_meter_vision.group_meter_vision_manager">
                    <h2>خدمة تحليل صور العدادات</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="meter_vision_service_url"/>
                                <field name="meter_vision_service_url" placeholder="http://meter-vision-service:8000"/>
                                <label for="meter_vision_service_token" class="mt16"/>
                                <field name="meter_vision_service_token" password="True"/>
                                <label for="meter_vision_timeout" class="mt16"/>
                                <field name="meter_vision_timeout"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
