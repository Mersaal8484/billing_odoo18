        <record id="utility_service_order_company_rule" model="ir.rule">
            <field name="name">Service Order Multi-Company Rule</field>
            <field name="model_id" ref="model_utility_service_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
