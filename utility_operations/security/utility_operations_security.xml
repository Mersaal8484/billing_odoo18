            <field name="model_id" ref="model_utility_service_order"/>
            <field name="domain_force">[(1, '=', 1)] if user._is_global_utility_scope() else (['|', ('customer_id.area_id', 'in', user._get_effective_branch_ids()), ('customer_id.region_id', 'in', user._get_effective_region_ids())] if (user._get_effective_branch_ids() or user._get_effective_region_ids()) else [('id', '=', False)])</field>
