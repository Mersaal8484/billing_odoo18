<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_detect_zero_consumption_meters" model="ir.cron">
            <field name="name">الكشف التلقائي عن العدادات الخاملة/المعطلة</field>
            <field name="model_id" ref="model_utility_service_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_detect_zero_consumption_meters(batch_limit=500)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
            <field name="utility_managed" eval="True"/>
            <field name="utility_code">zero_consumption_detector</field>
