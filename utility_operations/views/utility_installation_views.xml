<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_utility_installation_tree" model="ir.ui.view">
            <field name="name">utility.installation.tree</field>
            <field name="model">utility.installation</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="meter_id"/>
                    <field name="installation_date"/>
                    <field name="installer_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_utility_installation_form" model="ir.ui.view">
            <field name="name">utility.installation.form</field>
            <field name="model">utility.installation</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_install" type="object" string="تنفيذ التركيب" class="btn-primary" invisible="state not in ('draft')"/>
                        <button name="action_verify" type="object" string="التحقق من التركيب" class="btn-success" invisible="state not in ('installed')"/>
                        <button name="action_fail" type="object" string="تسجيل فشل" class="btn-danger" confirm="هل أنت متاكد من تسجيل فشل هذه التركيبة؟" invisible="state not in ('draft', 'installed')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,installed,verified,failed" options="{'clickable': False}"/>
                    </header>
                    <sheet>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="service_order_id"/>
                                <field name="customer_id" required="1"/>
                                <field name="account_id" required="1"/>
                            </group>
                            <group>
                                <field name="installation_date"/>
                                <field name="installer_id"/>
                            <field name="state" readonly="1"/>
                            </group>
                        </group>
                        <group string="بيانات العداد">
                            <group>
                                <field name="meter_id" required="1"/>
                                <field name="meter_serial_snapshot" readonly="1"/>
                                <field name="meter_type_id"/>
                            </group>
                            <group>
                                <field name="seal_number"/>
                                <field name="address"/>
                            </group>
                        </group>
                        <field name="notes" nolabel="1"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_utility_installation" model="ir.actions.act_window">
            <field name="name">التركيبات</field>
            <field name="res_model">utility.installation</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_pending_installations': 1}</field>
        </record>

        <record id="view_utility_installation_search" model="ir.ui.view">
            <field name="name">utility.installation.search</field>
            <field name="model">utility.installation</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="meter_id"/>
                    <field name="installer_id"/>
                    <field name="state"/>
                    <filter name="pending_installations" string="قيد التنفيذ"
                            domain="[('state','in',('draft','installed'))]"/>
                    <filter name="failed_installations" string="فاشلة"
                            domain="[('state','=','failed')]"/>
                    <filter name="installations_today" string="اليوم" date="installation_date"/>
                    <separator/>
                    <group expand="0" string="تجميع حسب">
                        <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                        <filter name="group_installer" string="الفني" context="{'group_by': 'installer_id'}"/>
                        <filter name="group_customer" string="العميل" context="{'group_by': 'customer_id'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>
