<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_utility_service_order_tree" model="ir.ui.view">
            <field name="name">utility.service.order.tree</field>
            <field name="model">utility.service.order</field>
            <field name="arch" type="xml">
                <list>
                    <field name="order_number"/>
                    <field name="date_requested"/>
                    <field name="service_type"/>
                    <field name="priority"/>
                    <field name="customer_id"/>
                    <field name="meter_id"/>
                    <field name="technician_id"/>
                    <field name="state"/>
                    <field name="date_scheduled"/>
                </list>
            </field>
        </record>

        <record id="view_utility_service_order_form" model="ir.ui.view">
            <field name="name">utility.service.order.form</field>
            <field name="model">utility.service.order</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" options="{'clickable': False}"/>
                        <button name="action_approve" string="اعتماد" type="object" class="btn-primary" invisible="state not in ('draft')"/>
                        <button name="action_schedule" string="جدولة" type="object" class="btn-primary" invisible="state not in ('approved')"/>
                        <button name="action_start" string="بدء" type="object" class="btn-primary" invisible="state not in ('scheduled')"/>
                        <button name="action_complete" string="إكمال" type="object" class="btn-primary" invisible="state not in ('in_progress')"/>
                        <button name="action_cancel" string="إلغاء" type="object" class="btn-secondary" invisible="state not in ('draft', 'approved', 'scheduled')"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="action" name="%(stock.action_picking_tree_all)d"
                                    icon="fa-truck"
                                    context="{'search_default_origin': order_number}">
                                <field string="حركات المخزون" name="picking_count" widget="statinfo"/>
                            </button>
                        </div>
                        <h1>
                            <field name="order_number" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="service_type" required="1"/>
                                <field name="priority"/>
                                <field name="state" readonly="1"/>
                            </group>
                            <group>
                                <field name="technician_id"/>
                                <field name="team_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="warehouse_id" options="{'no_create': True}"/>
                                <field name="date_requested"/>
                                <field name="date_scheduled"/>
                                <field name="date_completed"/>
                            </group>
                        </group>
                        <group>
                            <group string="العميل">
                                <field name="customer_id"/>
                                <field name="account_id"/>
                                <field name="meter_id" domain="[('customer_id', '=', customer_id)]"/>
                            </group>
                            <group string="الموقع">
                                <field name="region_id"/>
                                <field name="area_id"/>
                                <field name="zone_id"/>

                            </group>
                        </group>
                        <notebook>
                            <page string="الوصف">
                                <field name="description" nolabel="1"/>
                            </page>
                            <page string="بيانات العداد">
                                <group>
                                    <group string="العداد القديم">
                                        <field name="old_meter_id" domain="[('customer_id', '=', customer_id)]"/>
                                        <field name="meter_reading_before"/>
                                        <field name="seal_number_old"/>
                                    </group>
                                    <group string="العداد الجديد">
                                        <field name="new_meter_id" domain="[('connection_type', '=', 'not_connected')]"/>
                                        <field name="meter_reading_after"/>
                                        <field name="seal_number_new"/>
                                    </group>
                                </group>
                            </page>
                            <page string="النتائج">
                                <group>
                                    <group>
                                        <field name="findings"/>
                                        <field name="tamper_evidence"/>
                                        <field name="tamper_notes"/>
                                    </group>
                                    <group>
                                        <field name="cost_estimate"/>
                                        <field name="actual_cost"/>
                                    </group>
                                </group>
                            </page>
                            <page string="ملاحظات">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_utility_service_order_search" model="ir.ui.view">
            <field name="name">utility.service.order.search</field>
            <field name="model">utility.service.order</field>
            <field name="arch" type="xml">
                <search>
                    <field name="order_number"/>
                    <field name="customer_id"/>
                    <field name="technician_id"/>
                    <field name="service_type"/>
                    <field name="state"/>
                    <field name="priority"/>
                    <filter name="filter_date" string="تاريخ الطلب" date="date_requested"/>
                    <filter name="open_orders" string="قيد المتابعة"
                            domain="[('state','not in',('completed','cancelled'))]"/>
                    <group expand="0" string="تصنيف حسب">
                        <filter name="group_service_type" string="نوع الخدمة" context="{'group_by': 'service_type'}"/>
                        <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                        <filter name="group_priority" string="الأولوية" context="{'group_by': 'priority'}"/>
                        <filter name="group_technician" string="الفني" context="{'group_by': 'technician_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_utility_service_order" model="ir.actions.act_window">
            <field name="name">أوامر الخدمة</field>
            <field name="res_model">utility.service.order</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_utility_service_order_search"/>
            <field name="context">{'search_default_open_orders': 1}</field>
            <field name="help" type="html">
                <p>إدارة أوامر الخدمة للعمليات الميدانية.</p>
            </field>
        </record>

    </data>
</odoo>
