<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_utility_alarm_tree" model="ir.ui.view">
            <field name="name">utility.alarm.tree</field>
            <field name="model">utility.alarm</field>
            <field name="arch" type="xml">
                <list>
                    <field name="alarm_code"/>
                    <field name="alarm_date"/>
                    <field name="alarm_type"/>
                    <field name="severity"/>
                    <field name="customer_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_utility_alarm_form" model="ir.ui.view">
            <field name="name">utility.alarm.form</field>
            <field name="model">utility.alarm</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_acknowledge" string="تأكيد الاستلام" type="object" class="btn-primary" invisible="state not in ('open')"/>
                        <button name="action_start" string="بدء التحقيق" type="object" class="btn-primary" invisible="state not in ('acknowledged')"/>
                        <button name="action_resolve" string="حل الإنذار" type="object" class="btn-success" invisible="state not in ('investigating')"/>
                        <button name="action_close" string="رفض / إغلاق" type="object" class="btn-secondary" invisible="state not in ('open', 'acknowledged', 'investigating')"/>
                        <button name="action_create_service_order" string="إنشاء أمر خدمة / قضية تلاعب" type="object" class="btn-info" invisible="state not in ('open', 'acknowledged', 'investigating')"/>
                        <field name="state" widget="statusbar" statusbar_visible="open,acknowledged,investigating,resolved,dismissed" options="{'clickable': False}"/>
                    </header>
                    <sheet>
                        <h1>
                            <field name="alarm_code" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="alarm_type" required="1"/>
                                <field name="severity"/>
                                <field name="alarm_date"/>
                            </group>
                            <group>
                                <field name="assigned_to"/>
                                <field name="customer_id"/>
                                <field name="account_id"/>
                                <field name="meter_id"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="region_id"/>
                                <field name="area_id"/>
                            </group>
                            <group>
                                <field name="meter_reading"/>
                                <field name="voltage"/>
                                <field name="current"/>
                                <field name="power"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="التفاصيل">
                                <group>
                                    <field name="description" nolabel="1"/>
                                </group>
                            </page>
                            <page string="الحل">
                                <group>
                                    <field name="resolution"/>
                                    <field name="resolution_date"/>
                                    <field name="service_order_id"/>
                                    <field name="tamper_case_id" invisible="(alarm_type != 'tamper')"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_utility_alarm" model="ir.actions.act_window">
            <field name="name">الإنذارات</field>
            <field name="res_model">utility.alarm</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_open_alarms': 1}</field>
        </record>

        <record id="view_utility_alarm_search" model="ir.ui.view">
            <field name="name">utility.alarm.search</field>
            <field name="model">utility.alarm</field>
            <field name="arch" type="xml">
                <search>
                    <field name="alarm_code"/>
                    <field name="customer_id"/>
                    <field name="assigned_to"/>
                    <field name="alarm_type"/>
                    <field name="severity"/>
                    <field name="state"/>
                    <filter name="open_alarms" string="تحتاج متابعة"
                            domain="[('state','not in',('resolved','dismissed'))]"/>
                    <filter name="critical_alarms" string="حرجة أو طوارئ"
                            domain="[('severity','in',('critical','emergency'))]"/>
                    <filter name="alarms_today" string="اليوم" date="alarm_date"/>
                    <separator/>
                    <group expand="0" string="تجميع حسب">
                        <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                        <filter name="group_severity" string="الخطورة" context="{'group_by': 'severity'}"/>
                        <filter name="group_type" string="نوع الإنذار" context="{'group_by': 'alarm_type'}"/>
                        <filter name="group_assignee" string="المسؤول" context="{'group_by': 'assigned_to'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>
