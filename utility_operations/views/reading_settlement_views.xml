<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE VIEW -->
    <record id="view_utility_reading_settlement_tree" model="ir.ui.view">
        <field name="name">utility.reading.settlement.tree</field>
        <field name="model">utility.reading.settlement</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-info="state in ('submitted', 'technically_approved')"
                  decoration-success="state == 'processed'">
                <field name="name"/>
                <field name="reading_id"/>
                <field name="meter_id"/>
                <field name="account_id"/>
                <field name="original_reading_value" string="القراءة الأصلية"/>
                <field name="corrected_reading_value" string="القراءة المصحّحة"/>
                <field name="original_consumption" string="الاستهلاك الأصلي"/>
                <field name="corrected_consumption" string="الاستهلاك المصحّح"/>
                <field name="delta_consumption" string="فرق الاستهلاك"/>
                <field name="reason"/>
                <field name="submitted_by_id"/>
                <field name="approved_by_id"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('submitted', 'technically_approved')"
                       decoration-success="state == 'processed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_utility_reading_settlement_form" model="ir.ui.view">
        <field name="name">utility.reading.settlement.form</field>
        <field name="model">utility.reading.settlement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object"
                            string="تقديم للمراجعة التقنية" class="oe_highlight" invisible="(state != 'draft')"/>
                    <button name="action_technically_approve" type="object"
                            string="اعتماد تقني" class="oe_highlight" invisible="(state != 'submitted')"/>
                    <button name="action_process" type="object"
                            string="إحالة للفوترة" class="oe_highlight" invisible="(state != 'technically_approved')"/>
                    <button name="action_cancel" type="object"
                            string="إلغاء" invisible="(state in ('processed', 'cancelled'))"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,technically_approved,processed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <label for="name" string="رقم التسوية التقنية"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="معلومات القراءة الأصلية">
                            <field name="reading_id" readonly="(state != 'draft')"/>
                            <field name="meter_id"/>
                            <field name="account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="بيانات التصحيح التقني">
                            <field name="original_reading_value"/>
                            <field name="corrected_reading_value" readonly="(state != 'draft')"/>
                            <field name="original_consumption"/>
                            <field name="corrected_consumption"/>
                            <field name="delta_consumption"/>
                        </group>
                    </group>
                    <group string="سبب التصحيح التقني">
                        <field name="reason" nolabel="1" readonly="(state != 'draft')"/>
                    </group>
                    <group string="سجل الإجراءات والتدقيق">
                        <group>
                            <field name="submitted_by_id"/>
                            <field name="submitted_date"/>
                            <field name="approved_by_id"/>
                            <field name="approved_date"/>
                        </group>
                        <group>
                            <field name="processed_by_id"/>
                            <field name="processed_date"/>
                            <field name="cancelled_by_id" invisible="(state != 'cancelled')"/>
                            <field name="cancelled_date" invisible="(state != 'cancelled')"/>
                            <field name="cancel_reason" invisible="(state != 'cancelled')"/>
                            <field name="correction_move_id" invisible="(correction_move_id == False)"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_utility_reading_settlement_search" model="ir.ui.view">
        <field name="name">utility.reading.settlement.search</field>
        <field name="model">utility.reading.settlement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reading_id"/>
                <field name="meter_id"/>
                <field name="account_id"/>
                <filter name="draft" string="مسودة" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="مُقدَّمة للمراجعة" domain="[('state','=','submitted')]"/>
                <filter name="technically_approved" string="معتمدة تقنياً" domain="[('state','=','technically_approved')]"/>
                <filter name="processed" string="تمت الإحالة" domain="[('state','=','processed')]"/>
                <separator/>
                <filter name="group_state" string="الحالة" context="{'group_by':'state'}"/>
                <filter name="group_submitted_date" string="تاريخ التقديم" context="{'group_by':'submitted_date'}"/>
            </search>
        </field>
    </record>

    <record id="action_utility_readings_settlement" model="ir.actions.act_window">
        <field name="name">تسوية قراءات العدادات (تقني)</field>
        <field name="res_model">utility.reading.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_utility_reading_settlement_search"/>
    </record>
</odoo>
