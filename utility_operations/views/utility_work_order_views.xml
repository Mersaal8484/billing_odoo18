<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_utility_work_order_tree" model="ir.ui.view">
            <field name="name">utility.work.order.tree</field>
            <field name="model">utility.work.order</field>
            <field name="arch" type="xml">
                <list>
                    <field name="work_order_number"/>
                    <field name="date_created"/>
                    <field name="work_type"/>
                    <field name="priority"/>
                    <field name="customer_id"/>
                    <field name="assigned_technician_id"/>
                    <field name="state"/>
                    <field name="date_scheduled"/>
                </list>
            </field>
        </record>

        <record id="view_utility_work_order_form" model="ir.ui.view">
            <field name="name">utility.work.order.form</field>
            <field name="model">utility.work.order</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_assign" type="object" string="تعيين أمر العمل" class="btn-primary" invisible="state not in ('draft')"/>
                        <button name="action_start" type="object" string="بدء التنفيذ" class="btn-primary" invisible="state not in ('assigned')"/>
                        <button name="action_complete" type="object" string="إكمال العمل" class="btn-success" invisible="state not in ('in_progress')"/>
                        <button name="action_verify" type="object" string="تحقق من العمل" class="btn-success" invisible="state not in ('completed')"/>
                        <button name="action_cancel" type="object" string="إلغاء أمر العمل" class="btn-secondary" confirm="هل أنت متاكد من إلغاء امر العمل؟" invisible="state not in ('draft', 'assigned', 'in_progress', 'completed')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,assigned,in_progress,completed,verified,cancelled" options="{'clickable': False}"/>
                    </header>
                    <sheet>
                        <h1>
                            <field name="work_order_number" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="work_type" required="1"/>
                                <field name="priority"/>
                                <field name="state" readonly="1"/>
                            </group>
                            <group>
                                <field name="assigned_technician_id"/>
                                <field name="team_id"/>
                                <field name="date_created"/>
                                <field name="date_scheduled"/>
                                <field name="date_started"/>
                                <field name="date_completed"/>
                            </group>
                        </group>
                        <group string="المرتبط">
                            <group>
                                <field name="service_order_id"/>
                                <field name="customer_id"/>
                            </group>
                            <group>
                                <field name="account_id"/>
                                <field name="meter_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="الوصف">
                                <field name="description" nolabel="1"/>
                            </page>
                            <page string="الوقت والموقع">
                                <group>
                                    <group>
                                        <field name="labor_hours"/>
                                        <field name="gps_check_in"/>
                                        <field name="gps_check_out"/>
                                    </group>
                                    <group>
                                        <field name="cost_estimate"/>
                                        <field name="actual_cost"/>
                                    </group>
                                </group>
                            </page>
                            <page string="القطع والصور">
                                <group>
                                    <field name="parts_used"/>
                                </group>
                            </page>
                            <page string="التوقيع">
                                <field name="customer_signature" widget="signature"/>
                            </page>
                            <page string="ملاحظات">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_utility_work_order" model="ir.actions.act_window">
            <field name="name">أوامر العمل</field>
            <field name="res_model">utility.work.order</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_open_work': 1}</field>
        </record>

        <record id="view_utility_work_order_search" model="ir.ui.view">
            <field name="name">utility.work.order.search</field>
            <field name="model">utility.work.order</field>
            <field name="arch" type="xml">
                <search>
                    <field name="work_order_number"/>
                    <field name="customer_id"/>
                    <field name="assigned_technician_id"/>
                    <field name="work_type"/>
                    <field name="state"/>
                    <field name="priority"/>
                    <filter name="open_work" string="قيد المتابعة"
                            domain="[('state','not in',('verified','cancelled'))]"/>
                    <filter name="my_work" string="أوامري"
                            domain="[('assigned_technician_id','=',uid)]"/>
                    <filter name="scheduled_today" string="المجدولة اليوم" date="date_scheduled"/>
                    <separator/>
                    <group expand="0" string="تجميع حسب">
                        <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                        <filter name="group_technician" string="الفني" context="{'group_by': 'assigned_technician_id'}"/>
                        <filter name="group_work_type" string="نوع العمل" context="{'group_by': 'work_type'}"/>
                        <filter name="group_priority" string="الأولوية" context="{'group_by': 'priority'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>
