<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE VIEW -->
    <record id="view_utility_meter_replacement_tree" model="ir.ui.view">
        <field name="name">utility.meter.replacement.tree</field>
        <field name="model">utility.meter.replacement</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'">
                <field name="company_id" invisible="1"/>
                <field name="name"/>
                <field name="utility_account_id"/>
                <field name="partner_id"/>
                <field name="old_meter_id"/>
                <field name="new_meter_id"/>
                <field name="replacement_date"/>
                <field name="unbilled_consumption"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_utility_meter_replacement_form" model="ir.ui.view">
        <field name="name">utility.meter.replacement.form</field>
        <field name="model">utility.meter.replacement</field>
        <field name="arch" type="xml">
            <form>
                <field name="company_id" invisible="1"/>
                <field name="closing_reading_id" invisible="1"/>
                <field name="opening_reading_id" invisible="1"/>
                <header>
                    <button name="action_complete_replacement" type="object"
                            string="إكمال الاستبدال" class="oe_highlight"
                            confirm="سيؤدي هذا الإجراء إلى تنفيذ حركات المخزون وتحديث حالة العدادين. هل تريد المتابعة؟" invisible="(state == 'done')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done" options="{'clickable': False}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="action" name="%(stock.action_picking_tree_all)d"
                                icon="fa-truck"
                                context="{'search_default_origin': name}">
                            <field string="حركات المخزون" name="picking_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_closing_reading"
                                icon="fa-tachometer" invisible="(closing_reading_id == False)">
                            <div class="o_stat_info">
                                <span class="o_stat_text">القراءة الختامية</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_opening_reading"
                                icon="fa-power-off" invisible="(opening_reading_id == False)">
                            <div class="o_stat_info">
                                <span class="o_stat_text">القراءة الافتتاحية</span>
                            </div>
                        </button>
                    </div>

                    <div class="alert alert-info text-center" role="alert" invisible="(state != 'done')">
                        <i class="fa fa-info-circle me-2" title="تنبيه"/>
                        <strong>تم الاستبدال واكتمال حركات المخزون!</strong>
                        الاستهلاك غير المفوتر المرحل للعداد القديم: 
                        <strong><field name="unbilled_consumption" readonly="1"/> ك.و.س</strong>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="رقم العملية"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="معلومات الاشتراك">
                            <field name="utility_account_id" readonly="(state == 'done')"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="تفاصيل العدادات والتاريخ">
                            <field name="old_meter_id" readonly="(state == 'done')"/>
                            <field name="new_meter_id" readonly="(state == 'done')"/>
                            <field name="replacement_date" readonly="(state == 'done')"/>
                        </group>
                    </group>
                    <group string="قراءات الاستبدال والاستهلاك غير المفوتر">
                        <group>
                            <field name="old_meter_final_reading" readonly="(state == 'done')"/>
                            <field name="new_meter_initial_reading" readonly="(state == 'done')"/>
                        </group>
                        <group>
                            <field name="unbilled_consumption" readonly="1"/>
                        </group>
                    </group>
                    <group string="تفاصيل إضافية وملاحظات">
                        <field name="reason" readonly="(state == 'done')"/>
                        <field name="replacement_notes" readonly="(state == 'done')"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WIZARD FORM VIEW -->
    <record id="view_utility_meter_replace_wizard_form" model="ir.ui.view">
        <field name="name">utility.meter.replace.wizard.form</field>
        <field name="model">utility.meter.replace.wizard</field>
        <field name="arch" type="xml">
            <form string="معالج استبدال العداد">
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="old_meter_id"/>
                        </group>
                        <group>
                            <field name="new_meter_id"/>
                            <field name="old_meter_final_reading"/>
                            <field name="new_meter_initial_reading"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_execute_replacement" string="تنفيذ الاستبدال فوراً" type="object" class="oe_highlight"
                            confirm="سيؤدي هذا الإجراء إلى تنفيذ حركات المخزون وتحديث حالة العدادين. هل تريد المتابعة؟"/>
                    <button string="إغلاق" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_utility_meter_replacement" model="ir.actions.act_window">
        <field name="name">استبدال العدادات</field>
        <field name="res_model">utility.meter.replacement</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_utility_meter_replace_wizard" model="ir.actions.act_window">
        <field name="name">معالج استبدال العداد</field>
        <field name="res_model">utility.meter.replace.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
